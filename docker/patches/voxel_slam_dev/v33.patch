+  void update_vertical_velocity_bias()
+  {
+    if(!vertical_velocity_bias_enabled || x_curr.g.norm() < 1e-6)
+      return;
+
+    const Eigen::Vector3d gravity_axis = x_curr.g.normalized();
+    VerticalVelocitySample current;
+    current.t = x_curr.t;
+    current.position = gravity_axis.dot(x_curr.p);
+    current.velocity = gravity_axis.dot(x_curr.v);
+
+    if(!vertical_velocity_history.empty() &&
+       current.t <= vertical_velocity_history.back().t)
+      vertical_velocity_history.clear();
+    vertical_velocity_history.push_back(current);
+    while(!vertical_velocity_history.empty() &&
+          vertical_velocity_history.front().t <
+              current.t - 2.0 * vertical_velocity_bias_window)
+      vertical_velocity_history.pop_front();
+
+    if(vertical_velocity_history.size() < 10)
+      return;
+
+    const double window_start =
+        current.t - vertical_velocity_bias_window;
+    vector<double> innovations;
+    innovations.reserve(vertical_velocity_history.size());
+    bool have_previous = false;
+    VerticalVelocitySample previous;
+    for(const VerticalVelocitySample &sample: vertical_velocity_history)
+    {
+      if(sample.t < window_start)
+      {
+        previous = sample;
+        have_previous = true;
+        continue;
+      }
+      if(have_previous)
+      {
+        const double dt = sample.t - previous.t;
+        if(dt > 0.01 && dt < 0.5)
+        {
+          const double position_velocity =
+              (sample.position - previous.position) / dt;
+          const double midpoint_velocity =
+              0.5 * (sample.velocity + previous.velocity);
+          innovations.push_back(position_velocity - midpoint_velocity);
+        }
+      }
+      previous = sample;
+      have_previous = true;
+    }
+
+    if(innovations.size() < 8)
+      return;
+    sort(innovations.begin(), innovations.end());
+    const size_t middle = innovations.size() / 2;
+    const double median = (innovations.size() % 2 == 0) ?
+        0.5 * (innovations[middle - 1] + innovations[middle]) :
+        innovations[middle];
+    vector<double> deviations;
+    deviations.reserve(innovations.size());
+    for(double innovation: innovations)
+      deviations.push_back(fabs(innovation - median));
+    sort(deviations.begin(), deviations.end());
+    const size_t dev_middle = deviations.size() / 2;
+    const double mad = (deviations.size() % 2 == 0) ?
+        0.5 * (deviations[dev_middle - 1] + deviations[dev_middle]) :
+        deviations[dev_middle];
+
+    VerticalVelocitySample anchor = vertical_velocity_history.front();
+    for(const VerticalVelocitySample &sample: vertical_velocity_history)
+    {
+      if(sample.t <= window_start)
+        anchor = sample;
+      else
+        break;
+    }
+    const double window_dt = current.t - anchor.t;
+    const double velocity_change = current.velocity - anchor.velocity;
+    if(window_dt < 0.75 * vertical_velocity_bias_window ||
+       fabs(velocity_change) > vertical_velocity_bias_max_velocity_change ||
+       fabs(median) < vertical_velocity_bias_min_residual)
+      return;
+
+    // The median position/velocity innovation is a causal consistency
+    // residual. Its MAD and the observed velocity change act as an
+    // uncertainty weight: unstable vertical motion receives little or no
+    // correction, while a persistent small bias is corrected gradually.
+    const double residual_scale =
+        vertical_velocity_bias_min_residual + 1e-6;
+    const double mad_weight = 1.0 / (1.0 + mad / residual_scale);
+    const double change_weight =
+        1.0 - min(1.0, fabs(velocity_change) /
+                          vertical_velocity_bias_max_velocity_change);
+    double correction = vertical_velocity_bias_gain * mad_weight *
+                        change_weight * median;
+    correction = max(-vertical_velocity_bias_max_correction,
+                     min(vertical_velocity_bias_max_correction, correction));
+    x_curr.v += gravity_axis * correction;
+    vertical_velocity_history.back().velocity += correction;
+  }
