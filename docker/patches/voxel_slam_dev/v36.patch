+  void write_vertical_observability_diagnostic(
+      const Eigen::Vector3d &evalue, const Eigen::Matrix3d &eigenvectors,
+      int match_num, const IMUST &state, bool bridge_active_before)
+  {
+    if(!vertical_observability_diagnostic_enabled ||
+       !vertical_observability_diagnostic_file.is_open() ||
+       state.g.norm() < 1e-6)
+      return;
+
+    const Eigen::Vector3d gravity_axis = state.g.normalized();
+    VerticalDiagnosticSample current;
+    current.t = state.t;
+    current.position = gravity_axis.dot(state.p);
+    current.velocity = gravity_axis.dot(state.v);
+    if(!vertical_diagnostic_history.empty() &&
+       current.t <= vertical_diagnostic_history.back().t)
+      vertical_diagnostic_history.clear();
+    vertical_diagnostic_history.push_back(current);
+    while(!vertical_diagnostic_history.empty() &&
+          vertical_diagnostic_history.front().t <
+              current.t - 2.0 * vertical_observability_diagnostic_window)
+      vertical_diagnostic_history.pop_front();
+
+    vector<double> innovations;
+    double window_dt = 0.0;
+    double velocity_change = 0.0;
+    double median = 0.0;
+    double mad = 0.0;
+    double bias_error = 0.0;
+    double correction = 0.0;
+    bool residual_valid = false;
+    const double window_start =
+        current.t - vertical_observability_diagnostic_window;
+    if(vertical_diagnostic_history.size() >= 10)
+    {
+      innovations.reserve(vertical_diagnostic_history.size());
+      bool have_previous = false;
+      VerticalDiagnosticSample previous;
+      for(const VerticalDiagnosticSample &sample: vertical_diagnostic_history)
+      {
+        if(sample.t < window_start)
+        {
+          previous = sample;
+          have_previous = true;
+          continue;
+        }
+        if(have_previous)
+        {
+          const double dt = sample.t - previous.t;
+          if(dt > 0.01 && dt < 0.5)
+          {
+            const double position_velocity =
+                (sample.position - previous.position) / dt;
+            const double midpoint_velocity =
+                0.5 * (sample.velocity + previous.velocity);
+            innovations.push_back(position_velocity - midpoint_velocity);
+          }
+        }
+        previous = sample;
+        have_previous = true;
+      }
+
+      if(innovations.size() >= 8)
+      {
+        sort(innovations.begin(), innovations.end());
+        const size_t middle = innovations.size() / 2;
+        median = (innovations.size() % 2 == 0) ?
+            0.5 * (innovations[middle - 1] + innovations[middle]) :
+            innovations[middle];
+        vector<double> deviations;
+        deviations.reserve(innovations.size());
+        for(double innovation: innovations)
+          deviations.push_back(fabs(innovation - median));
+        sort(deviations.begin(), deviations.end());
+        const size_t dev_middle = deviations.size() / 2;
+        mad = (deviations.size() % 2 == 0) ?
+            0.5 * (deviations[dev_middle - 1] + deviations[dev_middle]) :
+            deviations[dev_middle];
+
+        VerticalDiagnosticSample anchor = vertical_diagnostic_history.front();
+        for(const VerticalDiagnosticSample &sample: vertical_diagnostic_history)
+        {
+          if(sample.t <= window_start)
+            anchor = sample;
+          else
+            break;
+        }
+        window_dt = current.t - anchor.t;
+        velocity_change = current.velocity - anchor.velocity;
+        if(window_dt >= 0.75 * vertical_observability_diagnostic_window &&
+           fabs(velocity_change) <=
+               vertical_observability_diagnostic_max_velocity_change &&
+           fabs(median) >= vertical_observability_diagnostic_min_innovation)
+        {
+          const double innovation_scale =
+              vertical_observability_diagnostic_min_innovation + 1e-6;
+          const double mad_weight = 1.0 / (1.0 + mad / innovation_scale);
+          const double change_weight =
+              1.0 - min(1.0, fabs(velocity_change) /
+                                 vertical_observability_diagnostic_max_velocity_change);
+          bias_error = 2.0 * median / window_dt;
+          correction = vertical_observability_diagnostic_gain * mad_weight *
+                       change_weight * bias_error;
+          correction = max(-vertical_observability_diagnostic_max_correction,
+                           min(vertical_observability_diagnostic_max_correction,
+                               correction));
+          residual_valid = true;
+        }
+      }
+    }
+
+    const Eigen::Vector3d weakest = eigenvectors.col(0).normalized();
+    const double weak_gravity_alignment =
+        fabs(gravity_axis.dot(weakest));
+    const double weak_horizontal_norm = sqrt(max(
+        0.0, 1.0 - weak_gravity_alignment * weak_gravity_alignment));
+    Eigen::Vector3d weak_horizontal =
+        weakest - gravity_axis * gravity_axis.dot(weakest);
+    double weak_velocity_projection_abs = 0.0;
+    if(weak_horizontal.norm() > 1e-6)
+      weak_velocity_projection_abs =
+          fabs(weak_horizontal.normalized().dot(state.v));
+    const bool weak_trigger_candidate =
+        !bridge_active_before && evalue[0] < 14 && evalue[1] >= 14 &&
+        weak_axis_degenerate_streak + 1 >= 10 &&
+        weak_horizontal_norm >= 0.5;
+
+    vertical_observability_diagnostic_scan_count++;
+    vertical_observability_diagnostic_file
+        << vertical_observability_diagnostic_scan_count << ',' << state.t << ','
+        << match_num << ',' << evalue[0] << ',' << evalue[1] << ',' << evalue[2]
+        << ',' << weakest[0] << ',' << weakest[1] << ',' << weakest[2]
+        << ',' << weak_gravity_alignment << ',' << weak_horizontal_norm << ','
+        << weak_velocity_projection_abs << ',' << weak_axis_degenerate_streak
+        << ',' << (bridge_active_before ? 1 : 0) << ','
+        << weak_axis_recovery_streak << ',' << state.p[0] << ',' << state.p[1]
+        << ',' << state.p[2] << ',' << state.v[0] << ',' << state.v[1] << ','
+        << state.v[2] << ',' << current.position << ',' << current.velocity << ','
+        << innovations.size() << ',' << window_dt << ',' << velocity_change << ','
+        << median << ',' << mad << ',' << bias_error << ',' << correction << ','
+        << (residual_valid ? 1 : 0) << ','
+        << (weak_trigger_candidate ? 1 : 0) << '\n';
+    if(vertical_observability_diagnostic_scan_count <= 3 ||
+       vertical_observability_diagnostic_scan_count % 100 == 0)
+      vertical_observability_diagnostic_file.flush();
+  }
