       Eigen::Vector3d rot_add = solution.block<3, 1>(0, 0);
       Eigen::Vector3d tra_add = solution.block<3, 1>(3, 0);
 
+      // Vertical-velocity anti-drift soft constraint (v23).
+      // Open sections (wide plazas, sparse close geometry) let the scan
+      // matcher over-correct the gravity-axis velocity, integrating a small
+      // mm/s vertical bias into height. When the velocity correction's
+      // gravity-axis component is large, blend it back toward the propagated
+      // (pre-update) IMU vertical velocity so height stays attached to the
+      // inertial solution. Unlike v22, this does not rely on the z
+      // information weight, which stays large even in the drifting windows.
+      if(!weak_axis_bridge_active && z_constraint_enabled)
+      {
+        const Eigen::Vector3d grav = x_curr.g.normalized();
+        const double dvz = grav.dot(solution.block<3, 1>(6, 0));
+        const double dvz_max = 0.03;
+        if(dvz > dvz_max)
+        {
+          const double over = dvz - dvz_max;
+          x_curr.v -= grav * over;
+        }
+        else if(dvz < -dvz_max)
+        {
+          const double over = -dvz - dvz_max;
+          x_curr.v -= grav * (-over);
+        }
+      }
