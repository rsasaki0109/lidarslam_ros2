+  void read_gba_memory_kb(long &rss_kb, long &hwm_kb)
+  {
+    rss_kb = -1; hwm_kb = -1;
+    ifstream status("/proc/self/status");
+    string line;
+    while(getline(status, line))
+    {
+      string label;
+      long value = -1;
+      string unit;
+      stringstream fields(line);
+      fields >> label >> value >> unit;
+      if(label == "VmRSS:") rss_kb = value;
+      else if(label == "VmHWM:") hwm_kb = value;
+    }
+  }
+
+  void trace_gba_stage(const char *stage, size_t primary = 0,
+                       size_t secondary = 0)
+  {
+    if(!gba_runtime_diagnostic_enabled)
+      return;
+    long rss_kb = -1, hwm_kb = -1;
+    read_gba_memory_kb(rss_kb, hwm_kb);
+    const double now = ros::WallTime::now().toSec();
+    const double elapsed = gba_backend_started_wall_sec > 0.0 ?
+        now - gba_backend_started_wall_sec : 0.0;
+    printf("V41_GBA stage=%s elapsed_sec=%.6f rss_kb=%ld hwm_kb=%ld "
+           "primary=%zu secondary=%zu cancel=%d\n", stage, elapsed,
+           rss_kb, hwm_kb, primary, secondary,
+           gba_cancel_requested.load() ? 1 : 0);
+    fflush(stdout);
+  }
+
+  void request_gba_cancel(const char *reason, size_t primary = 0,
+                          size_t secondary = 0)
+  {
+    bool expected = false;
+    if(gba_cancel_requested.compare_exchange_strong(expected, true))
+    {
+      if(gba_runtime_diagnostic_enabled)
+        trace_gba_stage(reason, primary, secondary);
+      else
+      {
+        printf("V41_GBA stage=%s cancel=1\n", reason);
+        fflush(stdout);
+      }
+    }
+  }
+
+  bool gba_should_cancel(const char *stage, size_t primary = 0,
+                         size_t secondary = 0)
+  {
+    if(gba_cancel_requested.load())
+      return true;
+    if(!ros::ok())
+    {
+      request_gba_cancel("cancel_ros_shutdown", primary, secondary);
+      return true;
+    }
+    if(!gba_runtime_guard_enabled)
+      return false;
+
+    long rss_kb = -1, hwm_kb = -1;
+    read_gba_memory_kb(rss_kb, hwm_kb);
+    const double max_rss_kb = gba_max_rss_mib * 1024.0;
+    if(hwm_kb >= 0 && hwm_kb > max_rss_kb)
+    {
+      request_gba_cancel("cancel_rss_limit", primary, secondary);
+      return true;
+    }
+    if(gba_backend_started_wall_sec > 0.0 &&
+       ros::WallTime::now().toSec() - gba_backend_started_wall_sec >
+           gba_backend_deadline_seconds)
+    {
+      request_gba_cancel("cancel_backend_deadline", primary, secondary);
+      return true;
+    }
+    (void)stage;
+    return false;
+  }
