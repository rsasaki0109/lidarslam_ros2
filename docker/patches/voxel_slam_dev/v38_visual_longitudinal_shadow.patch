+  // Contract boundary only: the future camera/LiDAR estimator may submit a
+  // scalar in m/s with a source timestamp in seconds.  This shadow receiver
+  // is deliberately isolated; acceptance never changes the inertial state or
+  // the existing full visual pose path.
+  bool ingest_visual_longitudinal_shadow(
+      const double stamp_sec, const double velocity_mps,
+      const double confidence, const double now_sec)
+  {
+    visual_longitudinal_shadow_valid = false;
+    if(!visual_longitudinal_shadow_enabled ||
+       !std::isfinite(stamp_sec) || !std::isfinite(velocity_mps) ||
+       !std::isfinite(confidence) || confidence < 0.0 || confidence > 1.0 ||
+       std::abs(velocity_mps) > visual_longitudinal_shadow_max_speed_mps ||
+       !std::isfinite(now_sec) || now_sec < stamp_sec ||
+       now_sec - stamp_sec > visual_longitudinal_shadow_max_age_sec)
+      return false;
+    visual_longitudinal_shadow_observation.stamp_sec = stamp_sec;
+    visual_longitudinal_shadow_observation.velocity_mps = velocity_mps;
+    visual_longitudinal_shadow_observation.confidence = confidence;
+    visual_longitudinal_shadow_valid = true;
+    ++visual_longitudinal_shadow_update_count;
+    return true;
+  }
+
+  void visual_longitudinal_shadow_handler(
+      const geometry_msgs::Vector3Stamped::ConstPtr &message)
+  {
+    if(!message)
+      return;
+    ingest_visual_longitudinal_shadow(
+        message->header.stamp.toSec(), message->vector.x,
+        message->vector.y, ros::Time::now().toSec());
+  }
+
+  void apply_visual_longitudinal_shadow()
+  {
+    if(!visual_longitudinal_shadow_enabled ||
+       !visual_longitudinal_shadow_valid)
+      return;
+    const double now_sec = ros::Time::now().toSec();
+    if(!std::isfinite(now_sec) || !std::isfinite(
+           visual_longitudinal_shadow_observation.stamp_sec) ||
+       now_sec < visual_longitudinal_shadow_observation.stamp_sec ||
+       now_sec - visual_longitudinal_shadow_observation.stamp_sec >
+           visual_longitudinal_shadow_max_age_sec)
+    {
+      visual_longitudinal_shadow_valid = false;
+      return;
+    }
+    if(!weak_axis_bridge_active)
+      return;
+    const double innovation =
+        visual_longitudinal_shadow_observation.velocity_mps - weak_axis_speed;
+    double correction = visual_longitudinal_shadow_gain *
+        visual_longitudinal_shadow_observation.confidence * innovation;
+    correction = std::max(
+        -visual_longitudinal_shadow_max_velocity_change_mps,
+        std::min(visual_longitudinal_shadow_max_velocity_change_mps,
+                 correction));
+    weak_axis_speed += correction;
+    ++visual_longitudinal_shadow_applied_count;
+    if(visual_longitudinal_shadow_applied_count == 1 ||
+       visual_longitudinal_shadow_applied_count % 100 == 0)
+      printf("v38 visual shadow applied: count=%llu correction=%g target=%g\n",
+             visual_longitudinal_shadow_applied_count, correction,
+             visual_longitudinal_shadow_observation.velocity_mps);
+  }
