+      // Vertical-velocity consistency update (v32). The scan matcher
+      // corrects position but leaves velocity on the IMU prior. In open
+      // sections where the vertical constraint is weak, the integrated
+      // vertical velocity drifts relative to the observed z displacement.
+      // Recompute the gravity-axis velocity from the observed z change over
+      // this scan interval so velocity and position stay consistent.
+      if(!weak_axis_bridge_active && z_constraint_enabled)
+      {
+        const double dt = x_curr.t - x_prop.t;
+        if(dt > 0.02 && dt < 1.0)
+        {
+          const Eigen::Vector3d grav = x_curr.g.normalized();
+          const double z_obs = grav.dot(x_curr.p - x_prop.p) / dt;
+          const double z_vel = grav.dot(x_curr.v);
+          // Blend 50% toward the observed vertical velocity; a full replace
+          // would over-react to per-scan noise.
+          x_curr.v += grav * (0.5 * (z_obs - z_vel));
+        }
+      }
