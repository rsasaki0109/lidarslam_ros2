+  // Build the no-loop GBA graph in the source-scan id namespace. HBA edges
+  // use Keyframe::id, which is already the corresponding scan index; all
+  // scans must therefore be initialized and connected before top-down HBA.
+  bool build_no_loop_gba_graph(
+      gtsam::Values &initial, gtsam::NonlinearFactorGraph &graph,
+      vector<int> &ids, vector<int> &stepsizes, int map_id)
+  {
+    initial.clear(); graph = gtsam::NonlinearFactorGraph();
+    ids.clear(); stepsizes.clear();
+    if(map_id < 0 || map_id >= multimap_scanPoses.size() ||
+       multimap_scanPoses[map_id] == nullptr ||
+       multimap_scanPoses[map_id]->empty())
+    {
+      printf("v40 GBA graph rejected: empty or invalid scan map %d\n", map_id);
+      return false;
+    }
+
+    vector<ScanPose*> &scans = *multimap_scanPoses[map_id];
+    ids.push_back(map_id);
+    stepsizes.push_back(0);
+    stepsizes.push_back(scans.size());
+    for(int i=0; i<scans.size(); i++)
+    {
+      IMUST &xc = scans[i]->x;
+      gtsam::Pose3 pose3(gtsam::Rot3(xc.R), gtsam::Point3(xc.p));
+      initial.insert(i, pose3);
+      if(i > 0)
+      {
+        gtsam::Vector samv6(6);
+        samv6 = scans[i-1]->v6;
+        for(int axis=0; axis<6; axis++)
+        {
+          if(!std::isfinite(samv6[axis]) || samv6[axis] <= 0.0)
+          {
+            printf("v40 GBA graph rejected: invalid odometry variance "
+                   "scan=%d axis=%d value=%g\n", i-1, axis, samv6[axis]);
+            initial.clear(); graph = gtsam::NonlinearFactorGraph();
+            ids.clear(); stepsizes.clear();
+            return false;
+          }
+        }
+        gtsam::noiseModel::Diagonal::shared_ptr v6_noise =
+            gtsam::noiseModel::Diagonal::Variances(samv6);
+        add_edge(i-1, i, scans[i-1]->x, scans[i]->x, graph, v6_noise);
+      }
+    }
+
+    Eigen::Matrix<double, 6, 1> v6_fixd;
+    v6_fixd << 1e-9, 1e-9, 1e-9, 1e-9, 1e-9, 1e-9;
+    gtsam::noiseModel::Diagonal::shared_ptr fixd_noise =
+        gtsam::noiseModel::Diagonal::Variances(gtsam::Vector(v6_fixd));
+    IMUST &x0 = scans.front()->x;
+    gtsam::Pose3 pose0(gtsam::Rot3(x0.R), gtsam::Point3(x0.p));
+    graph.addPrior(0, pose0, fixd_noise);
+    printf("v40 full-scan GBA graph: scans=%zu odometry_edges=%zu prior=1\n",
+           scans.size(), scans.size()-1);
+    return true;
+  }
+
+  bool validate_no_loop_gba_keyframes(int map_id)
+  {
+    if(map_id < 0 || map_id >= multimap_scanPoses.size() ||
+       map_id >= multimap_keyframes.size())
+      return false;
+    const int scan_count = multimap_scanPoses[map_id]->size();
+    int previous_id = -1;
+    for(Keyframe *smp: *multimap_keyframes[map_id])
+    {
+      if(smp == nullptr || smp->id <= previous_id ||
+         smp->id < 0 || smp->id >= scan_count)
+      {
+        printf("v40 GBA keyframe contract rejected: previous=%d current=%d "
+               "scan_count=%d\n", previous_id,
+               smp == nullptr ? -1 : smp->id, scan_count);
+        return false;
+      }
+      previous_id = smp->id;
+    }
+    return true;
+  }
