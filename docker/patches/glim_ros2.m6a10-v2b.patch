+private:
+  static std::string value(const char* name) {
+    const char* raw = std::getenv(name);
+    return raw == nullptr ? std::string() : std::string(raw);
+  }
+
+  void parse_uint(const std::string& raw, std::uint64_t& target, const char* name) {
+    if (raw.empty()) {
+      failure(std::string(name) + "_missing");
+      return;
+    }
+    try {
+      std::size_t consumed = 0;
+      target = std::stoull(raw, &consumed, 10);
+      if (consumed != raw.size()) {
+        failure(std::string(name) + "_invalid");
+      }
+    } catch (...) {
+      failure(std::string(name) + "_invalid");
+    }
+  }
+
+  void parse_double(const std::string& raw, double& target, const char* name) {
+    if (raw.empty()) {
+      failure(std::string(name) + "_missing");
+      return;
+    }
+    try {
+      std::size_t consumed = 0;
+      target = std::stod(raw, &consumed);
+      if (consumed != raw.size() || !std::isfinite(target)) {
+        failure(std::string(name) + "_invalid");
+      }
+    } catch (...) {
+      failure(std::string(name) + "_invalid");
+    }
+  }
+
+  static std::string quote(const std::string& value) {
+    std::string result = "\"";
+    for (const char c : value) {
+      if (c == '\\' || c == '\"') {
+        result.push_back('\\');
+      }
+      result.push_back(c);
+    }
+    result.push_back('\"');
+    return result;
+  }
