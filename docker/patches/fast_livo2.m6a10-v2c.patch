diff --git a/include/m6a10_consumer_evidence.h b/include/m6a10_consumer_evidence.h
new file mode 100644
index 00000000..7a6b51a3
--- /dev/null
+++ b/include/m6a10_consumer_evidence.h
@@ -0,0 +1,355 @@
+/*
+ * Benchmark-only consumer evidence for FAST-LIVO2.
+ *
+ * The normal FAST-LIVO2 execution path is unchanged when
+ * M6A10_PHASE_CONTRACT_VERSION is absent.  In the opt-in phase path this
+ * helper records subscriber callback acceptance and exposes explicit EOF and
+ * drain barriers.  It never treats publisher counts or log text as evidence.
+ */
+#ifndef M6A10_CONSUMER_EVIDENCE_H
+#define M6A10_CONSUMER_EVIDENCE_H
+
+#include <ros/ros.h>
+#include <std_srvs/Trigger.h>
+
+#include <cerrno>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iomanip>
+#include <limits>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <utility>
+#include <cstdint>
+
+class M6A10ConsumerEvidence
+{
+public:
+  enum class Topic
+  {
+    Lidar,
+    Imu,
+    Image
+  };
+
+  class CallbackScope
+  {
+  public:
+    CallbackScope(M6A10ConsumerEvidence *owner, Topic topic, double started)
+      : owner_(owner), topic_(topic), started_(started)
+    {
+    }
+
+    CallbackScope(const CallbackScope &) = delete;
+    CallbackScope &operator=(const CallbackScope &) = delete;
+
+    CallbackScope(CallbackScope &&other) noexcept
+      : owner_(other.owner_), topic_(other.topic_), started_(other.started_),
+        accepted_(other.accepted_), timestamp_(other.timestamp_)
+    {
+      other.owner_ = nullptr;
+    }
+
+    ~CallbackScope()
+    {
+      if (owner_ != nullptr) owner_->finish(topic_, started_, accepted_, timestamp_);
+    }
+
+    void accept(double timestamp)
+    {
+      accepted_ = true;
+      timestamp_ = timestamp;
+    }
+
+  private:
+    M6A10ConsumerEvidence *owner_;
+    Topic topic_;
+    double started_;
+    bool accepted_ = false;
+    double timestamp_ = 0.0;
+  };
+
+  M6A10ConsumerEvidence()
+  {
+    const char *contract = std::getenv("M6A10_PHASE_CONTRACT_VERSION");
+    enabled_ = contract != nullptr &&
+               std::string(contract) == "m6a10-online-compute-v2";
+    if (!enabled_) return;
+    phase_mode_ = env_string("M6A10_PHASE_MODE");
+    evidence_path_ = env_string("M6A10_CONSUMER_EVIDENCE");
+    eof_path_ = evidence_path_.empty() ? std::string() : evidence_path_ + ".eof.json";
+    expected_total_ = env_integer("M6A10_FAST_EXPECTED_MESSAGES");
+    expected_lidar_ = env_integer("M6A10_FAST_EXPECTED_LIDAR_MESSAGES");
+    expected_imu_ = env_integer("M6A10_FAST_EXPECTED_IMU_MESSAGES");
+    expected_image_ = env_integer("M6A10_FAST_EXPECTED_IMAGE_MESSAGES");
+    required_end_timestamp_ = env_double("M6A10_FAST_REQUIRED_END_TIMESTAMP_SECONDS");
+    maximum_callback_latency_seconds_ = env_double(
+      "M6A10_FAST_MAX_CALLBACK_LATENCY_SECONDS", 0.25);
+    maximum_backlog_messages_ = env_integer(
+      "M6A10_FAST_MAX_BACKLOG_MESSAGES", 100000);
+    // These are observations, never receipt-controlled claims.  The runner
+    // can only make them true by publishing one message, waiting for the
+    // callback counter, and then calling the ACK service for every message.
+    queue_overflow_observable_ = false;
+    ack_backpressure_verified_ = false;
+    paced_rate_verified_ = env_string("M6A10_FAST_PACED_RATE_VERIFIED") == "1";
+  }
+
+  bool enabled() const { return enabled_; }
+
+  CallbackScope begin(Topic topic)
+  {
+    return CallbackScope(this, topic, ros::WallTime::now().toSec());
+  }
+
+  void observe_queue(std::size_t lidar, std::size_t imu, std::size_t image)
+  {
+    if (!enabled_) return;
+    std::lock_guard<std::mutex> guard(mutex_);
+    const long long total = static_cast<long long>(lidar + imu + image);
+    if (total > maximum_observed_backlog_) maximum_observed_backlog_ = total;
+  }
+
+  bool eof_service(std_srvs::Trigger::Request &, std_srvs::Trigger::Response &response,
+                  std::size_t lidar, std::size_t imu, std::size_t image)
+  {
+    if (!enabled_)
+    {
+      response.success = false;
+      response.message = "M6a10 phase is disabled";
+      return true;
+    }
+    std::lock_guard<std::mutex> guard(mutex_);
+    observe_queue_locked(lidar, imu, image);
+    eof_observed_ = true;
+    response.success = write_eof_locked(lidar, imu, image);
+    response.message = response.success ? "EOF evidence written" : "EOF evidence write failed";
+    return true;
+  }
+
+  bool status_service(std_srvs::Trigger::Request &, std_srvs::Trigger::Response &response,
+                      std::size_t lidar, std::size_t imu, std::size_t image)
+  {
+    if (!enabled_)
+    {
+      response.success = false;
+      response.message = "M6a10 phase is disabled";
+      return true;
+    }
+    std::lock_guard<std::mutex> guard(mutex_);
+    observe_queue_locked(lidar, imu, image);
+    response.success = true;
+    response.message = common_json_locked(false, lidar, imu, image, eof_observed_, false);
+    return true;
+  }
+
+  bool ack_service(std_srvs::Trigger::Request &, std_srvs::Trigger::Response &response)
+  {
+    if (!enabled_)
+    {
+      response.success = false;
+      response.message = "M6a10 phase is disabled";
+      return true;
+    }
+    std::lock_guard<std::mutex> guard(mutex_);
+    if (feeder_acknowledged_ >= received_total_)
+    {
+      response.success = false;
+      response.message = "ACK arrived without a newly accepted callback";
+      return true;
+    }
+    ++feeder_acknowledged_;
+    response.success = true;
+    response.message = "consumer callback ACK recorded";
+    return true;
+  }
+
+  bool finalize_service(std_srvs::Trigger::Request &, std_srvs::Trigger::Response &response,
+                        std::size_t lidar, std::size_t imu, std::size_t image)
+  {
+    if (!enabled_)
+    {
+      response.success = false;
+      response.message = "M6a10 phase is disabled";
+      return true;
+    }
+    std::lock_guard<std::mutex> guard(mutex_);
+    observe_queue_locked(lidar, imu, image);
+    const bool counts_ok = expected_total_ >= 0 && expected_lidar_ >= 0 &&
+      expected_imu_ >= 0 && expected_image_ >= 0 &&
+      received_total_ == expected_total_ && received_lidar_ == expected_lidar_ &&
+      received_imu_ == expected_imu_ && received_image_ == expected_image_;
+    const bool ack_ok = feeder_acknowledged_ == expected_total_ &&
+      feeder_acknowledged_ == received_total_;
+    // A one-message publisher queue plus an ACK for every callback makes a
+    // subscriber drop observable through an exact-count/ACK mismatch.  The
+    // capability is therefore recorded only after this run-level observation.
+    queue_overflow_observable_ = ack_ok;
+    ack_backpressure_verified_ = ack_ok;
+    const bool phase_ok = phase_mode_ == "paced_1x" ? paced_rate_verified_ : ack_ok;
+    const bool pass = eof_observed_ && counts_ok && lidar + imu + image == 0 &&
+      dropped_messages_ == 0 && queue_overflow_ == 0 && processing_failures_ == 0 &&
+      queue_overflow_observable_ && phase_ok &&
+      maximum_observed_backlog_ <= maximum_backlog_messages_ &&
+      maximum_callback_latency_seconds_observed_ <= maximum_callback_latency_seconds_;
+    response.success = write_final_locked(pass, lidar, imu, image);
+    if (!response.success)
+    {
+      response.message = "final evidence write failed";
+    }
+    else if (!pass)
+    {
+      response.message = "consumer evidence is invalid; no completion claim";
+    }
+    else
+    {
+      response.message = "consumer evidence PASS";
+    }
+    return true;
+  }
+
+private:
+  static std::string env_string(const char *name)
+  {
+    const char *value = std::getenv(name);
+    return value == nullptr ? std::string() : std::string(value);
+  }
+
+  static long long env_integer(const char *name, long long fallback = -1)
+  {
+    const std::string value = env_string(name);
+    if (value.empty()) return fallback;
+    char *end = nullptr;
+    const long long parsed = std::strtoll(value.c_str(), &end, 10);
+    return end != value.c_str() && *end == '\0' ? parsed : fallback;
+  }
+
+  static double env_double(const char *name, double fallback = -1.0)
+  {
+    const std::string value = env_string(name);
+    if (value.empty()) return fallback;
+    char *end = nullptr;
+    const double parsed = std::strtod(value.c_str(), &end);
+    return end != value.c_str() && *end == '\0' ? parsed : fallback;
+  }
+
+  static std::string json_string(const std::string &value)
+  {
+    std::ostringstream output;
+    output << '"';
+    for (const char character : value)
+    {
+      if (character == '\\' || character == '"') output << '\\';
+      if (character == '\n') output << "\\n";
+      else if (character == '\r') output << "\\r";
+      else if (character == '\t') output << "\\t";
+      else output << character;
+    }
+    output << '"';
+    return output.str();
+  }
+
+  static std::string number_or_null(long long value)
+  {
+    return value < 0 ? "null" : std::to_string(value);
+  }
+
+  static std::string double_or_null(double value)
+  {
+    if (!std::isfinite(value)) return "null";
+    std::ostringstream output;
+    output << std::setprecision(17) << value;
+    return output.str();
+  }
+
+  void observe_queue_locked(std::size_t lidar, std::size_t imu, std::size_t image)
+  {
+    const long long total = static_cast<long long>(lidar + imu + image);
+    if (total > maximum_observed_backlog_) maximum_observed_backlog_ = total;
+  }
+
+  void finish(Topic topic, double started, bool accepted, double timestamp)
+  {
+    if (!enabled_) return;
+    std::lock_guard<std::mutex> guard(mutex_);
+    const double latency = std::max(0.0, ros::WallTime::now().toSec() - started);
+    if (latency > maximum_callback_latency_seconds_observed_)
+      maximum_callback_latency_seconds_observed_ = latency;
+    if (!accepted)
+    {
+      ++dropped_messages_;
+      return;
+    }
+    ++received_total_;
+    if (topic == Topic::Lidar) ++received_lidar_;
+    if (topic == Topic::Imu) ++received_imu_;
+    if (topic == Topic::Image) ++received_image_;
+    if (first_timestamp_ < 0.0) first_timestamp_ = timestamp;
+    last_timestamp_ = timestamp;
+  }
+
+  bool write_atomic_locked(const std::string &path, const std::string &contents)
+  {
+    if (path.empty() || std::ifstream(path).good()) return false;
+    const std::string part = path + ".part";
+    if (std::ifstream(part).good()) return false;
+    std::ofstream output(part, std::ios::out | std::ios::trunc);
+    if (!output) return false;
+    output << contents;
+    output.flush();
+    if (!output.good()) return false;
+    output.close();
+    if (std::rename(part.c_str(), path.c_str()) != 0) return false;
+    return true;
+  }
+
+  std::string common_json_locked(bool pass, std::size_t lidar, std::size_t imu,
+                                 std::size_t image, bool eof, bool drain) const
+  {
+    const long long backlog = static_cast<long long>(lidar + imu + image);
+    std::ostringstream out;
+    out << "{\n"
+        << "  \"schema_version\": 2,\n"
+        << "  \"contract_version\": \"m6a10-online-compute-v2\",\n"
+        << "  \"phase_mode\": " << json_string(phase_mode_) << ",\n"
+        << "  \"system\": \"fast_livo2\",\n"
+        << "  \"status\": " << json_string(pass ? "pass" : "invalid") << ",\n"
+        << "  \"consumer\": {\n"
+        << "    \"ack_source_kind\": \"consumer_callback\",\n"
+        << "    \"ack_source\": \"LIVMapper subscriber callback return\",\n"
+        << "    \"ack_semantics\": \"callback_acceptance_not_backend_completion\",\n"
+        << "    \"publisher_count_used\": false,\n"
+        << "    \"eof_observed\": " << (eof ? "true" : "false") << ",\n"
+        << "    \"eof_source\": \"/m6a10/consumer_eof service\",\n"
+        << "    \"expected_messages\": " << number_or_null(expected_total_) << ",\n"
+        << "    \"expected_topic_counts\": {\"lidar\": " << number_or_null(expected_lidar_)
+        << ", \"imu\": " << number_or_null(expected_imu_) << ", \"image\": "
+        << number_or_null(expected_image_) << "},\n"
+        << "    \"received_messages\": " << received_total_ << ",\n"
+        << "    \"processed_messages\": " << received_total_ << ",\n"
+        << "    \"acked_messages\": " << feeder_acknowledged_ << ",\n"
+        << "    \"received_topic_counts\": {\"lidar\": " << received_lidar_
+        << ", \"imu\": " << received_imu_ << ", \"image\": " << received_image_ << "},\n"
+        << "    \"dropped_messages\": " << dropped_messages_ << ",\n"
+        << "    \"queue_overflow\": " << queue_overflow_ << ",\n"
+        << "    \"queue_overflow_observable\": " << (queue_overflow_observable_ ? "true" : "false") << ",\n"
+        << "    \"processing_failures\": " << processing_failures_ << ",\n"
+        << "    \"backlog_at_drain\": " << backlog << ",\n"
+        << "    \"maximum_backlog_messages\": " << maximum_observed_backlog_ << ",\n"
+        << "    \"maximum_allowed_backlog_messages\": " << number_or_null(maximum_backlog_messages_) << ",\n"
+        << "    \"maximum_callback_latency_seconds\": " << double_or_null(maximum_callback_latency_seconds_observed_) << ",\n"
+        << "    \"maximum_allowed_callback_latency_seconds\": " << double_or_null(maximum_callback_latency_seconds_) << ",\n"
+        << "    \"first_processed_timestamp_seconds\": " << double_or_null(first_timestamp_) << ",\n"
+        << "    \"last_processed_timestamp_seconds\": " << double_or_null(last_timestamp_) << ",\n"
+        << "    \"required_end_timestamp_seconds\": " << double_or_null(required_end_timestamp_) << ",\n"
+        << "    \"paced_input_rate\": 1.0,\n"
+        << "    \"paced_input_rate_verified\": " << (paced_rate_verified_ ? "true" : "false") << ",\n"
+        << "    \"ack_backpressure_verified\": " << (ack_backpressure_verified_ ? "true" : "false") << ",\n"
+        << "    \"acknowledgement_contract\": \"one_publish_waits_for_callback_then_one_ack_service_call\",\n"
+        << "    \"queue_capacity_messages\": 1,\n"
+        << "    \"queue_drop_detection\": \"exact_counts_plus_single_inflight_ack\",\n"
+        << "    \"single_message_buffer_verified\": false,\n"
+        << "    \"counter_evidence_path\": " << json_string(evidence_path_) << ",\n"
+        << "    \"drain_complete\": " << (drain ? "true" : "false") << "\n"
+        << "  },\n"
+        << "  \"benchmark_only\": true,\n"
+        << "  \"ground_truth_content_opened\": false,\n"
+        << "  \"scorer_invoked\": false\n"
+        << "}\n";
+    return out.str();
+  }
+
+  bool write_eof_locked(std::size_t lidar, std::size_t imu, std::size_t image)
+  {
+    return write_atomic_locked(eof_path_, common_json_locked(false, lidar, imu, image, true, false));
+  }
+
+  bool write_final_locked(bool pass, std::size_t lidar, std::size_t imu, std::size_t image)
+  {
+    return write_atomic_locked(evidence_path_, common_json_locked(pass, lidar, imu, image, eof_observed_, pass));
+  }
+
+  bool enabled_ = false;
+  bool eof_observed_ = false;
+  bool queue_overflow_observable_ = false;
+  bool ack_backpressure_verified_ = false;
+  bool paced_rate_verified_ = false;
+  std::string phase_mode_;
+  std::string evidence_path_;
+  std::string eof_path_;
+  long long expected_total_ = -1;
+  long long expected_lidar_ = -1;
+  long long expected_imu_ = -1;
+  long long expected_image_ = -1;
+  double required_end_timestamp_ = -1.0;
+  double maximum_callback_latency_seconds_ = 0.25;
+  long long maximum_backlog_messages_ = 100000;
+  long long received_total_ = 0;
+  long long feeder_acknowledged_ = 0;
+  long long received_lidar_ = 0;
+  long long received_imu_ = 0;
+  long long received_image_ = 0;
+  long long dropped_messages_ = 0;
+  long long queue_overflow_ = 0;
+  long long processing_failures_ = 0;
+  long long maximum_observed_backlog_ = 0;
+  double maximum_callback_latency_seconds_observed_ = 0.0;
+  double first_timestamp_ = -1.0;
+  double last_timestamp_ = -1.0;
+  mutable std::mutex mutex_;
+};
+
+#endif
