diff --git a/src/glim/odometry/async_odometry_estimation.cpp b/src/glim/odometry/async_odometry_estimation.cpp
--- a/src/glim/odometry/async_odometry_estimation.cpp
+++ b/src/glim/odometry/async_odometry_estimation.cpp
@@ -44,6 +44,20 @@ int AsyncOdometryEstimation::workload() const {
   return input_frame_queue.size() + internal_frame_queue_size;
 }
 
+std::size_t AsyncOdometryEstimation::input_queue_size() const {
+  std::size_t size = static_cast<std::size_t>(input_imu_queue.size()) + static_cast<std::size_t>(input_frame_queue.size());
+#ifdef GLIM_USE_OPENCV
+  size += static_cast<std::size_t>(input_image_queue.size());
+#endif
+  return size;
+}
+
+std::uint64_t AsyncOdometryEstimation::dropped_input_count() const {
+  std::uint64_t count = input_imu_queue.dropped_count() + input_frame_queue.dropped_count();
+#ifdef GLIM_USE_OPENCV
+  count += input_image_queue.dropped_count();
+#endif
+  return count;
+}
+
+std::size_t AsyncOdometryEstimation::max_input_queue_size() const {
+  std::size_t size = input_imu_queue.max_size_observed() + input_frame_queue.max_size_observed();
+#ifdef GLIM_USE_OPENCV
+  size += input_image_queue.max_size_observed();
+#endif
+  return size;
+}
+
 void AsyncOdometryEstimation::get_results(std::vector<EstimationFrame::ConstPtr>& estimation_results, std::vector<EstimationFrame::ConstPtr>& marginalized_frames) {
   estimation_results = output_estimation_results.get_all_and_clear();
   marginalized_frames = output_marginalized_frames.get_all_and_clear();
 }
