+bool LIVMapper::m6a10_terminal_eof_service(
+  std_srvs::Trigger::Request &, std_srvs::Trigger::Response &response)
+{
+  std::lock_guard<std::mutex> buffer_guard(mtx_buffer);
+  m6a10_terminal_support_context.observe_terminal_eof();
+  response.success = true;
+  response.message = "terminal EOF observed; status polling required";
+  return true;
+}
+
+bool LIVMapper::m6a10_terminal_status_service(
+  std_srvs::Trigger::Request &request, std_srvs::Trigger::Response &response)
+{
+  std::lock_guard<std::mutex> buffer_guard(mtx_buffer);
+  const bool can_form_synchronization_unit =
+    !((lid_raw_data_buffer.empty() && lidar_en) ||
+      (img_buffer.empty() && img_en) ||
+      (imu_buffer.empty() && imu_en));
+  const bool predicate_observed =
+    m6a10_terminal_support_context.observe_terminal_sync_predicate(
+      can_form_synchronization_unit);
+  if (predicate_observed)
+  {
+    for (const std::string &record_id :
+         m6a10_terminal_support_context.pending_record_ids())
+    {
+      const M6A10TerminalSupportContext::Topic topic =
+        m6a10_terminal_support_context.pending_record_topic(record_id);
+      const std::string reason = topic == M6A10TerminalSupportContext::Topic::Lidar ?
+        "residual_lidar_rejected" : "strictly_after_completed_boundary";
+      m6a10_terminal_support_context.prove_terminal_record(
+        record_id, true, can_form_synchronization_unit, reason);
+    }
+  }
+  // Exactly one locked snapshot belongs to this RPC. Stability requires a
+  // second distinct terminal_status request after the configured wall gap.
+  m6a10_terminal_support_context.snapshot_pending_buffers();
+  return m6a10_terminal_support_context.status_service(request, response);
+}
+
+bool LIVMapper::m6a10_terminal_finalize_service(
+  std_srvs::Trigger::Request &request, std_srvs::Trigger::Response &response)
+{
+  std::lock_guard<std::mutex> buffer_guard(mtx_buffer);
+  return m6a10_terminal_support_context.finalize_service(request, response);
+}
