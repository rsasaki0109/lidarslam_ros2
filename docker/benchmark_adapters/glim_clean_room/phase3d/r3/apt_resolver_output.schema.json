{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glim-clean-room-r3-apt-resolver-output-v1",
  "title": "Sealed machine-readable apt print-uris resolution",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "role", "requirements_sha256",
    "base_status_sha256", "capture_mode", "raw_log_sha256", "command", "command_sha256",
    "exit_status", "uri_lines", "packages", "repositories", "canonical_sha256"],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_apt_resolver_output_v1"},
    "schema_version": {"const": 1}, "status": {"const": "SEALED_REVIEW_REQUIRED"},
    "role": {"enum": ["build", "runtime"]},
    "requirements_sha256": {"$ref": "#/$defs/sha256"},
    "base_status_sha256": {"$ref": "#/$defs/sha256"},
    "capture_mode": {"const": "HOST_RAW_PRINT_URIS"},
    "raw_log_sha256": {"$ref": "#/$defs/sha256"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "command_sha256": {"$ref": "#/$defs/sha256"}, "exit_status": {"const": 0},
    "uri_lines": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "url": {"type": "string", "pattern": "^https://[^\\r\\n\\x00]+$"},
    "package": {"type": "object", "additionalProperties": false,
      "required": ["name", "version", "architecture", "filename", "url", "bytes", "sha256",
        "repository_url", "release_url", "release_path", "release_sha256", "packages_url",
        "packages_path", "packages_sha256", "uri_digest_algorithm", "uri_digest", "essential",
        "pre_depends", "multiarch", "base_installed"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "filename": {"type": "string"}, "url": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"},
        "repository_url": {"$ref": "#/$defs/url"}, "release_url": {"$ref": "#/$defs/url"},
        "release_path": {"type": "string", "minLength": 1}, "release_sha256": {"$ref": "#/$defs/sha256"},
        "packages_url": {"$ref": "#/$defs/url"}, "packages_path": {"type": "string", "minLength": 1},
        "packages_sha256": {"$ref": "#/$defs/sha256"},
        "uri_digest_algorithm": {"enum": ["none", "sha256", "md5"]},
        "uri_digest": {"type": "string", "pattern": "^[0-9a-f]{0,64}$"},
        "essential": {"type": "boolean"}, "pre_depends": {"type": "array", "items": {"type": "string"}},
        "multiarch": {"type": "string", "minLength": 1}, "base_installed": {"type": "boolean"}
      }},
    "repository": {"type": "object", "additionalProperties": false,
      "required": ["url", "release_url", "release_path", "release_sha256", "packages_url", "packages_path", "packages_sha256"],
      "properties": {"url": {"$ref": "#/$defs/url"}, "release_url": {"$ref": "#/$defs/url"},
        "release_path": {"type": "string", "minLength": 1}, "release_sha256": {"$ref": "#/$defs/sha256"},
        "packages_url": {"$ref": "#/$defs/url"}, "packages_path": {"type": "string", "minLength": 1},
        "packages_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
