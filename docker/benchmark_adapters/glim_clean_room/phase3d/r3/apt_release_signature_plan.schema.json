{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glim-clean-room-r3-apt-release-signature-plan-v1",
  "title": "Non-executable apt Release signature verification plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "benchmark_eligible", "execution",
    "signature_runtime", "trust_root", "tool", "scope", "workflow", "phases", "outer_executor",
    "review_gate", "canonical_sha256"],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_apt_signature_plan_v1"},
    "schema_version": {"const": 1}, "status": {"const": "OPT_IN_NOT_READY"},
    "benchmark_eligible": {"const": false}, "execution": {"const": "NOT_RUN"},
    "signature_runtime": {"const": "NOT_RUN"},
    "trust_root": {"type": "object", "additionalProperties": false,
      "required": ["path", "file_bytes", "file_sha256", "canonical_sha256", "key_id",
        "fingerprint", "keyring_sha256", "keyring_path", "verifier_binary_path",
        "verifier_binary_sha256",
        "verification_time"],
      "properties": {"path": {"type": "string", "minLength": 1},
        "file_bytes": {"type": "integer", "minimum": 1},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "key_id": {"type": "string", "pattern": "^[0-9A-F]{16}$"},
        "fingerprint": {"type": "string", "pattern": "^[0-9A-F]{40}$"},
        "keyring_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "keyring_path": {"type": "string", "minLength": 1},
        "verifier_binary_path": {"type": "string", "minLength": 1},
        "verifier_binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verification_time": {"type": "integer", "minimum": 1}}},
    "tool": {"type": "object", "additionalProperties": false,
      "required": ["binary_path", "binary_sha256", "version", "argv", "argv_sha256"],
      "properties": {"binary_path": {"type": "string", "pattern": "^/.+"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "string"}},
        "argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "scope": {"type": "object", "additionalProperties": false,
      "required": ["release_kind", "release_path", "release_bytes", "release_sha256",
        "packages_path", "packages_bytes", "packages_sha256", "signature_path",
        "signature_bytes", "signature_sha256", "homedir", "output_root",
        "binding_identity_sha256"],
      "properties": {"release_kind": {"enum": ["INRELEASE", "RELEASE_DETACHED"]},
        "release_path": {"type": "string", "minLength": 1},
        "release_bytes": {"type": "integer", "minimum": 1},
        "release_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packages_path": {"type": "string", "minLength": 1},
        "packages_bytes": {"type": "integer", "minimum": 1},
        "packages_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature_path": {"type": "string"}, "signature_bytes": {"type": "integer", "minimum": 0},
        "signature_sha256": {"type": "string"},
        "homedir": {"type": "string", "minLength": 1},
        "output_root": {"type": "string", "minLength": 1},
        "binding_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "workflow": {"type": "array", "minItems": 8, "maxItems": 8,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["ordinal", "phase", "argv", "argv_sha256", "expected", "network"],
        "properties": {"ordinal": {"type": "integer", "minimum": 0}, "phase": {"type": "string"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "expected": {"const": "NOT_RUN"}, "network": {"const": "DISALLOWED"},
          "inventory_argv": {"type": "array"}, "inventory_argv_sha256": {"type": "string"}}}},
    "phases": {"type": "array", "minItems": 8, "maxItems": 8,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["ordinal", "phase", "status"],
        "properties": {"ordinal": {"type": "integer", "minimum": 0}, "phase": {"type": "string"},
          "status": {"const": "NOT_RUN"}}}},
    "outer_executor": {"type": "object", "additionalProperties": false,
      "required": ["status", "entrypoint", "sha256"],
      "properties": {"status": {"const": "IMPLEMENTED_NOT_RUNTIME_VALIDATED"},
        "entrypoint": {"const": "apt_release_signature_executor.execute_signature_plan"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "review_gate": {"type": "object", "additionalProperties": false,
      "required": ["custodian_signature_required", "network_execution", "collector_input_allowed"],
      "properties": {"custodian_signature_required": {"const": true},
        "network_execution": {"const": "NOT_RUN"}, "collector_input_allowed": {"const": false}}},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
