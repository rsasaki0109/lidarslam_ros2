{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glim-clean-room-r3-custodian-handoff-v1",
  "title": "Unsigned r3 custodian handoff request",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "benchmark_eligible", "domain",
    "campaign_id", "candidate", "policy", "executor", "authorization_verifier",
    "authorization_backend", "machine_identity", "plan", "trust_root", "repository",
    "binding", "deb_bindings", "deb_bindings_sha256", "scope", "safety",
    "requested_validity", "nonce", "custodian", "canonical_sha256"],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_custodian_handoff_v1"},
    "schema_version": {"const": 1},
    "status": {"const": "UNSIGNED_REVIEW_REQUIRED"},
    "benchmark_eligible": {"const": false},
    "domain": {"const": "lidarslam/glim-clean-room-r3/custodian-handoff/sha256/v1"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "candidate": {"$ref": "#/$defs/source"}, "policy": {"$ref": "#/$defs/source"},
    "executor": {"$ref": "#/$defs/source"},
    "authorization_verifier": {"$ref": "#/$defs/source"},
    "authorization_backend": {"type": "object", "additionalProperties": false,
      "required": ["name", "version", "implementation", "implementation_file", "implementation_sha256"],
      "properties": {"name": {"const": "python-cryptography"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "implementation": {"type": "string"}, "implementation_file": {"type": "string"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}}},
    "machine_identity": {"oneOf": [
      {"$ref": "#/$defs/legacyMachine"},
      {"$ref": "#/$defs/keyedMachine"}
    ]},
    "plan": {"$ref": "#/$defs/source"},
    "trust_root": {"type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "file_bytes", "canonical_sha256", "schema",
        "key_id", "fingerprint"], "properties": {
        "path": {"type": "string", "pattern": "^[^/][^\\u0000]*$"},
        "file_sha256": {"$ref": "#/$defs/sha256"}, "file_bytes": {"type": "integer", "minimum": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}, "schema": {"type": "string"},
        "key_id": {"type": "string"}, "fingerprint": {"type": "string"}}},
    "repository": {"type": "object", "additionalProperties": false,
      "required": ["url", "release_url", "release_path", "release_sha256", "packages_url",
        "packages_path", "packages_sha256"], "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "release_url": {"type": "string", "pattern": "^https://"},
        "release_path": {"type": "string"}, "release_sha256": {"$ref": "#/$defs/sha256"},
        "packages_url": {"type": "string", "pattern": "^https://"},
        "packages_path": {"type": "string"}, "packages_sha256": {"$ref": "#/$defs/sha256"}}},
    "binding": {"type": "object"},
    "deb_bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "deb_bindings_sha256": {"$ref": "#/$defs/sha256"},
    "scope": {"type": "object", "additionalProperties": false,
      "required": ["root_inputs", "homedir", "output_root"], "properties": {
        "root_inputs": {"type": "string", "pattern": "^/"},
        "homedir": {"type": "string", "pattern": "^/"},
        "output_root": {"type": "string", "pattern": "^/"}}},
    "safety": {"type": "object", "additionalProperties": false,
      "required": ["network_used", "shell", "timeout_seconds", "resource_limits",
        "machine_validation"], "properties": {
        "network_used": {"const": false}, "shell": {"const": false},
        "timeout_seconds": {"const": 30},
        "resource_limits": {"type": "object", "additionalProperties": false,
          "required": ["RLIMIT_CORE", "RLIMIT_FSIZE"],
          "properties": {"RLIMIT_CORE": {"const": 0}, "RLIMIT_FSIZE": {"const": 262144}}},
        "machine_validation": {"const": "OFFLINE_ARTIFACT_ONLY"}}},
    "requested_validity": {"type": "object", "additionalProperties": false,
      "required": ["issued_at", "expires_at"], "properties": {
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 1}}},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "authorization_template": {"type": "object", "additionalProperties": false,
      "required": ["schema", "domain", "unsigned_field_names", "signature_field_names", "bindings"],
      "properties": {"schema": {"const": "glim_clean_room_r3_apt_signature_authorization_v1"},
        "domain": {"const": "lidarslam/glim-clean-room-r3/apt-signature-host-authorization/ed25519/v1"},
        "unsigned_field_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "signature_field_names": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "bindings": {"type": "object", "additionalProperties": true,
          "required": ["candidate", "policy", "plan", "executor", "trust_root", "repository",
            "binding_identity_sha256", "deb_bindings_sha256", "tool", "scope",
            "machine_identity", "machine_fingerprint", "workflow_sha256", "phases_sha256"],
          "properties": {"binding_identity_sha256": {"$ref": "#/$defs/sha256"},
            "deb_bindings_sha256": {"$ref": "#/$defs/sha256"},
            "machine_fingerprint": {"$ref": "#/$defs/sha256"},
            "workflow_sha256": {"$ref": "#/$defs/sha256"},
            "phases_sha256": {"$ref": "#/$defs/sha256"}}}}},
    "custodian": {"type": "object", "additionalProperties": false,
      "required": ["status", "algorithm", "key_id", "public_key_base64", "signature_base64"],
      "properties": {"status": {"const": "UNSIGNED_REVIEW_REQUIRED"},
        "algorithm": {"const": "Ed25519"}, "key_id": {"const": ""},
        "public_key_base64": {"const": ""}, "signature_base64": {"const": ""}}},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeRelative": {"type": "string", "pattern": "^[^/][^\\u0000]*$"},
    "legacyMachine": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "canonical_sha256",
        "campaign_domain", "campaign_id", "identity_sha256", "validation"],
      "properties": {
        "schema": {"const": "glim_clean_room_r3_machine_identity_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_domain": {"const": "lidarslam/glim-clean-room-r3/machine-identity/sha256/v1"},
        "campaign_id": {"type": "string"}, "identity_sha256": {"$ref": "#/$defs/sha256"},
        "validation": {"const": "OFFLINE_ARTIFACT_ONLY"}
      }},
    "keyRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "campaign_id", "key_id", "algorithm", "public_key_sha256",
        "provisioning_receipt_sha256"],
      "properties": {
        "schema": {"const": "glim_clean_room_r3_machine_host_public_key_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_id": {"type": "string"}, "key_id": {"type": "string"},
        "algorithm": {"const": "Ed25519"}, "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "provisioning_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }},
    "challengeRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "challenge_payload_sha256"],
      "properties": {"schema": {"const": "glim_clean_room_r3_machine_key_challenge_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "challenge_payload_sha256": {"$ref": "#/$defs/sha256"}}},
    "proofRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "challenge_payload_sha256", "signature_sha256"],
      "properties": {"schema": {"const": "glim_clean_room_r3_machine_key_proof_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "challenge_payload_sha256": {"$ref": "#/$defs/sha256"},
        "signature_sha256": {"$ref": "#/$defs/sha256"}}},
    "keyedMachine": {"type": "object", "additionalProperties": false,
      "required": ["method", "schema", "path", "file_sha256", "canonical_sha256",
        "campaign_domain", "campaign_id", "identity_sha256", "host_public_key", "challenge",
        "proof", "validation"],
      "properties": {
        "method": {"const": "PROVISIONED_ED25519"},
        "schema": {"const": "glim_clean_room_r3_machine_identity_keyed_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_domain": {"const": "lidarslam/glim-clean-room-r3/machine-identity-keyed/sha256/v1"},
        "campaign_id": {"type": "string"}, "identity_sha256": {"$ref": "#/$defs/sha256"},
        "host_public_key": {"$ref": "#/$defs/keyRef"}, "challenge": {"$ref": "#/$defs/challengeRef"},
        "proof": {"$ref": "#/$defs/proofRef"},
        "validation": {"const": "OFFLINE_ARTIFACT_ONLY"}
      }},
    "source": {"type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "file_bytes", "canonical_sha256"],
      "properties": {"path": {"type": "string", "pattern": "^[^/][^\\u0000]*$"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1},
        "canonical_sha256": {"type": "string"}, "schema": {"type": "string"}}}
  }
}
