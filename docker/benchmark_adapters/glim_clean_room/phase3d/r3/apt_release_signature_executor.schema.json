{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glim-clean-room-r3-apt-release-signature-executor-v1",
  "title": "Non-promoting bounded r3 OpenPGP signature executor receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "candidate_status",
    "benchmark_eligible", "signature_runtime", "execution_mode", "outcome",
    "promotion", "error", "plan_sha256", "output_root_identity", "input", "tool",
    "commands", "phases", "binding", "inventory", "signature", "cleanup", "clock",
    "outer_executor", "canonical_sha256"],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_apt_signature_executor_receipt_v1"},
    "schema_version": {"const": 1},
    "status": {"const": "SEALED_EXECUTOR_RESULT"},
    "candidate_status": {"enum": ["IMPLEMENTED_NOT_RUNTIME_VALIDATED", "HOST_AUTHORIZED_SUBPROCESS"]},
    "benchmark_eligible": {"type": "boolean"},
    "signature_runtime": {"enum": ["NOT_RUN", "RUNTIME_VERIFIED", "RUNTIME_FAILED"]},
    "execution_mode": {"enum": ["INJECTED_FIXTURE_ONLY", "HOST_AUTHORIZED_SUBPROCESS"]},
    "outcome": {"enum": ["PASS", "FAIL"]},
    "promotion": {"enum": ["FORBIDDEN", "HOST_AUTHORIZED_RUNTIME"]},
    "error": {"type": "string", "maxLength": 2048},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_root_identity": {"type": "object", "additionalProperties": false,
      "required": ["device", "inode", "mode"],
      "properties": {"device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "mode": {"const": 448}}},
    "input": {"type": "object", "additionalProperties": false,
      "required": ["root", "trust_root_path", "trust_root_sha256", "release_path",
        "release_sha256", "packages_path", "packages_sha256", "release_kind",
        "signature_path", "signature_sha256", "binding_identity_sha256"],
      "properties": {"root": {"type": "string", "pattern": "^/"},
        "trust_root_path": {"type": "string", "minLength": 1},
        "trust_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "release_path": {"type": "string", "minLength": 1},
        "release_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packages_path": {"type": "string", "minLength": 1},
        "packages_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "release_kind": {"enum": ["INRELEASE", "RELEASE_DETACHED"]},
        "signature_path": {"type": "string"},
        "signature_sha256": {"type": "string"},
        "binding_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "tool": {"type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "version", "version_line",
        "command", "command_sha256"],
      "properties": {"path": {"type": "string", "pattern": "^/"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "mode": {"type": "integer", "minimum": 0},
        "version": {"type": "string", "minLength": 1},
        "version_line": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "command_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "commands": {"type": "array", "minItems": 1, "maxItems": 3,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["phase", "argv", "argv_sha256", "env", "env_sha256", "cwd",
          "stdin", "shell", "timeout_seconds", "resource_limits", "stdout", "stderr",
          "returncode", "timed_out", "signal"],
        "properties": {"phase": {"enum": ["tool_version", "key-inventory", "signature-verify"]},
          "argv": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "argv_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "env": {"type": "object", "additionalProperties": {"type": "string"}},
          "env_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "cwd": {"type": "string", "pattern": "^/"}, "stdin": {"const": "DEVNULL"},
          "shell": {"const": false}, "timeout_seconds": {"const": 30},
          "resource_limits": {"type": "object", "additionalProperties": false,
            "required": ["RLIMIT_CORE", "RLIMIT_FSIZE"],
            "properties": {"RLIMIT_CORE": {"const": 0}, "RLIMIT_FSIZE": {"const": 262144}}},
          "stdout": {"$ref": "#/$defs/log"}, "stderr": {"$ref": "#/$defs/log"},
          "returncode": {"type": "integer", "minimum": -256, "maximum": 255},
          "timed_out": {"type": "boolean"}, "signal": {"type": ["integer", "null"]}}}},
    "phases": {"type": "array", "minItems": 8, "maxItems": 8,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["ordinal", "phase", "status"],
        "properties": {"ordinal": {"type": "integer", "minimum": 0},
          "phase": {"type": "string"}, "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]}}}},
    "binding": {"type": ["object", "null"]},
    "inventory": {"type": ["object", "null"]},
    "signature": {"type": ["object", "null"]},
    "authorization": {"type": "object"},
    "authorization_machine": {"type": "object", "additionalProperties": false,
      "required": ["artifact", "live_host_match"],
      "properties": {"artifact": {"oneOf": [
        {"$ref": "#/$defs/legacyMachineIdentity"},
        {"$ref": "#/$defs/keyedMachineIdentity"}
      ]}, "live_host_match": {"const": true}}},
    "authorization_verification_time": {"type": "integer", "minimum": 0},
    "nonce_claim": {"type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "parent_device", "parent_inode"],
      "properties": {"path": {"type": "string", "pattern": "^/"},
        "bytes": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "parent_device": {"type": "integer", "minimum": 0}, "parent_inode": {"type": "integer", "minimum": 1}}},
    "cleanup": {"type": "object", "additionalProperties": false,
      "required": ["requested", "removed", "post_absent", "identity", "error"],
      "properties": {"requested": {"const": true}, "removed": {"type": "boolean"},
        "post_absent": {"type": "boolean"}, "identity": {"type": ["object", "null"]},
        "error": {"type": "string", "maxLength": 512}}},
    "clock": {"type": "object", "additionalProperties": false,
      "required": ["source", "start", "end", "duration"],
      "properties": {"source": {"const": "monotonic_ns"}, "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}, "duration": {"type": "integer", "minimum": 0}}},
    "outer_executor": {"type": "object", "additionalProperties": false,
      "required": ["status", "entrypoint", "source_sha256"],
      "properties": {"status": {"enum": ["IMPLEMENTED_NOT_RUNTIME_VALIDATED", "HOST_AUTHORIZED_SUBPROCESS"]},
        "entrypoint": {"const": "apt_release_signature_executor.execute_signature_plan"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"execution_mode": {"const": "INJECTED_FIXTURE_ONLY"}}},
     "then": {"properties": {"candidate_status": {"const": "IMPLEMENTED_NOT_RUNTIME_VALIDATED"},
       "benchmark_eligible": {"const": false}, "signature_runtime": {"const": "NOT_RUN"},
       "promotion": {"const": "FORBIDDEN"}}}},
    {"if": {"properties": {"execution_mode": {"const": "HOST_AUTHORIZED_SUBPROCESS"}}},
     "then": {"required": ["authorization", "nonce_claim", "authorization_machine"], "properties": {
       "candidate_status": {"const": "HOST_AUTHORIZED_SUBPROCESS"},
       "signature_runtime": {"enum": ["RUNTIME_VERIFIED", "RUNTIME_FAILED"]},
       "authorization_verification_time": {"type": "integer", "minimum": 0}}}},
    {"if": {"properties": {"execution_mode": {"const": "HOST_AUTHORIZED_SUBPROCESS"},
                               "outcome": {"const": "PASS"}}},
     "then": {"required": ["authorization_verification_time"], "properties": {
       "benchmark_eligible": {"const": true}, "promotion": {"const": "HOST_AUTHORIZED_RUNTIME"}}}},
    {"if": {"properties": {"execution_mode": {"const": "HOST_AUTHORIZED_SUBPROCESS"},
                               "outcome": {"const": "FAIL"}}},
     "then": {"required": ["authorization_verification_time"], "properties": {
       "benchmark_eligible": {"const": false}, "promotion": {"const": "FORBIDDEN"}}}}
  ],
  "$defs": {
    "log": {"type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeRelative": {"type": "string", "pattern": "^[^/][^\\u0000]*$"},
    "legacyMachineIdentity": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "canonical_sha256",
        "campaign_domain", "campaign_id", "identity_sha256"],
      "properties": {
        "schema": {"const": "glim_clean_room_r3_machine_identity_v1"},
        "path": {"$ref": "#/$defs/safeRelative"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_domain": {"const": "lidarslam/glim-clean-room-r3/machine-identity/sha256/v1"},
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }},
    "keyRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "campaign_id", "key_id", "algorithm", "public_key_sha256",
        "provisioning_receipt_sha256"],
      "properties": {
        "schema": {"const": "glim_clean_room_r3_machine_host_public_key_v1"},
        "path": {"$ref": "#/$defs/safeRelative"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "algorithm": {"const": "Ed25519"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "provisioning_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }},
    "challengeRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "challenge_payload_sha256"],
      "properties": {
        "schema": {"const": "glim_clean_room_r3_machine_key_challenge_v1"},
        "path": {"$ref": "#/$defs/safeRelative"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "challenge_payload_sha256": {"$ref": "#/$defs/sha256"}
      }},
    "proofRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "challenge_payload_sha256", "signature_sha256"],
      "properties": {
        "schema": {"const": "glim_clean_room_r3_machine_key_proof_v1"},
        "path": {"$ref": "#/$defs/safeRelative"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "challenge_payload_sha256": {"$ref": "#/$defs/sha256"},
        "signature_sha256": {"$ref": "#/$defs/sha256"}
      }},
    "keyedMachineIdentity": {"type": "object", "additionalProperties": false,
      "required": ["method", "schema", "path", "file_sha256", "canonical_sha256",
        "campaign_domain", "campaign_id", "identity_sha256", "host_public_key",
        "challenge", "proof"],
      "properties": {
        "method": {"const": "PROVISIONED_ED25519"},
        "schema": {"const": "glim_clean_room_r3_machine_identity_keyed_v1"},
        "path": {"$ref": "#/$defs/safeRelative"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_domain": {"const": "lidarslam/glim-clean-room-r3/machine-identity-keyed/sha256/v1"},
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "host_public_key": {"$ref": "#/$defs/keyRef"},
        "challenge": {"$ref": "#/$defs/challengeRef"},
        "proof": {"$ref": "#/$defs/proofRef"}
      }}
  }
}
