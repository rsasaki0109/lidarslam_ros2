{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glim-clean-room-r3-apt-allowlist-outer-receipt-v1",
  "title": "Host-owned r3 apt closure execution receipt contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "benchmark_eligible",
    "execution", "pinned_image", "plan_identity_sha256", "workflow",
    "raw_artifacts", "cleanup", "network", "canonical_sha256"],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_apt_allowlist_outer_receipt_v1"},
    "schema_version": {"const": 1},
    "status": {"enum": ["NOT_RUNTIME_VALIDATED", "REVIEW_REQUIRED", "SEALED_FAILURE"]},
    "benchmark_eligible": {"const": false},
    "execution": {"enum": ["NOT_RUN", "PLANNED", "CAPTURE_NOT_RUNTIME_VALIDATED"]},
    "pinned_image": {"type": "object", "additionalProperties": false,
      "required": ["reference", "platform", "ros_distribution", "image_inspect_sha256"],
      "properties": {
        "reference": {"type": "string", "pattern": "^ros@sha256:[0-9a-f]{64}$"},
        "platform": {"const": "linux/amd64"}, "ros_distribution": {"const": "jazzy"},
        "image_inspect_sha256": {"$ref": "#/$defs/sha256"}}},
    "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
    "workflow": {"type": "array", "minItems": 1, "items": {"type": "object",
      "additionalProperties": false, "required": ["ordinal", "phase", "argv",
        "argv_sha256", "exit_status", "stdout_sha256", "stderr_sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0}, "phase": {"type": "string", "minLength": 1},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "argv_sha256": {"$ref": "#/$defs/sha256"}, "exit_status": {"type": "integer"},
        "stdout_sha256": {"$ref": "#/$defs/sha256"}, "stderr_sha256": {"$ref": "#/$defs/sha256"}}}},
    "raw_artifacts": {"type": "object", "additionalProperties": false,
      "required": ["base_status", "apt_sources", "rosdep_sources", "build_print_uris",
        "runtime_print_uris"],
      "properties": {"base_status": {"$ref": "#/$defs/artifact"},
        "apt_sources": {"$ref": "#/$defs/artifact"}, "rosdep_sources": {"$ref": "#/$defs/artifact"},
        "build_print_uris": {"$ref": "#/$defs/artifact"},
        "runtime_print_uris": {"$ref": "#/$defs/artifact"}}},
    "cleanup": {"type": "object", "additionalProperties": false,
      "required": ["stop_exit_status", "remove_exit_status", "post_remove_absent",
        "absence_log_sha256"],
      "properties": {"stop_exit_status": {"const": 0}, "remove_exit_status": {"const": 0},
        "post_remove_absent": {"const": true}, "absence_log_sha256": {"$ref": "#/$defs/sha256"}}},
    "network": {"type": "object", "additionalProperties": false,
      "required": ["provisioning_network_used", "build_test_network_connected",
        "build_test_network_used", "disconnect_verified"],
      "properties": {"provisioning_network_used": {"const": true},
        "build_test_network_connected": {"const": false},
        "build_test_network_used": {"const": false}, "disconnect_verified": {"const": true}}},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "source_phase"],
      "properties": {"path": {"type": "string", "pattern": "^/[^\\x00]*$"},
        "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"},
        "source_phase": {"type": "string", "minLength": 1}}}
  }
}
