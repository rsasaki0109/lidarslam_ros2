{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glim-clean-room-r3-apt-signature-authorization-v1",
  "title": "Detached Ed25519 r3 host runtime authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "candidate", "policy", "plan",
    "executor", "trust_root", "repository", "binding", "deb_bindings", "deb_bindings_sha256",
    "machine_identity",
    "tool", "scope", "machine_fingerprint", "issued_at", "expires_at", "nonce",
    "network_used", "shell", "timeout_seconds", "resource_limits", "workflow", "phases",
    "signature"],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_apt_signature_authorization_v1"},
    "schema_version": {"const": 1},
    "status": {"const": "HOST_RUNTIME_AUTHORIZATION"},
    "candidate": {"$ref": "#/$defs/identity"},
    "policy": {"$ref": "#/$defs/policyIdentity"},
    "plan": {"type": "object", "additionalProperties": false, "required": ["sha256", "canonical_sha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "canonical_sha256": {"$ref": "#/$defs/sha256"}}},
    "executor": {"type": "object", "additionalProperties": false, "required": ["source_sha256"],
      "properties": {"source_sha256": {"$ref": "#/$defs/sha256"}}},
    "machine_identity": {"oneOf": [
      {"$ref": "#/$defs/legacyMachineIdentity"},
      {"$ref": "#/$defs/keyedMachineIdentity"}
    ]},
    "trust_root": {"type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "canonical_sha256", "keyring_path", "keyring_sha256", "key_id", "fingerprint"],
      "properties": {"path": {"type": "string"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}, "keyring_path": {"type": "string"},
        "keyring_sha256": {"$ref": "#/$defs/sha256"}, "key_id": {"type": "string"},
        "fingerprint": {"type": "string"}}},
    "repository": {"type": "object", "additionalProperties": false,
      "required": ["url", "release_url", "release_path", "release_sha256", "packages_url", "packages_path", "packages_sha256"],
      "properties": {"url": {"type": "string", "pattern": "^https://"}, "release_url": {"type": "string", "pattern": "^https://"},
        "release_path": {"type": "string"}, "release_sha256": {"$ref": "#/$defs/sha256"},
        "packages_url": {"type": "string", "pattern": "^https://"}, "packages_path": {"type": "string"},
        "packages_sha256": {"$ref": "#/$defs/sha256"}}},
    "binding": {"type": "object"},
    "deb_bindings": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "deb_bindings_sha256": {"$ref": "#/$defs/sha256"},
    "tool": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "version"],
      "properties": {"path": {"type": "string", "pattern": "^/"}, "sha256": {"$ref": "#/$defs/sha256"}, "version": {"type": "string"}}},
    "scope": {"type": "object", "additionalProperties": false, "required": ["root_inputs", "homedir", "output_root"],
      "properties": {"root_inputs": {"type": "string", "pattern": "^/"}, "homedir": {"type": "string", "pattern": "^/"},
        "output_root": {"type": "string", "pattern": "^/"}}},
    "machine_fingerprint": {"$ref": "#/$defs/sha256"},
    "issued_at": {"type": "integer", "minimum": 0}, "expires_at": {"type": "integer", "minimum": 1},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{32,128}$"},
    "network_used": {"const": false}, "shell": {"const": false}, "timeout_seconds": {"const": 30},
    "resource_limits": {"type": "object", "additionalProperties": false, "required": ["RLIMIT_CORE", "RLIMIT_FSIZE"],
      "properties": {"RLIMIT_CORE": {"const": 0}, "RLIMIT_FSIZE": {"const": 262144}}},
    "workflow": {"type": "array", "minItems": 8}, "phases": {"type": "array", "minItems": 8},
    "signature": {"type": "object", "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key_sha256", "payload_sha256", "signature_base64", "backend"],
      "properties": {"algorithm": {"const": "Ed25519"}, "key_id": {"type": "string"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"}, "payload_sha256": {"$ref": "#/$defs/sha256"},
        "signature_base64": {"type": "string", "minLength": 1},
        "backend": {"type": "object", "additionalProperties": false,
          "required": ["name", "version", "implementation", "implementation_file", "implementation_sha256"],
          "properties": {"name": {"const": "python-cryptography"}, "version": {"type": "string"},
            "implementation": {"type": "string"}, "implementation_file": {"type": "string"},
            "implementation_sha256": {"$ref": "#/$defs/sha256"}}}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeRelative": {"type": "string", "pattern": "^[^/][^\\u0000]*$"},
    "legacyMachineIdentity": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "canonical_sha256",
        "campaign_domain", "campaign_id", "identity_sha256"],
      "properties": {
        "schema": {"const": "glim_clean_room_r3_machine_identity_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_domain": {"const": "lidarslam/glim-clean-room-r3/machine-identity/sha256/v1"},
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }},
    "keyRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "campaign_id", "key_id", "algorithm", "public_key_sha256",
        "provisioning_receipt_sha256"],
      "properties": {
        "schema": {"const": "glim_clean_room_r3_machine_host_public_key_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "algorithm": {"const": "Ed25519"}, "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "provisioning_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }},
    "challengeRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "challenge_payload_sha256"],
      "properties": {"schema": {"const": "glim_clean_room_r3_machine_key_challenge_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "challenge_payload_sha256": {"$ref": "#/$defs/sha256"}}},
    "proofRef": {"type": "object", "additionalProperties": false,
      "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256",
        "challenge_payload_sha256", "signature_sha256"],
      "properties": {"schema": {"const": "glim_clean_room_r3_machine_key_proof_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "challenge_payload_sha256": {"$ref": "#/$defs/sha256"},
        "signature_sha256": {"$ref": "#/$defs/sha256"}}},
    "keyedMachineIdentity": {"type": "object", "additionalProperties": false,
      "required": ["method", "schema", "path", "file_sha256", "canonical_sha256",
        "campaign_domain", "campaign_id", "identity_sha256", "host_public_key", "challenge", "proof"],
      "properties": {
        "method": {"const": "PROVISIONED_ED25519"},
        "schema": {"const": "glim_clean_room_r3_machine_identity_keyed_v1"},
        "path": {"$ref": "#/$defs/safeRelative"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "campaign_domain": {"const": "lidarslam/glim-clean-room-r3/machine-identity-keyed/sha256/v1"},
        "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}, "host_public_key": {"$ref": "#/$defs/keyRef"},
        "challenge": {"$ref": "#/$defs/challengeRef"}, "proof": {"$ref": "#/$defs/proofRef"}
      }},
    "identity": {"type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "canonical_sha256", "candidate_id", "revision"],
      "properties": {"path": {"type": "string"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}, "candidate_id": {"type": "string"}, "revision": {"type": "integer"}}},
    "policyIdentity": {"type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "canonical_sha256"],
      "properties": {"path": {"type": "string"}, "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
