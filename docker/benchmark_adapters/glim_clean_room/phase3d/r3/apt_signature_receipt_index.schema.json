{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glim-clean-room-r3-apt-signature-receipt-index-v1",
  "title": "Per-repository strong GLIM r3 signature receipt index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "benchmark_eligible",
    "proposal_sha256", "entries", "canonical_sha256"],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_apt_signature_receipt_index_v1"},
    "schema_version": {"const": 1},
    "status": {"const": "REVIEW_REQUIRED"},
    "benchmark_eligible": {"const": false},
    "proposal_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute": {"type": "string", "pattern": "^/[^\\x00]*$"},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "release_url", "release_path", "release_sha256",
        "packages_url", "packages_path", "packages_sha256"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "release_url": {"type": "string", "pattern": "^https://"},
        "release_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+"},
        "release_sha256": {"$ref": "#/$defs/sha256"},
        "packages_url": {"type": "string", "pattern": "^https://"},
        "packages_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+"},
        "packages_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "deb": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "architecture", "path"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$)).+"}
      }
    },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "receipt_root", "receipt_file_sha256", "plan_path",
        "plan_file_sha256", "plan_identity_sha256", "root_inputs", "deb_bindings"],
      "properties": {
        "repository": {"$ref": "#/$defs/repository"},
        "receipt_root": {"$ref": "#/$defs/absolute"},
        "receipt_file_sha256": {"$ref": "#/$defs/sha256"},
        "plan_path": {"$ref": "#/$defs/absolute"},
        "plan_file_sha256": {"$ref": "#/$defs/sha256"},
        "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
        "root_inputs": {"$ref": "#/$defs/absolute"},
        "deb_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/deb"}}
      }
    }
  }
}
