"mount_policy": {"$ref": "#/$defs/prepareMountPolicy"}, "discovery": {"type": "object", "additionalProperties": true}, "execution": {"type": "object", "additionalProperties": false, "required": ["image_digest", "platform", "pull", "build", "network", "network_disconnect_required", "fallback", "runner"], "properties": {"image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "platform": {"const": "linux/amd64"}, "pull": {"const": false}, "build": {"const": false}, "network": {"const": "none"}, "network_disconnect_required": {"const": true}, "fallback": {"const": "forbidden"}, "runner": {"const": "existing_prepare_tool"}}}, "output": {"type": "object", "additionalProperties": false, "required": ["receipt_relative", "source_and_cache", "deb_inputs"], "properties": {"receipt_relative": {"const": "rosdep-prepare/registration_plugin_rosdep_prepare.receipt.json"}, "source_and_cache": {"const": "receipt-bound-sealed-descriptors"}, "deb_inputs": {"const": "discovery-11-exact-four"}}}, "promotion": {"type": "object", "additionalProperties": false, "required": ["status", "benchmark_eligible", "claim_eligible", "active_profile_switch", "promotion"], "properties": {"status": {"const": "REVIEW_REQUIRED"}, "benchmark_eligible": {"const": false}, "claim_eligible": {"const": false}, "active_profile_switch": {"const": false}, "promotion": {"const": "FORBIDDEN_UNTIL_SIGNED_REVIEW"}}}}},
