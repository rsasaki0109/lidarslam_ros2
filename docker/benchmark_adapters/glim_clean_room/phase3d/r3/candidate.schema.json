        "required_proof_tags": {"const": ["NEWSIG", "GOODSIG", "VALIDSIG"]},
        "optional_informational_tags": {
          "const": ["KEY_CONSIDERED", "VERIFICATION_COMPLIANCE_MODE"]},
        "informational_pair": {"const": "independently-optional"},
        "status_order": {"const": ["NEWSIG", "KEY_CONSIDERED", "SIG_ID",
          "GOODSIG", "VALIDSIG", "VERIFICATION_COMPLIANCE_MODE"]},
        "key_considered_fields": {"const": 4},
        "key_considered_fingerprint": {"const": "validsig-primary-or-signer"},
        "key_considered_flags": {
          "const": "canonical-decimal-0..2147483647"},
        "verification_compliance_mode_fields": {"const": 3},
        "verification_compliance_mode": {
          "const": "canonical-decimal-0..2147483647"},
        "informational_only": {"const": true},
        "proof": {"const": "GOODSIG_VALIDSIG_only"},
        "keyring_input": {"const": "dearmored_path_only"}
      }
    },
    "gpgInventoryPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "executable", "versions",
        "version_argv", "argv_template", "homedir", "environment", "shell",
        "network", "version_timeout_seconds", "inventory_timeout_seconds",
        "failure_status", "metadata_residue_schema", "metadata_residue_policy",
        "metadata_residue_names", "metadata_residue_mode",
        "metadata_residue_max_bytes", "metadata_residue_retention"],
      "properties": {
        "schema": {"const": "registration-plugin-gpg-key-inventory-policy-v1"},
        "schema_version": {"const": 1}, "executable": {"const": "/usr/bin/gpg"},
        "versions": {"const": ["gpg (GnuPG) 2.2.27", "gpg (GnuPG) 2.4.4"]},
        "version_argv": {"const": ["/usr/bin/gpg", "--version"]},
        "argv_template": {"const": [
          "/usr/bin/gpg", "--batch", "--no-options", "--no-default-keyring",
          "--no-auto-key-retrieve", "--no-auto-key-import", "--no-auto-key-locate",
          "--no-autostart", "--homedir", "<fresh-homedir>", "--with-colons",
          "--with-fingerprint", "--with-subkey-fingerprint", "--import-options",
          "show-only", "--import", "<dearmored-keyring>"
        ]},
        "homedir": {
          "type": "object", "additionalProperties": false,
          "required": ["parent", "parent_relative", "prefix", "token_hex_length", "mode",
            "post_absent", "parent_empty_before_after", "cleanup"],
          "properties": {
            "parent": {"const": "/workspace/evidence-parent/gpg-inventory-work"},
            "parent_relative": {"const": "gpg-inventory-work"},
            "prefix": {"const": "glim-clean-room-r3-gpg-inventory-"},
            "token_hex_length": {"const": 24}, "mode": {"const": 448},
            "post_absent": {"const": true}, "parent_empty_before_after": {"const": true}, "cleanup": {
              "const": "owned-tree-only-and-absence-required"}
          }
        },
        "environment": {"const": "fixed-locale-no-home-or-agent"},
        "shell": {"const": false}, "network": {"const": "none"},
        "version_timeout_seconds": {"const": 30},
        "inventory_timeout_seconds": {"const": 120},
        "metadata_residue_schema": {"const": "registration-plugin-gpg-inventory-metadata-v1"},
        "metadata_residue_policy": {"const": "exact-pubring.kbx-trustdb.gpg-supported-show-only"},
        "metadata_residue_names": {"const": ["pubring.kbx", "trustdb.gpg"]},
        "metadata_residue_mode": {"const": 384},
        "metadata_residue_max_bytes": {"const": 16777216},
        "metadata_residue_retention": {"const": "descriptor-only-cleaned"},
        "failure_status": {"const": "REVIEW_REQUIRED"}
      }
    },
    "pathSha": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
