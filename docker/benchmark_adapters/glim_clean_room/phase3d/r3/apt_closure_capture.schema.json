{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glim-clean-room-r3-apt-closure-capture-v1",
  "title": "GLIM clean-room r3 apt/deb capture receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "status", "benchmark_eligible", "capture_id",
    "base_image", "network", "provisioning", "container", "package_allowlist",
    "dpkg_packages_sorted", "repositories", "apt_source_files_sha256",
    "apt_release_or_inrelease", "rosdep_sources_sha256", "rosdep_cache_files",
    "archive_set_identity_sha256", "plan_identity_sha256", "custodian_review",
    "files", "closure_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_apt_closure_capture_v1"},
    "schema_version": {"const": 1},
    "status": {"const": "REVIEW_REQUIRED"},
    "benchmark_eligible": {"const": false},
    "capture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "base_image": {"$ref": "#/$defs/baseImage"},
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["network_used", "phase", "build_test_network", "disconnect_required"],
      "properties": {
        "network_used": {"const": true},
        "phase": {"const": "PROVISIONING_CONNECTED"},
        "build_test_network": {"const": "NOT_STARTED"},
        "disconnect_required": {"const": true}
      }
    },
    "provisioning": {
      "type": "object", "additionalProperties": false,
      "required": ["command", "command_sha256", "exit_status"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "command_sha256": {"$ref": "#/$defs/sha256"},
        "exit_status": {"const": 0}
      }
    },
    "container": {"$ref": "#/$defs/container"},
    "package_allowlist": {"$ref": "#/$defs/allowlist"},
    "dpkg_packages_sorted": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "apt_source_files_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/refRecord"}},
    "apt_release_or_inrelease": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/refRecord"}},
    "rosdep_sources_sha256": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/refRecord"}},
    "rosdep_cache_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cacheRecord"}},
    "archive_set_identity_sha256": {"$ref": "#/$defs/sha256"},
    "plan_identity_sha256": {"$ref": "#/$defs/sha256"},
    "custodian_review": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "signature", "required"],
      "properties": {
        "status": {"const": "UNSIGNED_PLACEHOLDER"},
        "signature": {"const": ""},
        "required": {"const": true}
      }
    },
    "files": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/file"}},
    "closure_identity_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseImage": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "digest", "distribution", "platform"],
      "properties": {
        "reference": {"pattern": "^ros@sha256:[0-9a-f]{64}$"},
        "digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "distribution": {"const": "jazzy"},
        "platform": {"const": "linux/amd64"}
      }
    },
    "container": {
      "type": "object", "additionalProperties": false,
      "required": ["image_reference", "image_inspect", "argv", "mounts", "network_mode", "phase_trace", "network_used"],
      "properties": {
        "image_reference": {"pattern": "^ros@sha256:[0-9a-f]{64}$"},
        "image_inspect": {
          "type": "object", "additionalProperties": false,
          "required": ["Id", "RepoDigests", "Os", "Architecture"],
          "properties": {
            "Id": {"pattern": "^sha256:[0-9a-f]{64}$"},
            "RepoDigests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "Os": {"const": "linux"},
            "Architecture": {"const": "amd64"}
          }
        },
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "mounts": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [{
            "type": "object", "additionalProperties": false,
            "required": ["source", "destination", "read_only"],
            "properties": {
              "source": {"type": "string", "pattern": "^/"},
              "destination": {"const": "/workspace/capture"},
              "read_only": {"const": false}
            }
          }, {
            "type": "object", "additionalProperties": false,
            "required": ["source", "destination", "read_only"],
            "properties": {
              "source": {"type": "string", "pattern": "^/"},
              "destination": {"const": "/opt/apt_closure_capture.py"},
              "read_only": {"const": true}
            }
          }, {
            "type": "object", "additionalProperties": false,
            "required": ["source", "destination", "read_only"],
            "properties": {
              "source": {"type": "string", "pattern": "^/"},
              "destination": {"const": "/opt/package-allowlist.json"},
              "read_only": {"const": true}
            }
          }],
          "items": false
        },
        "network_mode": {"const": "bridge"},
        "phase_trace": {"type": "array", "minItems": 4, "maxItems": 4},
        "network_used": {"const": true}
      }
    },
    "packageKey": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "architecture"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      }
    },
    "allowlist": {
      "type": "object", "additionalProperties": false,
      "required": ["build", "runtime", "union", "canonical_sha256"],
      "properties": {
        "build": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/packageKey"}},
        "runtime": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/packageKey"}},
        "union": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/packageKey"}},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "license": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "identity", "sha256", "bytes", "artifact_path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "identity": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "artifact_path": {"type": "string", "minLength": 1}
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "architecture", "status", "filename", "url", "sha256", "bytes", "artifact_path", "license"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "status": {"const": "install ok installed"},
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9_.+~-]+\\.deb$"},
        "url": {"pattern": "^https://"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "license": {"$ref": "#/$defs/license"}
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "release_or_inrelease_url", "release_or_inrelease_sha256", "release_or_inrelease_bytes"],
      "properties": {
        "url": {"pattern": "^https://"},
        "release_or_inrelease_url": {"pattern": "^https://"},
        "release_or_inrelease_sha256": {"$ref": "#/$defs/sha256"},
        "release_or_inrelease_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "refRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "artifact_path", "sha256", "bytes"],
      "properties": {
        "url": {"pattern": "^https://"},
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "cacheRecord": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_path", "sha256", "bytes"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"enum": ["apt_source", "apt_release", "rosdep_source", "rosdep_cache", "deb", "license"]},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "source_url": {"pattern": "^https://"}
      }
    }
  }
}
