"""Run one installed benchmark/evidence module without repository paths."""

from __future__ import annotations

import argparse
import runpy
import sys

from lidarslam_benchmark_tools import require_installed_surface


def main() -> int:
    """Dispatch ``<module>`` through the installed package surface."""
    parser = argparse.ArgumentParser(
        description='run a lidarslam_benchmark_tools module from the install')
    parser.add_argument(
        "module",
        help='module basename, for example evaluate_competitive_suite_gate')
    parser.add_argument("arguments", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    module = args.module
    if not module.replace('_', '').isalnum() or module.startswith('_'):
        parser.error('module must be a simple installed module basename')
    require_installed_surface()
    sys.argv = [f"lidarslam_benchmark_tools.{module}", *args.arguments]
    runpy.run_module(f"lidarslam_benchmark_tools.{module}", run_name="__main__")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
