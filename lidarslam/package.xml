<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidarslam</name>
  <version>0.9.1</version>
  <description>lidarslam_ros2 integration package</description>
  <maintainer email="rsasaki0109@gmail.com">sasaki</maintainer>
  <license>BSD-2-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>scanmatcher</depend>
  <depend>graph_based_slam</depend>
  <depend>lidarslam_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>std_srvs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend version_gte="0.3.2">rko_lio</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>time</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-jsonschema</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
