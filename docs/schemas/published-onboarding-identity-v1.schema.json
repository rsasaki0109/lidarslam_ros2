{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/published-onboarding-identity-v1.schema.json",
  "title": "Published onboarding identity preflight v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "repository",
    "network_requested",
    "writes_performed",
    "expected",
    "observed",
    "checks",
    "finding_codes",
    "detail"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_uri": {
      "const": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/published-onboarding-identity-v1.schema.json"
    },
    "status": {"enum": ["READY", "NOT_READY", "BLOCKED"]},
    "repository": {"const": "rsasaki0109/lidar_slam_ros2"},
    "network_requested": {"const": true},
    "writes_performed": {"const": false},
    "expected": {"$ref": "#/definitions/identity"},
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_status", "source_commit", "docker_digests"],
      "properties": {
        "release_status": {
          "type": ["string", "null"],
          "enum": ["NOT_PUBLISHED", "IN_PROGRESS", "PUBLISHED", "BLOCKED", null]
        },
        "source_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "docker_digests": {"$ref": "#/definitions/nullableDigests"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_published",
        "release_image_contract_valid",
        "source_commit_matches",
        "humble_digest_matches",
        "jazzy_digest_matches"
      ],
      "properties": {
        "release_published": {"type": "boolean"},
        "release_image_contract_valid": {"type": "boolean"},
        "source_commit_matches": {"type": "boolean"},
        "humble_digest_matches": {"type": "boolean"},
        "jazzy_digest_matches": {"type": "boolean"}
      }
    },
    "finding_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "release-audit-blocked",
          "release-not-published",
          "release-image-contract-invalid",
          "source-commit-mismatch",
          "humble-digest-mismatch",
          "jazzy-digest-mismatch"
        ]
      }
    },
    "detail": {"type": "string", "minLength": 1, "maxLength": 1024}
  },
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humble", "jazzy"],
      "properties": {
        "humble": {"$ref": "#/definitions/digest"},
        "jazzy": {"$ref": "#/definitions/digest"}
      }
    },
    "nullableDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humble", "jazzy"],
      "properties": {
        "humble": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "jazzy": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_version", "source_commit", "docker_digests"],
      "properties": {
        "product_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "docker_digests": {"$ref": "#/definitions/digests"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "READY"}}},
      "then": {
        "properties": {
          "checks": {
            "properties": {
              "release_published": {"const": true},
              "release_image_contract_valid": {"const": true},
              "source_commit_matches": {"const": true},
              "humble_digest_matches": {"const": true},
              "jazzy_digest_matches": {"const": true}
            }
          },
          "finding_codes": {"maxItems": 0}
        }
      }
    }
  ]
}
