{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/onboarding-matrix-observer-packet-v2.schema.json",
  "title": "lidarslam_ros2 G0 onboarding observer packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "packet_id",
    "repository",
    "product_version",
    "dataset_id",
    "status",
    "docker_identity_mode",
    "docker_evidence",
    "public_checks",
    "rows",
    "next_actions",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "schema_uri": {
      "const": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/onboarding-matrix-observer-packet-v2.schema.json"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^g0-onboarding-[A-Za-z0-9.+-]+-(?:release|candidate-[1-9][0-9]*)$"
    },
    "repository": {"const": "rsasaki0109/lidar_slam_ros2"},
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "dataset_id": {"const": "mid360-public-zenodo-14841855"},
    "status": {"const": "READY_FOR_READ_ONLY_PREFLIGHT"},
    "docker_identity_mode": {"enum": ["release", "candidate-image-set"]},
    "docker_evidence": {"$ref": "#/definitions/dockerEvidence"},
    "public_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker", "source"],
      "properties": {
        "docker": {"$ref": "#/definitions/publicCheck"},
        "source": {"$ref": "#/definitions/publicCheck"}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/definitions/row"}
    },
    "next_actions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_reads_performed",
        "trial_executed",
        "github_writes_authorized",
        "community_posts_authorized",
        "remote_mutations_performed"
      ],
      "properties": {
        "network_reads_performed": {"const": false},
        "trial_executed": {"const": false},
        "github_writes_authorized": {"const": false},
        "community_posts_authorized": {"const": false},
        "remote_mutations_performed": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"docker_identity_mode": {"const": "release"}}
      },
      "then": {
        "properties": {
          "docker_evidence": {
            "properties": {"mode": {"const": "release"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "docker_identity_mode": {"const": "candidate-image-set"}
        }
      },
      "then": {
        "properties": {
          "docker_evidence": {
            "properties": {"mode": {"const": "candidate-image-set"}}
          }
        }
      }
    }
  ],
  "definitions": {
    "publicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "required_status", "read_only"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "required_status": {
          "enum": ["PUBLISHED", "REMOTE_AUDIT_PASS", "READY"]
        },
        "read_only": {"const": true}
      }
    },
    "dockerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "candidate_set_sha256",
        "source_pr",
        "source_commit",
        "workflow_run_url",
        "requested_by",
        "registry_retention_status",
        "evidence_retention_days"
      ],
      "properties": {
        "mode": {"enum": ["release", "candidate-image-set"]},
        "candidate_set_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_pr": {"type": ["integer", "null"], "minimum": 1},
        "source_commit": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "workflow_run_url": {
          "type": ["string", "null"],
          "pattern": "^https://github\\.com/rsasaki0109/lidar_slam_ros2/actions/runs/[1-9][0-9]*$"
        },
        "requested_by": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
        },
        "registry_retention_status": {
          "enum": ["NOT_APPLICABLE", "REQUIRES_REMOTE_AUDIT"]
        },
        "evidence_retention_days": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 90
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "release"}}},
          "then": {
            "properties": {
              "candidate_set_sha256": {"const": null},
              "source_pr": {"const": null},
              "source_commit": {"const": null},
              "workflow_run_url": {"const": null},
              "requested_by": {"const": null},
              "registry_retention_status": {"const": "NOT_APPLICABLE"},
              "evidence_retention_days": {"const": null}
            }
          }
        },
        {
          "if": {
            "properties": {"mode": {"const": "candidate-image-set"}}
          },
          "then": {
            "properties": {
              "candidate_set_sha256": {"type": "string"},
              "source_pr": {"type": "integer"},
              "source_commit": {"type": "string"},
              "workflow_run_url": {"type": "string"},
              "requested_by": {"type": "string"},
              "registry_retention_status": {
                "const": "REQUIRES_REMOTE_AUDIT"
              },
              "evidence_retention_days": {"type": "integer"}
            }
          }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "route",
        "ros_distro",
        "os_family",
        "product_version",
        "identity",
        "preflight_command",
        "observer_command",
        "required_measurements"
      ],
      "properties": {
        "row_id": {
          "enum": [
            "docker-humble",
            "docker-jazzy",
            "source-humble",
            "source-jazzy"
          ]
        },
        "route": {"enum": ["docker", "source"]},
        "ros_distro": {"enum": ["humble", "jazzy"]},
        "os_family": {"enum": ["ubuntu-22.04", "ubuntu-24.04"]},
        "product_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "tag", "immutable_ref"],
          "properties": {
            "kind": {"enum": ["git-commit", "image-digest"]},
            "value": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
            },
            "tag": {"type": ["string", "null"]},
            "immutable_ref": {"type": ["string", "null"]}
          }
        },
        "preflight_command": {"type": "string", "minLength": 1},
        "observer_command": {"type": "string", "minLength": 1},
        "required_measurements": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input.download_bytes",
              "measurements.workflow_download_bytes",
              "measurements.wall_time_sec",
              "measurements.active_operator_time_sec",
              "measurements.command_count",
              "measurements.peak_disk_bytes",
              "measurements.output_bytes"
            ]
          }
        }
      }
    }
  }
}
