{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/candidate-image-request-v1.schema.json",
  "title": "lidarslam_ros2 immutable candidate-image request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "publication_mode",
    "repository",
    "event_name",
    "event_action",
    "default_branch",
    "workflow_branch_ref",
    "workflow_gate_commit",
    "source_pr",
    "source_commit",
    "product_version",
    "requested_by",
    "actor_role",
    "required_success_checks",
    "observed_successful_checks",
    "observed_skipped_checks",
    "environment",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_uri": {
      "const": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/candidate-image-request-v1.schema.json"
    },
    "status": {"const": "AUTHORIZED"},
    "publication_mode": {"const": "digest_only"},
    "repository": {"const": "rsasaki0109/lidar_slam_ros2"},
    "event_name": {"const": "repository_dispatch"},
    "event_action": {"const": "e2-publish-candidate-image"},
    "default_branch": {"const": "develop"},
    "workflow_branch_ref": {"const": "refs/heads/develop"},
    "workflow_gate_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_pr": {"type": "integer", "minimum": 1},
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "requested_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
    },
    "actor_role": {"enum": ["admin", "maintain"]},
    "required_success_checks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "observed_successful_checks": {
      "type": "array",
      "minItems": 9,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "observed_skipped_checks": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "required_reviewer_count",
        "prevent_self_review",
        "deployment_branch_policy"
      ],
      "properties": {
        "name": {"const": "candidate-images"},
        "required_reviewer_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "prevent_self_review": {"const": true},
        "deployment_branch_policy": {"const": "develop_only"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_write_authorized_for_digest_job",
        "tag_creation_authorized",
        "moving_tag_mutation_authorized",
        "release_mutation_authorized"
      ],
      "properties": {
        "package_write_authorized_for_digest_job": {"const": true},
        "tag_creation_authorized": {"const": false},
        "moving_tag_mutation_authorized": {"const": false},
        "release_mutation_authorized": {"const": false}
      }
    }
  }
}
