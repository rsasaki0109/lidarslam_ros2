{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/onboarding-matrix-observer-packet-v1.schema.json",
  "title": "lidarslam_ros2 G0 onboarding observer packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "packet_id",
    "repository",
    "product_version",
    "dataset_id",
    "status",
    "public_checks",
    "rows",
    "next_actions",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_uri": {
      "const": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/onboarding-matrix-observer-packet-v1.schema.json"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^g0-onboarding-[A-Za-z0-9.+-]+$"
    },
    "repository": {"const": "rsasaki0109/lidar_slam_ros2"},
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "dataset_id": {"const": "mid360-public-zenodo-14841855"},
    "status": {"const": "READY_FOR_READ_ONLY_PREFLIGHT"},
    "public_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "source"],
      "properties": {
        "release": {"$ref": "#/definitions/publicCheck"},
        "source": {"$ref": "#/definitions/publicCheck"}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/definitions/row"}
    },
    "next_actions": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_reads_performed",
        "trial_executed",
        "github_writes_authorized",
        "community_posts_authorized",
        "remote_mutations_performed"
      ],
      "properties": {
        "network_reads_performed": {"const": false},
        "trial_executed": {"const": false},
        "github_writes_authorized": {"const": false},
        "community_posts_authorized": {"const": false},
        "remote_mutations_performed": {"const": false}
      }
    }
  },
  "definitions": {
    "publicCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "required_status", "read_only"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "required_status": {"enum": ["PUBLISHED", "READY"]},
        "read_only": {"const": true}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "route",
        "ros_distro",
        "os_family",
        "product_version",
        "identity",
        "preflight_command",
        "observer_command",
        "required_measurements"
      ],
      "properties": {
        "row_id": {
          "enum": [
            "docker-humble",
            "docker-jazzy",
            "source-humble",
            "source-jazzy"
          ]
        },
        "route": {"enum": ["docker", "source"]},
        "ros_distro": {"enum": ["humble", "jazzy"]},
        "os_family": {"enum": ["ubuntu-22.04", "ubuntu-24.04"]},
        "product_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "tag"],
          "properties": {
            "kind": {"enum": ["git-commit", "image-digest"]},
            "value": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"
            },
            "tag": {"type": ["string", "null"]}
          }
        },
        "preflight_command": {"type": "string", "minLength": 1},
        "observer_command": {"type": "string", "minLength": 1},
        "required_measurements": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input.download_bytes",
              "measurements.workflow_download_bytes",
              "measurements.wall_time_sec",
              "measurements.active_operator_time_sec",
              "measurements.command_count",
              "measurements.peak_disk_bytes",
              "measurements.output_bytes"
            ]
          }
        }
      }
    }
  }
}
