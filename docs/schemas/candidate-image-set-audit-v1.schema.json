{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/candidate-image-set-audit-v1.schema.json",
  "title": "lidarslam_ros2 candidate-image set audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "schema_uri",
    "status",
    "candidate_set_sha256",
    "repository",
    "source_pr",
    "source_commit",
    "product_version",
    "workflow_run_url",
    "workflow_branch_ref",
    "requested_by",
    "workflow",
    "artifacts",
    "images",
    "findings",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "schema_uri": {
      "const": "https://rsasaki0109.github.io/lidar_slam_ros2/schemas/candidate-image-set-audit-v1.schema.json"
    },
    "status": {
      "enum": [
        "LOCAL_CONTRACT_PASS",
        "REMOTE_AUDIT_PASS",
        "REMOTE_AUDIT_FAIL"
      ]
    },
    "candidate_set_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository": {"const": "rsasaki0109/lidar_slam_ros2"},
    "source_pr": {"type": "integer", "minimum": 1},
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "product_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "workflow_run_url": {
      "type": "string",
      "pattern": "^https://github\\.com/rsasaki0109/lidar_slam_ros2/actions/runs/[1-9][0-9]*$"
    },
    "workflow_branch_ref": {"const": "refs/heads/develop"},
    "requested_by": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "run_id",
        "event",
        "conclusion",
        "head_branch",
        "path"
      ],
      "properties": {
        "status": {"enum": ["NOT_CHECKED", "PASS", "FAIL"]},
        "run_id": {"type": "integer", "minimum": 1},
        "event": {"type": ["string", "null"]},
        "conclusion": {"type": ["string", "null"]},
        "head_branch": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_names", "expires_at"],
      "properties": {
        "status": {"enum": ["NOT_CHECKED", "PASS", "FAIL"]},
        "required_names": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "candidate-image-request",
              "candidate-image-record-humble",
              "candidate-image-record-jazzy",
              "candidate-image-set"
            ]
          }
        },
        "expires_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "images": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ros_distro",
          "digest",
          "immutable_ref",
          "registry_status",
          "attestation_status"
        ],
        "properties": {
          "ros_distro": {"enum": ["humble", "jazzy"]},
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "immutable_ref": {
            "type": "string",
            "pattern": "^ghcr\\.io/rsasaki0109/lidar_slam_ros2@sha256:[0-9a-f]{64}$"
          },
          "registry_status": {"enum": ["NOT_CHECKED", "PASS", "FAIL"]},
          "attestation_status": {"enum": ["NOT_CHECKED", "PASS", "FAIL"]}
        }
      }
    },
    "findings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_reads_performed",
        "github_writes_authorized",
        "registry_writes_authorized",
        "remote_mutations_performed"
      ],
      "properties": {
        "network_reads_performed": {"type": "boolean"},
        "github_writes_authorized": {"const": false},
        "registry_writes_authorized": {"const": false},
        "remote_mutations_performed": {"const": false}
      }
    }
  }
}
