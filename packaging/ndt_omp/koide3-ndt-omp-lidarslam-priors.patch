+//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+template<typename PointSource, typename PointTarget> void
+pclomp::NormalDistributionsTransform<PointSource, PointTarget>::applyRegularizationPriors(
+	const Eigen::Matrix<double, 6, 1> &p,
+	double &score,
+	Eigen::Matrix<double, 6, 1> &score_gradient,
+	Eigen::Matrix<double, 6, 6> &hessian,
+	bool compute_hessian) const
+{
+	if (has_rotation_prior_)
+	{
+		const int end_idx = rotation_prior_roll_pitch_only_ ? 5 : 6;
+		const double two_pi = 6.28318530717958647692;
+		for (int i = 3; i < end_idx; ++i)
+		{
+			const double diff = std::remainder(p(i) - rotation_prior_rpy_(i - 3), two_pi);
+			score -= rotation_prior_weight_ * diff * diff;
+			score_gradient(i) -= 2.0 * rotation_prior_weight_ * diff;
+			if (compute_hessian)
+				hessian(i, i) -= 2.0 * rotation_prior_weight_;
+		}
+	}
+
+	if (has_translation_prior_)
+	{
+		for (int i = 0; i < 3; ++i)
+		{
+			const double weight = translation_prior_weights_(i);
+			if (weight == 0.0)
+				continue;
+			const double diff = p(i) - translation_prior_xyz_(i);
+			score -= weight * diff * diff;
+			score_gradient(i) -= 2.0 * weight * diff;
+			if (compute_hessian)
+				hessian(i, i) -= 2.0 * weight;
+		}
+	}
+}
