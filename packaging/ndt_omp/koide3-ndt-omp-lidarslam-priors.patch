+#include <gtest/gtest.h>
+
+#include <pcl/point_cloud.h>
+#include <pcl/point_types.h>
+#include <pclomp/ndt_omp.h>
+
+#include <cmath>
+#include <limits>
+
+namespace
+{
+using Ndt = pclomp::NormalDistributionsTransform<pcl::PointXYZ, pcl::PointXYZ>;
+using Vector6d = Eigen::Matrix<double, 6, 1>;
+using Matrix6d = Eigen::Matrix<double, 6, 6>;
+
+class TestableNdt : public Ndt
+{
+public:
+	double applyPriors(const Vector6d &p, Vector6d &gradient, Matrix6d &hessian,
+		bool compute_hessian = true) const
+	{
+		double score = 0.0;
+		gradient.setZero();
+		hessian.setZero();
+		applyRegularizationPriors(p, score, gradient, hessian, compute_hessian);
+		return score;
+	}
+};
+
+TEST(NdtRegularization, AppliesRotationPriorToSelectedAxes)
+{
+	TestableNdt ndt;
+	ndt.setRotationPrior(Eigen::Vector3d::Zero(), 2.0, true);
+
+	Vector6d p = Vector6d::Zero();
+	p(3) = 0.5;
+	p(4) = -0.25;
+	p(5) = 1.0;
+	Vector6d gradient;
+	Matrix6d hessian;
+
+	EXPECT_DOUBLE_EQ(ndt.applyPriors(p, gradient, hessian), -0.625);
+	EXPECT_DOUBLE_EQ(gradient(3), -2.0);
+	EXPECT_DOUBLE_EQ(gradient(4), 1.0);
+	EXPECT_DOUBLE_EQ(gradient(5), 0.0);
+	EXPECT_DOUBLE_EQ(hessian(3, 3), -4.0);
+	EXPECT_DOUBLE_EQ(hessian(4, 4), -4.0);
+	EXPECT_DOUBLE_EQ(hessian(5, 5), 0.0);
+}
+
+TEST(NdtRegularization, AppliesPerAxisTranslationPrior)
+{
+	TestableNdt ndt;
+	ndt.setTranslationPrior(Eigen::Vector3d(1.0, 2.0, 3.0), Eigen::Vector3d(1.0, 0.0, 3.0));
+
+	Vector6d p = Vector6d::Zero();
+	p.head<3>() << 2.0, 100.0, 1.0;
+	Vector6d gradient;
+	Matrix6d hessian;
+
+	EXPECT_DOUBLE_EQ(ndt.applyPriors(p, gradient, hessian), -13.0);
+	EXPECT_DOUBLE_EQ(gradient(0), -2.0);
+	EXPECT_DOUBLE_EQ(gradient(1), 0.0);
+	EXPECT_DOUBLE_EQ(gradient(2), 12.0);
+	EXPECT_DOUBLE_EQ(hessian(0, 0), -2.0);
+	EXPECT_DOUBLE_EQ(hessian(1, 1), 0.0);
+	EXPECT_DOUBLE_EQ(hessian(2, 2), -6.0);
+}
+
+TEST(NdtRegularization, InvalidConfigurationDisablesOptionalTerms)
+{
+	TestableNdt ndt;
+	ndt.setRotationPrior(Eigen::Vector3d::Zero(), std::numeric_limits<double>::quiet_NaN());
+	ndt.setTranslationPrior(Eigen::Vector3d::Zero(), Eigen::Vector3d(0.0, -1.0, 2.0));
+	ndt.setMaxCorrespondenceDistance(std::numeric_limits<double>::infinity());
+
+	Vector6d p = Vector6d::Ones();
+	Vector6d gradient;
+	Matrix6d hessian;
+	EXPECT_DOUBLE_EQ(ndt.applyPriors(p, gradient, hessian), 0.0);
+	EXPECT_TRUE(gradient.isZero());
+	EXPECT_TRUE(hessian.isZero());
+	EXPECT_DOUBLE_EQ(ndt.getMaxCorrespondenceDistance(), 0.0);
+}
+
+pcl::PointCloud<pcl::PointXYZ>::Ptr makeCubeCloud()
+{
+	auto cloud = pcl::PointCloud<pcl::PointXYZ>::Ptr(new pcl::PointCloud<pcl::PointXYZ>());
+	for (int x = -1; x <= 1; ++x)
+		for (int y = -1; y <= 1; ++y)
+			for (int z = -1; z <= 1; ++z)
+				cloud->push_back(pcl::PointXYZ(
+					2.5f + 0.1f * x, 2.5f + 0.1f * y, 2.5f + 0.1f * z));
+	return cloud;
+}
+
+TEST(NdtCorrespondences, FiltersByVoxelMeanDistanceAndReportsStatistics)
+{
+	const auto cloud = makeCubeCloud();
+	Ndt ndt;
+	ndt.setResolution(1.0f);
+	ndt.setNeighborhoodSearchMethod(pclomp::DIRECT1);
+	ndt.setMaximumIterations(1);
+	ndt.setInputTarget(cloud);
+	ndt.setInputSource(cloud);
+	pcl::PointCloud<pcl::PointXYZ> output;
+
+	ndt.align(output);
+	const std::size_t unfiltered_count = ndt.getLastCorrespondenceCount();
+	EXPECT_GT(unfiltered_count, 0u);
+	EXPECT_GT(ndt.getLastMeanCorrespondenceDistance(), 0.0);
+
+	ndt.setMaxCorrespondenceDistance(0.01);
+	ndt.align(output);
+	EXPECT_LT(ndt.getLastCorrespondenceCount(), unfiltered_count);
+	EXPECT_LE(ndt.getLastMeanCorrespondenceDistance(), 0.01);
+}
+}  // namespace
