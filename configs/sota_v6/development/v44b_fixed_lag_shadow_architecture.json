    "minimum_correspondences": 128,
    "maximum_correspondence_distance_m": 1.0,
    "source_selection": "most_recent_older_active_knots_then_timestamp_order",
    "voxel_representative": "lowest_point_timestamp_then_ring_then_source_index",
    "surfel_storage_frame": "source_knot_body_frame_at_scan_end",
    "deskew_target": "current_scan_end_body_frame",
    "deskew_equation": "p_B_at_end = T_WB(t_end)^-1 * T_WB(t_point) * T_BL * p_L",
    "residual": "r_l = n_B_s^T * R_WB_s^T * ((R_WB_k * p_B_k + p_WB_k) - (R_WB_s * mu_B_s + p_WB_s))",
    "connected_variables": [
      "current_R_WB_p_WB",
      "source_R_WB_p_WB"
    ],
    "loss": "Huber_on_whitened_residual",
    "factor_lifetime": "only_while_current_and_source_knots_are_active",
    "global_or_persistent_map_allowed": false,
    "loop_candidate_search_allowed": false,
    "failed_correspondence_policy": "omit_lidar_factor_and_retain_inertial_uncertainty"
  },
  "observability": {
    "policy": "project_each_whitened_lidar_factor_onto_its_numerically_observable_pose_subspace",
