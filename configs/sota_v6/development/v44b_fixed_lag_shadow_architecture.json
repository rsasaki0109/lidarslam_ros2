    "lidar_to_body_policy": "exact_source_binding_fixed_not_estimated",
    "gravity_after_bootstrap_m_s2": [0.0, 0.0, -9.80665],
    "rotation_storage": "unit_quaternion_hamilton_xyzw",
    "rotation_increment": "right_multiplicative_SO3",
    "point_transform_equation": "p_W = R_WB * (R_BL * p_L + t_BL) + p_WB"
  },
  "timing": {
    "clock_representation": "signed_int64_nanoseconds",
    "lidar_header_semantics": "scan_start",
    "point_timestamp_equation": "t_point_ns = lidar_header_stamp_ns + uint32_t_ns",
    "state_timestamp_equation": "t_k_ns = lidar_header_stamp_ns + maximum_uint32_t_ns_in_scan",
