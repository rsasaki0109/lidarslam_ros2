      "finite_cost",
      "gravity_magnitude_exact",
      "nonempty_lidar_observable_subspace",
      "positive_semidefinite_preintegration_covariance"
    ],
    "post_bootstrap_rebase": "rotate_world_deterministically_so_gravity_is_negative_z_and_first_yaw_is_zero"
  },
  "noise_model": {
    "policy": "one_explicit_continuous_time_model_for_all_sources",
    "message_covariance_policy": "inventory_only_ignored_by_estimator",
    "gyroscope_white_noise_density_rad_s_sqrt_hz": 0.01,
    "accelerometer_white_noise_density_m_s2_sqrt_hz": 1.0,
    "gyroscope_bias_random_walk_density_rad_s2_sqrt_hz": 0.0001,
    "accelerometer_bias_random_walk_density_m_s3_sqrt_hz": 0.0001,
