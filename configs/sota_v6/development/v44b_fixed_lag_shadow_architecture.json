    "lidar_huber_delta_sigma": 1.345,
    "covariance_symmetrization": "0.5_times_P_plus_P_transpose",
    "covariance_negative_eigenvalue_tolerance": 1e-12,
    "covariance_eigenvalue_floor": 1e-12
  },
  "preintegration": {
    "method": "bias_linearized_midpoint_Forster_SO3",
    "preintegrated_terms": [
      "DeltaR_ij",
      "DeltaV_ij",
      "DeltaP_ij",
      "covariance_9x9"
    ],
    "required_bias_jacobians": [
      "J_R_bg",
      "J_v_bg",
      "J_v_ba",
      "J_p_bg",
      "J_p_ba"
    ],
    "rotation_residual": "r_R = Log((DeltaR_ij * Exp(J_R_bg * delta_bg_i))^-1 * R_WB_i^T * R_WB_j)",
    "velocity_residual": "r_v = R_WB_i^T * (v_WB_j - v_WB_i - g_W * dt) - (DeltaV_ij + J_v_bg * delta_bg_i + J_v_ba * delta_ba_i)",
    "position_residual": "r_p = R_WB_i^T * (p_WB_j - p_WB_i - v_WB_i * dt - 0.5 * g_W * dt^2) - (DeltaP_ij + J_p_bg * delta_bg_i + J_p_ba * delta_ba_i)",
    "gyro_bias_random_walk_residual": "r_bg = b_g_j - b_g_i",
    "accel_bias_random_walk_residual": "r_ba = b_a_j - b_a_i",
    "imu_residual_dimension": 9,
    "bias_random_walk_residual_dimension": 6,
    "bias_relinearization": "first_order_jacobian_correction_then_reintegrate_when_threshold_crossed",
    "bias_reintegration_threshold": {
      "gyro_rad_s": 0.01,
      "accel_m_s2": 0.1
    },
    "covariance_propagation_precision": "float64",
    "integration_interval": "previous_scan_end_exclusive_to_current_scan_end_inclusive",
    "maximum_single_step_ns": 50000000,
    "gap_violation_policy": "terminal_fail_closed_without_state_output"
  },
  "lidar_factor": {
    "type": "causal_active_window_binary_point_to_plane",
    "intensity_used": false,
    "minimum_range_m": 1.0,
    "maximum_range_m": 50.0,
    "voxel_size_m": 0.5,
