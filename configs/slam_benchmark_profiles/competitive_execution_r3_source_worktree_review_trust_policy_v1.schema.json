{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "competitive_execution_r3_source_worktree_review_trust_policy_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "status", "benchmark_eligible",
    "campaign_id", "candidate_binding", "profile_binding",
    "source_manifest_identity_sha256", "response_schema_binding",
    "source_schema_bindings", "verifier", "authorized_keys",
    "nonce_policy", "policy_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "competitive_execution_r3_source_worktree_review_trust_policy_v1"},
    "schema_version": {"const": 1},
    "status": {"enum": ["NOT_READY", "READY"]},
    "benchmark_eligible": {"const": false},
    "campaign_id": {"const": "competitive-execution-selection-2026-08-r3-candidate"},
    "candidate_binding": {"$ref": "#/$defs/candidate"},
    "profile_binding": {"$ref": "#/$defs/profile"},
    "source_manifest_identity_sha256": {"$ref": "#/$defs/sha"},
    "response_schema_binding": {"$ref": "#/$defs/schemaRef"},
    "source_schema_bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["wrapper", "strict", "sidecar"],
      "properties": {
        "wrapper": {"$ref": "#/$defs/fileRef"},
        "strict": {"$ref": "#/$defs/fileRef"},
        "sidecar": {"$ref": "#/$defs/fileRef"}
      }
    },
    "verifier": {"$ref": "#/$defs/verifier"},
    "authorized_keys": {
      "type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/key"}
    },
    "nonce_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_length", "maximum_length", "one_shot_ledger_required"],
      "properties": {
        "minimum_length": {"const": 32},
        "maximum_length": {"const": 128},
        "one_shot_ledger_required": {"const": true}
      }
    },
    "policy_identity_sha256": {"$ref": "#/$defs/sha"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "READY"}}},
    "then": {"properties": {"authorized_keys": {"minItems": 1}}}
  }],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "candidate_identity_sha256", "candidate_id", "status"],
      "properties": {
        "path": {"const": "configs/slam_benchmark_profiles/competitive_execution_selection_2026-08-r3-candidate.json"},
        "file_sha256": {"$ref": "#/$defs/sha"},
        "candidate_identity_sha256": {"$ref": "#/$defs/sha"},
        "candidate_id": {"const": "competitive-execution-selection-2026-08-r3-candidate"},
        "status": {"const": "NOT_READY"}
      }
    },
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "canonical_sha256", "canonical_hash_kind"],
      "properties": {
        "path": {"const": "configs/slam_benchmark_profiles/competitive_slam_v1.yaml"},
        "file_sha256": {"$ref": "#/$defs/sha"},
        "canonical_sha256": {"$ref": "#/$defs/sha"},
        "canonical_hash_kind": {"const": "canonical_profile_sha256_v1"}
      }
    },
    "schemaRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "schema"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha"},
        "schema": {"const": "competitive_execution_r3_source_worktree_review_response_v1"}
      }
    },
    "backend": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "implementation", "implementation_file", "implementation_sha256"],
      "properties": {
        "name": {"const": "python-cryptography"},
        "version": {"type": "string", "minLength": 1},
        "implementation": {"const": "cryptography.hazmat.primitives.asymmetric.ed25519.Ed25519PublicKey.verify"},
        "implementation_file": {"const": "scripts/validate_competitive_execution_r3_source_worktree_review.py"},
        "implementation_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "verifier": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "file_sha256", "implementation", "backend"],
      "properties": {
        "path": {"const": "scripts/validate_competitive_execution_r3_source_worktree_review.py"},
        "file_sha256": {"$ref": "#/$defs/sha"},
        "implementation": {"const": "competitive_execution_r3_source_worktree_review_v1"},
        "backend": {"$ref": "#/$defs/backend"}
      }
    },
    "key": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "algorithm", "status", "public_key_base64", "public_key_sha256", "not_before", "not_after"],
      "properties": {
        "key_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "algorithm": {"const": "Ed25519"},
        "status": {"const": "ACTIVE"},
        "public_key_base64": {"type": "string", "minLength": 40},
        "public_key_sha256": {"$ref": "#/$defs/sha"},
        "not_before": {"type": "integer", "minimum": 0},
        "not_after": {"type": "integer", "minimum": 1}
      }
    }
  }
}
