{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidarslam.example.invalid/schema/registration-plugin-release-campaign-v1.json",
  "title": "Registration-plugin release campaign v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "benchmark_eligible",
    "execution_started", "campaign_id", "campaign_set", "profile",
    "source_manifest", "git", "campaign_root", "evidence_storage", "rows",
    "runtime_probes", "partial_rows", "partial_row_count", "summary", "safety",
    "started_at_unix", "ended_at_unix",
    "canonical_sha256"],
  "properties": {
    "schema": {"const": "registration-plugin-release-campaign-v1"},
    "schema_version": {"const": 1},
    "status": {"enum": ["PREFLIGHT_PASS", "PREFLIGHT_NOT_RUNTIME_VALIDATED",
      "PASS", "PARTIAL_FAILURE", "FAIL_CLOSED"]},
    "benchmark_eligible": {"const": false},
    "execution_started": {"type": "boolean"},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "campaign_set": {"$ref": "#/$defs/campaign_set"},
    "profile": {"$ref": "#/$defs/identity"},
    "source_manifest": {"$ref": "#/$defs/source_manifest"},
    "git": {"$ref": "#/$defs/git"},
    "campaign_root": {"$ref": "#/$defs/campaign_root"},
    "evidence_storage": {"$ref": "#/$defs/evidence_storage"},
    "runtime_probes": {"$ref": "#/$defs/runtime_probes"},
    "rows": {"type": "array"},
    "partial_rows": {"$ref": "#/$defs/partial_rows"},
    "partial_row_count": {"type": "integer", "minimum": 0, "maximum": 4},
    "summary": {"type": "object"},
    "failure": {"$ref": "#/$defs/failure"},
    "execution": {"$ref": "#/$defs/execution"},
    "safety": {"$ref": "#/$defs/safety"},
    "started_at_unix": {"type": "number", "minimum": 0},
    "ended_at_unix": {"type": "number", "minimum": 0},
    "observed_at_unix": {"type": "number", "minimum": 0},
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"enum": [
      "PREFLIGHT_PASS", "PREFLIGHT_NOT_RUNTIME_VALIDATED"]}}},
    "then": {
      "properties": {
        "execution_started": {"const": false},
        "rows": {"$ref": "#/$defs/preflight_rows"},
        "partial_rows": {"maxItems": 0},
        "partial_row_count": {"const": 0},
        "summary": {"$ref": "#/$defs/preflight_summary"},
        "safety": {"$ref": "#/$defs/safety"}
      },
      "not": {"anyOf": [{"required": ["failure"]},
        {"required": ["execution"]}]}
    },
    "else": {
      "required": ["failure", "execution"],
      "properties": {
        "execution_started": {"const": true},
        "rows": {"$ref": "#/$defs/runtime_rows"},
        "partial_rows": {"$ref": "#/$defs/partial_rows"},
        "partial_row_count": {"type": "integer", "minimum": 0, "maximum": 4},
        "summary": {"$ref": "#/$defs/runtime_summary"},
        "safety": {"$ref": "#/$defs/safety"}
      }
    }
  }, {
    "if": {"properties": {"status": {"enum": [
      "PREFLIGHT_PASS", "PREFLIGHT_NOT_RUNTIME_VALIDATED"]}}},
    "then": {},
    "else": {
      "if": {"properties": {"status": {"const": "PASS"}}},
      "then": {
        "properties": {
          "failure": {"type": "null"},
          "summary": {"$ref": "#/$defs/runtime_pass_summary"},
          "rows": {"$ref": "#/$defs/runtime_pass_rows"}
        }
      },
      "else": {
        "properties": {
          "failure": {"$ref": "#/$defs/failure_object"},
          "summary": {"$ref": "#/$defs/runtime_failure_summary"},
          "rows": {"$ref": "#/$defs/runtime_nonpass_rows"}
        },
        "required": ["failure"]
      }
    }
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "campaign_set": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "campaign_id", "rows",
        "row_set_sha256", "identity_sha256"],
      "properties": {
        "schema": {"const": "registration-plugin-campaign-set-v1"},
        "schema_version": {"const": 1},
        "campaign_id": {"type": "string", "minLength": 8},
        "rows": {"type": "array", "prefixItems": [
          {"$ref": "#/$defs/row_humble_absent"},
          {"$ref": "#/$defs/row_humble_present"},
          {"$ref": "#/$defs/row_jazzy_absent"},
          {"$ref": "#/$defs/row_jazzy_present"}
        ], "items": false},
        "row_set_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "row_humble_absent": {"type": "object", "additionalProperties": false,
      "required": ["distro", "dependency_leg"],
      "properties": {"distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}},
    "row_humble_present": {"type": "object", "additionalProperties": false,
      "required": ["distro", "dependency_leg"],
      "properties": {"distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}},
    "row_jazzy_absent": {"type": "object", "additionalProperties": false,
      "required": ["distro", "dependency_leg"],
      "properties": {"distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}},
    "row_jazzy_present": {"type": "object", "additionalProperties": false,
      "required": ["distro", "dependency_leg"],
      "properties": {"distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}},
    "source_manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "hash_kind", "files", "manifest_sha256", "mismatches"],
      "properties": {
        "status": {"const": "PASS"},
        "hash_kind": {"const": "relative_path_content_sha256_v1"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_file"}},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "mismatches": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
        "v2_snapshot": {"$ref": "#/$defs/v2_source_snapshot"}
      }
    },
    "v2_source_snapshot": {
      "oneOf": [{
        "type": "object", "additionalProperties": false,
        "required": ["status", "checked", "promotion"],
        "properties": {
          "status": {"const": "NOT_CONFIGURED"},
          "checked": {"const": false},
          "promotion": {"const": "NOT_AUTHORIZED"}
        }
      }, {
        "type": "object", "additionalProperties": false,
        "required": ["status", "checked", "promotion", "root", "manifest",
          "manifest_sha256"],
        "properties": {
          "status": {"const": "PASS_REOPENED_REVIEW_REQUIRED"},
          "checked": {"const": true},
          "promotion": {"const": "NOT_AUTHORIZED"},
          "root": {"type": "string", "pattern": "^/[^\\u0000]*$"},
          "manifest": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))[^\\u0000\\\\]+$"},
          "manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }]
    },
    "source_file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "expected_sha256", "status", "actual_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "expected_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"type": "string"},
        "actual_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "error": {"type": "string"}
      }
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "head_tree", "dirty", "dirty_tree_sha256", "dirty_components"],
      "properties": {
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "dirty_tree_sha256": {"$ref": "#/$defs/sha256"},
        "dirty_components": {"$ref": "#/$defs/dirty_components"}
      }
    },
    "dirty_components": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "diff_sha256", "untracked"],
      "properties": {"status": {"type": "string"},
        "diff_sha256": {"$ref": "#/$defs/sha256"},
        "untracked": {"type": "array", "items": {"$ref": "#/$defs/untracked"}}}
    },
    "untracked": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind"],
      "properties": {"path": {"type": "string", "minLength": 1},
        "kind": {"enum": ["file", "directory", "symlink"]},
        "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "campaign_root": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "fresh", "identity"],
      "properties": {"path": {"type": "string", "pattern": "^/[^\\u0000]*$"},
        "fresh": {"const": true}, "identity": {"$ref": "#/$defs/root_identity"}}
    },
    "root_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "logical_name", "campaign_set",
        "profile_sha256", "source_manifest_sha256", "identity_sha256"],
      "properties": {
        "schema": {"const": "registration-plugin-campaign-root-v1"},
        "schema_version": {"const": 1},
        "logical_name": {"type": "string", "minLength": 1},
        "campaign_set": {"$ref": "#/$defs/campaign_set"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "identity_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_storage": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["status"],
        "properties": {"status": {"const": "NOT_APPLICABLE"}}},
      {"type": "object", "additionalProperties": false, "required": ["contract", "observed"],
        "properties": {"contract": {"$ref": "#/$defs/storage_contract"},
          "observed": {"$ref": "#/$defs/storage_observed"}}}
    ]},
    "storage_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "mountpoint", "source_uuid", "filesystem", "label"],
      "properties": {"schema": {"const": "registration-plugin-evidence-storage-v1"},
        "schema_version": {"const": 1}, "mountpoint": {"type": "string"},
        "source_uuid": {"type": "string"}, "filesystem": {"type": "string"},
        "label": {"type": "string"}}
    },
    "storage_observed": {
      "type": "object", "additionalProperties": false,
      "required": ["mountpoint", "filesystem", "source", "source_uuid"],
      "properties": {"mountpoint": {"type": "string"}, "filesystem": {"type": "string"},
        "source": {"type": "string"}, "source_uuid": {"type": ["string", "null"]}}
    },
    "runtime_probes": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "images", "containers"],
      "properties": {"status": {"enum": ["PASS", "NOT_RUNTIME_VALIDATED"]},
        "images": {"type": "array", "items": {"$ref": "#/$defs/probe_image"}},
        "containers": {"type": "array", "items": {"$ref": "#/$defs/probe_container"}}}
    },
    "probe_image": {"type": "object", "additionalProperties": false,
      "required": ["id", "repo_digests", "os", "architecture", "manifest"],
      "properties": {"id": {"type": "string"},
        "repo_digests": {"type": "array", "items": {"type": "string"}},
        "os": {"const": "linux"}, "architecture": {"const": "amd64"},
        "manifest": {"anyOf": [{"$ref": "#/$defs/image_manifest"}, {"type": "null"}]}}},
    "probe_container": {"type": "object", "additionalProperties": false,
      "required": ["name", "status"],
      "properties": {"name": {"type": "string"}, "status": {"const": "ABSENT"}}},
    "image_contract": {"type": "object", "additionalProperties": false,
      "required": ["tag", "digest", "reference"],
      "properties": {"tag": {"type": "string"}, "digest": {"type": "string"},
        "reference": {"type": "string"}, "manifest": {"$ref": "#/$defs/image_manifest"}}},
    "image_manifest": {"type": "object", "additionalProperties": false,
      "properties": {
        "index_digest": {"type": "string"},
        "index_media_type": {"type": "string"},
        "linux_amd64_digest": {"type": "string"},
        "linux_amd64_media_type": {"type": "string"},
        "linux_amd64_os": {"const": "linux"},
        "linux_amd64_architecture": {"const": "amd64"}
      }},
    "phase_state": {"type": "object", "additionalProperties": false,
      "required": ["docker", "build_test", "evidence"],
      "properties": {"docker": {"enum": ["NOT_STARTED", "ATTEMPTED", "CONFIRMED"]},
        "build_test": {"enum": ["NOT_STARTED", "ATTEMPTED", "CONFIRMED"]},
        "evidence": {"anyOf": [{"$ref": "#/$defs/descriptor"}, {"type": "null"}]}}},
    "descriptor": {"type": "object", "additionalProperties": false,
      "required": ["path", "file_bytes", "file_sha256", "sidecar_sha256", "sidecar_path"],
      "properties": {"path": {"type": "string"}, "file_bytes": {"type": "integer", "minimum": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"}, "sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "sidecar_path": {"type": "string"}}},
    "preflight_row": {"type": "object", "additionalProperties": false,
      "required": ["index", "distro", "dependency_leg", "child_root", "container_name",
        "image", "status", "phase_state"],
      "properties": {"index": {"type": "integer"}, "distro": {"enum": ["humble", "jazzy"]},
        "dependency_leg": {"enum": ["absent", "present"]},
        "child_root": {"type": "string", "pattern": "^/[^\\u0000]*$"},
        "container_name": {"type": "string"}, "image": {"$ref": "#/$defs/image_contract"},
        "status": {"const": "NOT_STARTED"}, "phase_state": {"$ref": "#/$defs/phase_state"}}
    },
    "runtime_row": {"type": "object", "additionalProperties": false,
      "required": ["index", "distro", "dependency_leg", "child_root", "container_name",
        "status", "command", "started_at_unix", "ended_at_unix", "host_receipt",
        "phase_state", "failure"],
      "properties": {"index": {"type": "integer"}, "distro": {"enum": ["humble", "jazzy"]},
        "dependency_leg": {"enum": ["absent", "present"]},
        "child_root": {"type": "string", "pattern": "^/[^\\u0000]*$"},
        "container_name": {"type": "string"}, "status": {"enum": ["PASS", "FAIL_CLOSED", "NOT_STARTED"]},
        "command": {"anyOf": [{"$ref": "#/$defs/command"}, {"type": "null"}]},
        "started_at_unix": {"type": ["number", "null"]}, "ended_at_unix": {"type": ["number", "null"]},
        "host_receipt": {"anyOf": [{"$ref": "#/$defs/host_receipt"}, {"type": "null"}]},
        "host_status": {"type": "string"}, "failure": {"$ref": "#/$defs/failure"},
        "phase_state": {"$ref": "#/$defs/phase_state"}}
    },
    "partial_failure": {"type": "object", "additionalProperties": false,
      "required": ["kind", "phase", "row", "message"],
      "properties": {"kind": {"type": "string", "minLength": 1},
        "phase": {"const": "leg"}, "row": {"type": "integer", "minimum": 0,
          "maximum": 3}, "message": {"type": "string"}}},
    "partial_row": {"type": "object", "additionalProperties": false,
      "required": ["index", "distro", "dependency_leg", "child_root",
        "container_name", "status", "path_relative", "file_bytes",
        "file_sha256", "canonical_sha256", "sidecar_path_relative",
        "sidecar_sha256", "failure"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 3},
        "distro": {"enum": ["humble", "jazzy"]},
        "dependency_leg": {"enum": ["absent", "present"]},
        "child_root": {"type": "string", "pattern": "^/[^\\u0000]*$"},
        "container_name": {"type": "string", "minLength": 1},
        "status": {"const": "FAIL_CLOSED"},
        "path_relative": {"type": "string", "pattern": "^[^/][^\\u0000\\\\]*$"},
        "file_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_sha256": {"$ref": "#/$defs/sha256"},
        "sidecar_path_relative": {"type": "string", "pattern": "^[^/][^\\u0000\\\\]*$"},
        "sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "failure": {"$ref": "#/$defs/partial_failure"}
      }
    },
    "partial_rows": {"type": "array", "maxItems": 4,
      "items": {"$ref": "#/$defs/partial_row"}},
    "command": {"type": "object", "additionalProperties": false,
      "required": ["argv", "argv_sha256"], "properties": {"argv": {"type": "array", "items": {"type": "string"}}, "argv_sha256": {"$ref": "#/$defs/sha256"}}},
    "host_receipt": {"type": "object", "additionalProperties": false,
      "required": ["path", "file_bytes", "file_sha256", "sidecar_sha256", "sidecar_path", "inner_path", "inner_sha256"],
      "properties": {"path": {"type": "string"}, "file_bytes": {"type": "integer", "minimum": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"}, "sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "sidecar_path": {"type": "string"}, "inner_path": {"type": "string"},
        "inner_sha256": {"$ref": "#/$defs/sha256"}}},
    "preflight_rows": {"type": "array", "prefixItems": [
      {"allOf": [{"$ref": "#/$defs/preflight_row"}, {"properties": {"index": {"const": 0}, "distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}}]},
      {"allOf": [{"$ref": "#/$defs/preflight_row"}, {"properties": {"index": {"const": 1}, "distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}}]},
      {"allOf": [{"$ref": "#/$defs/preflight_row"}, {"properties": {"index": {"const": 2}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}}]},
      {"allOf": [{"$ref": "#/$defs/preflight_row"}, {"properties": {"index": {"const": 3}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}}]}
    ], "items": false},
    "runtime_rows": {"type": "array", "prefixItems": [
      {"allOf": [{"$ref": "#/$defs/runtime_row"}, {"properties": {"index": {"const": 0}, "distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}}]},
      {"allOf": [{"$ref": "#/$defs/runtime_row"}, {"properties": {"index": {"const": 1}, "distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}}]},
      {"allOf": [{"$ref": "#/$defs/runtime_row"}, {"properties": {"index": {"const": 2}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}}]},
      {"allOf": [{"$ref": "#/$defs/runtime_row"}, {"properties": {"index": {"const": 3}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}}]}
    ], "items": false},
    "phase_state_pass": {"allOf": [{"$ref": "#/$defs/phase_state"},
      {"properties": {"docker": {"const": "CONFIRMED"},
        "build_test": {"const": "CONFIRMED"}}}]},
    "runtime_pass_row": {"allOf": [{"$ref": "#/$defs/runtime_row"},
      {"properties": {
        "status": {"const": "PASS"}, "command": {"$ref": "#/$defs/command"},
        "started_at_unix": {"type": "number"}, "ended_at_unix": {"type": "number"},
        "host_receipt": {"$ref": "#/$defs/host_receipt"},
        "failure": {"type": "null"},
        "phase_state": {"$ref": "#/$defs/phase_state_pass"}
      }}]},
    "runtime_pass_rows": {"type": "array", "prefixItems": [
      {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 0}, "distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}}]},
      {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 1}, "distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}}]},
      {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 2}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}}]},
      {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 3}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}}]}
    ], "items": false},
    "row_failure": {"type": "object", "additionalProperties": false,
      "required": ["kind", "phase", "message"],
      "properties": {"kind": {"type": "string"}, "phase": {"enum": [
        "before_first_row", "before_row", "leg", "summary", "after_root_creation",
        "campaign_stop"]}, "row": {"type": "integer", "minimum": 0, "maximum": 3},
        "message": {"type": "string"}}},
    "runtime_failed_row": {"allOf": [{"$ref": "#/$defs/runtime_row"},
      {"properties": {"status": {"const": "FAIL_CLOSED"},
        "failure": {"$ref": "#/$defs/row_failure"}}}]},
    "runtime_not_started_row": {"allOf": [{"$ref": "#/$defs/runtime_row"},
      {"properties": {"status": {"const": "NOT_STARTED"},
        "command": {"type": "null"}, "started_at_unix": {"type": "null"},
        "ended_at_unix": {"type": "null"}, "host_receipt": {"type": "null"},
        "phase_state": {"allOf": [{"$ref": "#/$defs/phase_state"},
          {"properties": {"docker": {"const": "NOT_STARTED"},
            "build_test": {"const": "NOT_STARTED"}}}]},
        "failure": {"$ref": "#/$defs/row_failure"}}}]},
    "runtime_failure_rows": {"oneOf": [
      {"type": "array", "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/runtime_failed_row"}, {"properties": {"index": {"const": 0}, "distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_not_started_row"}, {"properties": {"index": {"const": 1}, "distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_not_started_row"}, {"properties": {"index": {"const": 2}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_not_started_row"}, {"properties": {"index": {"const": 3}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}}]}
      ], "items": false},
      {"type": "array", "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 0}, "distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_failed_row"}, {"properties": {"index": {"const": 1}, "distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_not_started_row"}, {"properties": {"index": {"const": 2}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_not_started_row"}, {"properties": {"index": {"const": 3}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}}]}
      ], "items": false},
      {"type": "array", "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 0}, "distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 1}, "distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_failed_row"}, {"properties": {"index": {"const": 2}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_not_started_row"}, {"properties": {"index": {"const": 3}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}}]}
      ], "items": false},
      {"type": "array", "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 0}, "distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 1}, "distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_pass_row"}, {"properties": {"index": {"const": 2}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}}]},
        {"allOf": [{"$ref": "#/$defs/runtime_failed_row"}, {"properties": {"index": {"const": 3}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}}]}
      ], "items": false}
    ]},
    "runtime_nonpass_rows": {"oneOf": [
      {"$ref": "#/$defs/runtime_pass_rows"},
      {"$ref": "#/$defs/runtime_failure_rows"}
    ]},
    "preflight_summary": {"type": "object", "additionalProperties": false,
      "required": ["status", "reason"], "properties": {"status": {"const": "NOT_RUN"}, "reason": {"const": "preflight_only"}}},
    "runtime_summary": {"type": "object", "additionalProperties": false,
      "required": ["status", "path", "file_sha256", "sidecar_sha256"],
      "properties": {"status": {"enum": ["PASS", "NOT_RUN", "FAIL_CLOSED"]},
        "path": {"type": ["string", "null"]},
        "file_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "sidecar_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
    "runtime_pass_summary": {"type": "object", "additionalProperties": false,
      "required": ["status", "path", "file_sha256", "sidecar_sha256"],
      "properties": {"status": {"const": "PASS"},
        "path": {"type": "string"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "sidecar_sha256": {"$ref": "#/$defs/sha256"}}},
    "runtime_failure_summary": {"type": "object", "additionalProperties": false,
      "required": ["status", "path", "file_sha256", "sidecar_sha256"],
      "properties": {"status": {"enum": ["NOT_RUN", "FAIL_CLOSED"]},
        "path": {"type": "null"}, "file_sha256": {"type": "null"},
        "sidecar_sha256": {"type": "null"}}},
    "failure": {"type": ["object", "null"], "additionalProperties": false,
      "required": ["kind", "phase", "message"],
      "properties": {"kind": {"type": "string"}, "phase": {"type": "string"}, "row": {"type": "integer"}, "message": {"type": "string"}}},
    "failure_object": {"type": "object", "additionalProperties": false,
      "required": ["kind", "phase", "message"],
      "properties": {"kind": {"type": "string"}, "phase": {"enum": [
        "before_first_row", "before_row", "leg", "summary", "after_root_creation"]},
        "row": {"type": "integer", "minimum": 0, "maximum": 3},
        "message": {"type": "string"}}},
    "execution": {"type": "object", "additionalProperties": false,
      "required": ["row_order", "retries", "parallelism", "launcher_authority", "summary_authority"],
      "properties": {"row_order": {"const": [["humble", "absent"], ["humble", "present"], ["jazzy", "absent"], ["jazzy", "present"]]},
        "retries": {"const": 0}, "parallelism": {"const": 1}, "launcher_authority": {"type": "string"},
        "summary_authority": {"type": "string"}, "failure_phase": {"type": "string"}}},
    "safety": {"type": "object", "additionalProperties": false,
      "required": ["docker", "build_test", "bag_opened", "ground_truth_content_opened", "scorer_invoked", "map_saved", "formal_replay_started"],
      "properties": {"docker": {"$ref": "#/$defs/phase_object"}, "build_test": {"$ref": "#/$defs/phase_object"},
        "bag_opened": {"const": false}, "ground_truth_content_opened": {"const": false}, "scorer_invoked": {"const": false},
        "map_saved": {"const": false}, "formal_replay_started": {"const": false}}},
    "phase_object": {"type": "object", "additionalProperties": false,
      "required": ["state", "evidence"], "properties": {"state": {"enum": ["NOT_STARTED", "ATTEMPTED", "CONFIRMED"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/descriptor"}}}}
  }
}
