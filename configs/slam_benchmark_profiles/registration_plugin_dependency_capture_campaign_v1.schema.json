{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidarslam.example.invalid/schema/registration-plugin-dependency-capture-campaign-v1.json",
  "title": "Registration-plugin dependency capture campaign v1",
  "description": "Strict four-row capture aggregation. Rows contain only completed child captures; started failures are separate sealed partial rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "status", "outcome", "benchmark_eligible",
    "claim_eligible", "active_profile_switch", "promotion_allowed",
    "execution_started", "campaign_id", "campaign_set", "profile", "root",
    "aggregation", "rows", "row_states", "partial_rows", "partial_row_count",
    "summary", "error", "started_at_unix", "ended_at_unix", "promotion",
    "canonical_sha256"
  ],
  "properties": {
    "schema": {"const": "registration-plugin-dependency-capture-campaign-v1"},
    "schema_version": {"const": 1},
    "status": {"enum": ["REVIEW_REQUIRED", "PARTIAL_FAILURE_REVIEW_REQUIRED"]},
    "outcome": {"enum": ["PASS_REVIEW_REQUIRED", "PARTIAL_FAILURE"]},
    "benchmark_eligible": {"const": false},
    "claim_eligible": {"const": false},
    "active_profile_switch": {"const": false},
    "promotion_allowed": {"const": false},
    "execution_started": {"const": true},
    "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "campaign_set": {"$ref": "#/$defs/campaign_set"},
    "profile": {"$ref": "#/$defs/profile"},
    "root": {"$ref": "#/$defs/root"},
    "aggregation": {"$ref": "#/$defs/aggregation"},
    "rows": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/row"}},
    "row_states": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [
      {"allOf": [{"$ref": "#/$defs/state"}, {"properties": {"index": {"const": 0}, "distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}}]},
      {"allOf": [{"$ref": "#/$defs/state"}, {"properties": {"index": {"const": 1}, "distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}}]},
      {"allOf": [{"$ref": "#/$defs/state"}, {"properties": {"index": {"const": 2}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}}]},
      {"allOf": [{"$ref": "#/$defs/state"}, {"properties": {"index": {"const": 3}, "distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}}]}
    ], "items": false},
    "partial_rows": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/partial_row"}},
    "partial_row_count": {"type": "integer", "minimum": 0, "maximum": 4},
    "summary": {"$ref": "#/$defs/summary"},
    "error": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/failure"}]},
    "started_at_unix": {"type": "integer", "minimum": 0},
    "ended_at_unix": {"type": "integer", "minimum": 0},
    "promotion": {"const": "FORBIDDEN_UNTIL_SIGNED_RECEIPT"},
    "canonical_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "absolute": {"type": "string", "pattern": "^/[^\\u0000\\r\\n]*$"},
    "relative": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^\\u0000\\r\\n]+$"},
    "campaign_set": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "campaign_id", "rows", "row_set_sha256", "identity_sha256"],
      "properties": {
        "schema": {"const": "registration-plugin-campaign-set-v1"},
        "schema_version": {"const": 1},
        "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
        "rows": {"type": "array", "minItems": 4, "maxItems": 4, "prefixItems": [
          {"$ref": "#/$defs/humble_absent"},
          {"$ref": "#/$defs/humble_present"},
          {"$ref": "#/$defs/jazzy_absent"},
          {"$ref": "#/$defs/jazzy_present"}
        ], "items": false},
        "row_set_sha256": {"$ref": "#/$defs/sha"},
        "identity_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "humble_absent": {"type": "object", "additionalProperties": false, "required": ["distro", "dependency_leg"], "properties": {"distro": {"const": "humble"}, "dependency_leg": {"const": "absent"}}},
    "humble_present": {"type": "object", "additionalProperties": false, "required": ["distro", "dependency_leg"], "properties": {"distro": {"const": "humble"}, "dependency_leg": {"const": "present"}}},
    "jazzy_absent": {"type": "object", "additionalProperties": false, "required": ["distro", "dependency_leg"], "properties": {"distro": {"const": "jazzy"}, "dependency_leg": {"const": "absent"}}},
    "jazzy_present": {"type": "object", "additionalProperties": false, "required": ["distro", "dependency_leg"], "properties": {"distro": {"const": "jazzy"}, "dependency_leg": {"const": "present"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/absolute"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "root": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "device", "inode", "mode", "nlink"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "mode": {"const": 448},
        "nlink": {"type": "integer", "minimum": 2}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relative"}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "prepareMountPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "identity", "entries"],
      "properties": {
        "schema": {"const": "registration-plugin-rosdep-prepare-mount-policy-v1"},
        "schema_version": {"const": 1},
        "identity": {"const": "ordered-host-source-container-target-bindings-v1"},
        "entries": {
          "type": "array", "minItems": 8, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "source", "target", "read_only", "type", "noexec"],
            "properties": {
              "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "source": {"type": "string", "minLength": 1},
              "target": {"type": "string", "minLength": 1},
              "read_only": {"type": "boolean"}, "type": {"const": "bind"},
              "noexec": {"const": false}
            }
          }
        }
      }
    },
    "aggregation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "tool", "campaign_schema", "capture_executor_schema", "partial_receipt_schema", "prepare_mount_policy", "row_state_policy", "rows_policy", "partial_rows_policy", "normal_rows_exclude_partial", "partial_row_identity", "status", "benchmark_eligible", "promotion"],
      "properties": {
        "schema": {"const": "registration-plugin-dependency-capture-campaign-aggregation-v1"},
        "schema_version": {"const": 1},
        "tool": {"$ref": "#/$defs/binding"},
        "campaign_schema": {"$ref": "#/$defs/binding"},
        "capture_executor_schema": {"$ref": "#/$defs/binding"},
        "partial_receipt_schema": {"$ref": "#/$defs/binding"},
        "prepare_mount_policy": {"$ref": "#/$defs/prepareMountPolicy"},
        "row_state_policy": {"const": "fixed-four-state-vector"},
        "rows_policy": {"const": "completed-pass-only"},
        "partial_rows_policy": {"const": "sealed-started-child-only"},
        "normal_rows_exclude_partial": {"const": true},
        "partial_row_identity": {"const": "campaign-row-campaign-set-profile-child-receipt"},
        "status": {"const": "REVIEW_REQUIRED"},
        "benchmark_eligible": {"const": false},
        "promotion": {"const": "FORBIDDEN_UNTIL_SIGNED_RECEIPT"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["campaign_id", "campaign_set_identity_sha256", "profile", "distro", "dependency_leg", "image_digest", "container_name"],
      "properties": {
        "campaign_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
        "campaign_set_identity_sha256": {"$ref": "#/$defs/sha"},
        "profile": {"$ref": "#/$defs/profile"},
        "distro": {"enum": ["humble", "jazzy"]},
        "dependency_leg": {"enum": ["absent", "present"]},
        "image_digest": {"$ref": "#/$defs/digest"},
        "container_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,62}$"}
      }
    },
    "cardinality": {
      "type": "object", "additionalProperties": false,
      "required": ["started", "phase_count", "expected_phase_count", "release_evidence_count", "package_evidence_count", "signature_reference_count"],
      "properties": {
        "started": {"const": true}, "phase_count": {"type": "integer", "minimum": 0, "maximum": 19},
        "expected_phase_count": {"const": 19}, "release_evidence_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "package_evidence_count": {"type": "integer", "minimum": 0, "maximum": 4096}, "signature_reference_count": {"type": "integer", "minimum": 0, "maximum": 4096}
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "distro", "dependency_leg", "child_root", "container_name", "status", "started"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 3}, "distro": {"enum": ["humble", "jazzy"]},
        "dependency_leg": {"enum": ["absent", "present"]}, "child_root": {"$ref": "#/$defs/absolute"},
        "container_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,62}$"}, "status": {"enum": ["NOT_STARTED", "PASS_REVIEW_REQUIRED", "FAIL_CLOSED"]}, "started": {"type": "boolean"}
      }
    },
    "failure": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "phase", "row", "message"],
      "properties": {"kind": {"type": "string", "minLength": 1, "maxLength": 256}, "phase": {"type": "string", "minLength": 1, "maxLength": 128}, "row": {"type": "integer", "minimum": 0, "maximum": 3}, "message": {"type": "string", "maxLength": 4096}}
    },
    "row_common": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "distro", "dependency_leg", "child_root", "container_name", "status", "path_relative", "file_bytes", "file_sha256", "canonical_sha256", "sidecar_path_relative", "sidecar_sha256", "receipt_status", "receipt_outcome", "identity", "cardinality"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 3}, "distro": {"enum": ["humble", "jazzy"]}, "dependency_leg": {"enum": ["absent", "present"]},
        "child_root": {"$ref": "#/$defs/absolute"}, "container_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,62}$"},
        "status": {"const": "PASS_REVIEW_REQUIRED"}, "path_relative": {"$ref": "#/$defs/relative"}, "file_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
        "file_sha256": {"$ref": "#/$defs/sha"}, "canonical_sha256": {"$ref": "#/$defs/sha"}, "sidecar_path_relative": {"$ref": "#/$defs/relative"}, "sidecar_sha256": {"$ref": "#/$defs/sha"},
        "receipt_status": {"const": "REVIEW_REQUIRED"}, "receipt_outcome": {"const": "PASS_REVIEW_REQUIRED"}, "identity": {"$ref": "#/$defs/identity"}, "cardinality": {"$ref": "#/$defs/cardinality"}
      }
    },
    "row": {"$ref": "#/$defs/row_common"},
    "partial_row": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "distro", "dependency_leg", "child_root", "container_name", "status", "path_relative", "file_bytes", "file_sha256", "canonical_sha256", "sidecar_path_relative", "sidecar_sha256", "receipt_status", "receipt_outcome", "identity", "cardinality", "failure"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 3}, "distro": {"enum": ["humble", "jazzy"]}, "dependency_leg": {"enum": ["absent", "present"]},
        "child_root": {"$ref": "#/$defs/absolute"}, "container_name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,62}$"}, "status": {"const": "FAIL_CLOSED"},
        "path_relative": {"$ref": "#/$defs/relative"}, "file_bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}, "file_sha256": {"$ref": "#/$defs/sha"}, "canonical_sha256": {"$ref": "#/$defs/sha"},
        "sidecar_path_relative": {"$ref": "#/$defs/relative"}, "sidecar_sha256": {"$ref": "#/$defs/sha"}, "receipt_status": {"const": "FAIL_CLOSED"}, "receipt_outcome": {"const": "PARTIAL_FAILURE"},
        "identity": {"$ref": "#/$defs/identity"}, "cardinality": {"$ref": "#/$defs/cardinality"}, "failure": {"$ref": "#/$defs/failure"}
      }
    },
    "summary": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "NOT_RUN"}, "reason": {"const": "capture-only-no-promotion"}}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "REVIEW_REQUIRED"}}}, "then": {"properties": {"outcome": {"const": "PASS_REVIEW_REQUIRED"}, "error": {"type": "null"}, "rows": {"minItems": 4, "maxItems": 4}, "partial_rows": {"maxItems": 0}, "partial_row_count": {"const": 0}}}},
    {"if": {"properties": {"status": {"const": "PARTIAL_FAILURE_REVIEW_REQUIRED"}}}, "then": {"properties": {"outcome": {"const": "PARTIAL_FAILURE"}, "error": {"$ref": "#/$defs/failure"}, "partial_rows": {"minItems": 1}}}}
  ]
}
