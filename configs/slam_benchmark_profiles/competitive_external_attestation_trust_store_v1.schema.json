{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitive-external-attestation-trust-store-v1",
  "title": "Competitive SLAM external Ed25519 attestation trust store v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonical_sha256", "keys"],
  "properties": {
    "schema_version": {"const": 1},
    "canonical_sha256": {"$ref": "#/$defs/sha256"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/key"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id", "algorithm", "public_key_base64", "public_key_sha256",
        "status", "not_before_utc", "not_after_utc"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "algorithm": {"const": "Ed25519"},
        "public_key_base64": {"type": "string", "minLength": 1},
        "public_key_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["ACTIVE", "REVOKED"]},
        "not_before_utc": {"type": "string", "format": "date-time"},
        "not_after_utc": {"type": "string", "format": "date-time"}
      }
    }
  }
}
