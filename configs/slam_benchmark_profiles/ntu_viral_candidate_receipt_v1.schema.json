{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitive-ntu-viral-candidate-receipt-v1",
  "title": "NTU VIRAL Stage A candidate receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_kind", "contract_version", "status",
    "selection_id", "selection_sha256", "profile_sha256", "profile_sha256_kind",
    "candidate_root_relative", "mount_identity", "artifacts",
    "runner_input_manifest", "retry_policy", "candidate_seal"],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_kind": {"const": "ntu_viral_candidate_acquisition"},
    "contract_version": {"const": "ntu-viral-acquisition-v1"},
    "status": {"enum": ["PASS", "FAIL_CLOSED"]},
    "selection_id": {"type": "string", "minLength": 1},
    "selection_sha256": {"$ref": "#/$defs/sha256"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "profile_sha256_kind": {"const": "canonical_profile_sha256_v1"},
    "candidate_root_relative": {"$ref": "#/$defs/relative"},
    "mount_identity": {"$ref": "#/$defs/mount"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "failure": {"type": ["object", "null"], "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}},
    "runner_input_manifest": {"$ref": "#/$defs/runner"},
    "retry_policy": {"$ref": "#/$defs/retry"},
    "candidate_seal": {"$ref": "#/$defs/seal"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative": {"type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "mount": {"type": "object", "additionalProperties": false,
      "required": ["target", "uuid", "fstype", "label", "options", "verified"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "source": {"type": ["string", "null"]},
        "uuid": {"type": "string", "pattern": "^[0-9a-fA-F-]{36}$"},
        "fstype": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "options": {"type": "string"},
        "verified": {"const": true}
      }},
    "http": {"type": "object", "additionalProperties": false,
      "required": ["status_code", "headers"],
      "properties": {"status_code": {"type": "integer", "minimum": 200, "maximum": 299},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "member": {"type": "object", "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relative"}, "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}}},
    "archive": {"type": "object", "additionalProperties": false,
      "required": ["format", "member_count", "members", "tree_sha256"],
      "properties": {"format": {"enum": ["zip", "tar"]}, "member_count": {"type": "integer", "minimum": 1},
        "members": {"type": "array", "items": {"$ref": "#/$defs/member"}}, "tree_sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact": {"type": "object", "additionalProperties": false,
      "required": ["role", "sequence_id", "relative_path", "requested_url", "final_url",
        "redirect_chain", "http", "retrieved_at_utc", "size_bytes", "sha256", "hash_kind"],
      "properties": {
        "role": {"enum": ["sequence_archive", "ground_truth_csv", "calib_stereo", "calib_stereo_imu"]},
        "sequence_id": {"type": "string", "minLength": 1},
        "relative_path": {"$ref": "#/$defs/relative"},
        "requested_url": {"type": "string", "pattern": "^https://"},
        "final_url": {"type": "string", "pattern": "^https://"},
        "redirect_chain": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
        "http": {"$ref": "#/$defs/http"},
        "retrieved_at_utc": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "hash_kind": {"const": "sha256_file_v1"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "archive": {"$ref": "#/$defs/archive"}
      }},
    "runner": {"type": "object", "additionalProperties": false,
      "required": ["ground_truth_paths_exposed", "ground_truth_relative_paths", "input_relative_paths"],
      "properties": {"ground_truth_paths_exposed": {"const": false},
        "ground_truth_relative_paths": {"const": []},
        "input_relative_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relative"}}}},
    "retry": {"type": "object", "additionalProperties": false,
      "required": ["candidate_root_reuse", "overwrite", "partial_download_reuse", "retry_after_failure"],
      "properties": {"candidate_root_reuse": {"const": false}, "overwrite": {"const": false},
        "partial_download_reuse": {"const": false}, "retry_after_failure": {"const": false}}},
    "seal": {"type": "object", "additionalProperties": false,
      "required": ["sealed", "review_status", "profile_edit_performed"],
      "properties": {"sealed": {"const": true}, "review_status": {"enum": ["CANDIDATE_ONLY", "CANDIDATE_FAILURE"]},
        "profile_edit_performed": {"const": false}}}
  }
}
