{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidarslam.example.invalid/schema/registration-plugin-capture-directory-contract-v1.json",
  "title": "Registration-plugin host-owned capture directory contract v1",
  "description": "Strict companion contract for the directories created by the host before container start. It never authorizes promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "directory", "canonical_sha256"],
  "properties": {
    "schema": {"const": "registration-plugin-capture-directory-contract-v1"},
    "schema_version": {"const": 1},
    "directory": {"oneOf": [
      {"$ref": "#/$defs/passDirectory"},
      {"$ref": "#/$defs/failedDirectory"}
    ]},
    "canonical_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "absolute": {"type": "string", "pattern": "^/[^\\u0000\\r\\n]*$"},
    "relative": {"type": "string", "pattern": "^(?:\\.|(?!.*(?:^|/)\\.\\.?/)[^/\\\\\\u0000\\r\\n]+(?:/[^/\\\\\\u0000\\r\\n]+)*)$"},
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["uid", "gid"],
      "properties": {
        "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0}
      }
    },
    "directoryDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "device", "inode", "uid", "gid", "mode", "nlink"],
      "properties": {
        "path": {"$ref": "#/$defs/relative"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1},
        "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0},
        "mode": {"const": 448},
        "nlink": {"type": "integer", "minimum": 2}
      }
    },
    "directoryList": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/directoryDescriptor"}
    },
    "passDirectory": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "status", "root", "mode", "owner", "paths", "root_before", "before", "after"],
      "properties": {
        "schema": {"const": "registration-plugin-host-evidence-directory-v1"},
        "schema_version": {"const": 1},
        "status": {"const": "PASS"},
        "root": {"$ref": "#/$defs/absolute"},
        "mode": {"const": 448},
        "owner": {"$ref": "#/$defs/owner"},
        "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?/)[^/\\\\\\u0000\\r\\n]+(?:/[^/\\\\\\u0000\\r\\n]+)*$"}},
        "root_before": {"$ref": "#/$defs/directoryDescriptor"},
        "before": {"$ref": "#/$defs/directoryList"},
        "after": {"$ref": "#/$defs/directoryList"}
      }
    },
    "failedDirectory": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "status", "failure"],
      "properties": {
        "schema": {"const": "registration-plugin-host-evidence-directory-v1"},
        "schema_version": {"const": 1},
        "status": {"const": "FAIL_CLOSED"},
        "failure": {"type": "string", "minLength": 1, "maxLength": 2048},
        "root": {"$ref": "#/$defs/absolute"},
        "mode": {"const": 448},
        "owner": {"$ref": "#/$defs/owner"},
        "paths": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "root_before": {"$ref": "#/$defs/directoryDescriptor"},
        "before": {"$ref": "#/$defs/directoryList"}
      }
    },
    "sealedFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "uid", "gid", "nlink", "device", "inode"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "sha256": {"$ref": "#/$defs/sha"},
        "mode": {"const": 292},
        "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0},
        "nlink": {"const": 1},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1}
      }
    },
    "sidecar": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "uid", "gid", "nlink", "device", "inode"],
      "properties": {
        "path": {"$ref": "#/$defs/absolute"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 512},
        "sha256": {"$ref": "#/$defs/sha"},
        "mode": {"const": 292},
        "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0},
        "nlink": {"const": 1},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1}
      }
    }
  }
}
