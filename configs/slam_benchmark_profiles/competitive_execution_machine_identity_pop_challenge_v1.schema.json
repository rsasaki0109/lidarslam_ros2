{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitive_execution_machine_identity_pop_challenge_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "campaign_domain", "campaign_id", "candidate_binding", "profile_binding", "thread_policy", "machine_id_sha256", "public", "host_public_key", "trust_policy", "final_output_name", "replay_ledger_path", "challenge_nonce_base64", "challenge_nonce_sha256", "issued_at", "expires_at", "producer", "challenge_payload_sha256", "canonical_sha256"],
  "properties": {
    "schema": {"const": "competitive_execution_machine_identity_pop_challenge_v1"}, "schema_version": {"const": 1}, "status": {"const": "CHALLENGE_PENDING"},
    "campaign_domain": {"const": "lidarslam/competitive-execution-r3/machine-identity-pop/ed25519/v1"}, "campaign_id": {"const": "competitive-execution-selection-2026-08-r3-candidate"},
    "candidate_binding": {"$ref": "#/$defs/candidate"}, "profile_binding": {"$ref": "#/$defs/profile"}, "thread_policy": {"$ref": "#/$defs/thread"},
    "machine_id_sha256": {"$ref": "#/$defs/sha"}, "public": {"$ref": "#/$defs/public"}, "host_public_key": {"$ref": "#/$defs/keyRef"}, "trust_policy": {"$ref": "#/$defs/policyRef"},
    "final_output_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "replay_ledger_path": {"type": "string", "pattern": "^/[^\\u0000]*$"},
    "challenge_nonce_base64": {"type": "string", "minLength": 44, "maxLength": 64}, "challenge_nonce_sha256": {"$ref": "#/$defs/sha"},
    "issued_at": {"type": "integer", "minimum": 0}, "expires_at": {"type": "integer", "minimum": 1}, "producer": {"$ref": "#/$defs/producer"},
    "challenge_payload_sha256": {"$ref": "#/$defs/sha"}, "canonical_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["path", "file_sha256", "candidate_identity_sha256", "candidate_id", "status"], "properties": {"path": {"const": "configs/slam_benchmark_profiles/competitive_execution_selection_2026-08-r3-candidate.json"}, "file_sha256": {"$ref": "#/$defs/sha"}, "candidate_identity_sha256": {"$ref": "#/$defs/sha"}, "candidate_id": {"const": "competitive-execution-selection-2026-08-r3-candidate"}, "status": {"const": "NOT_READY"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["path", "file_sha256", "canonical_sha256", "canonical_hash_kind"], "properties": {"path": {"const": "configs/slam_benchmark_profiles/competitive_slam_v1.yaml"}, "file_sha256": {"$ref": "#/$defs/sha"}, "canonical_sha256": {"$ref": "#/$defs/sha"}, "canonical_hash_kind": {"const": "canonical_profile_sha256_v1"}}},
    "thread": {"type": "object", "additionalProperties": false, "required": ["status", "required_keys", "values", "canonical_sha256"], "properties": {"status": {"const": "RECORDED_NOT_READY_EXTERNAL_MACHINE"}, "required_keys": {"const": ["cpu_affinity", "max_threads", "omp_num_threads", "openblas_num_threads", "mkl_num_threads", "tbb_num_threads", "accelerator_policy"]}, "values": {"type": "object", "additionalProperties": false}, "canonical_sha256": {"$ref": "#/$defs/sha"}}},
    "public": {"type": "object", "additionalProperties": false, "required": ["architecture", "cpu_model", "logical_cpu_count", "memory_total_kb", "kernel_release", "observed_affinity"], "properties": {"architecture": {"type": "string", "minLength": 1}, "cpu_model": {"type": "string", "minLength": 1}, "logical_cpu_count": {"type": "integer", "minimum": 1}, "memory_total_kb": {"type": "integer", "minimum": 1}, "kernel_release": {"type": "string", "minLength": 1}, "observed_affinity": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}}},
    "keyRef": {"type": "object", "additionalProperties": false, "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256", "campaign_id", "key_id", "algorithm", "public_key_sha256", "provisioning_receipt_sha256", "valid_from", "valid_until"], "properties": {"schema": {"const": "competitive_execution_machine_host_public_key_v1"}, "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "file_sha256": {"$ref": "#/$defs/sha"}, "file_bytes": {"type": "integer", "minimum": 1}, "canonical_sha256": {"$ref": "#/$defs/sha"}, "campaign_id": {"const": "competitive-execution-selection-2026-08-r3-candidate"}, "key_id": {"type": "string"}, "algorithm": {"const": "Ed25519"}, "public_key_sha256": {"$ref": "#/$defs/sha"}, "provisioning_receipt_sha256": {"$ref": "#/$defs/sha"}, "valid_from": {"type": "integer", "minimum": 0}, "valid_until": {"type": "integer", "minimum": 1}}},
    "policyRef": {"type": "object", "additionalProperties": false, "required": ["schema", "path", "file_sha256", "file_bytes", "canonical_sha256", "status", "authorized_runtime", "authorized_keys_sha256"], "properties": {"schema": {"const": "competitive_execution_machine_identity_pop_trust_policy_v1"}, "path": {"type": "string", "minLength": 1}, "file_sha256": {"$ref": "#/$defs/sha"}, "file_bytes": {"type": "integer", "minimum": 1}, "canonical_sha256": {"$ref": "#/$defs/sha"}, "status": {"enum": ["NOT_READY", "READY"]}, "authorized_runtime": {"type": "boolean"}, "authorized_keys_sha256": {"$ref": "#/$defs/sha"}}},
    "producer": {"type": "object", "additionalProperties": false, "required": ["module", "source_sha256", "version"], "properties": {"module": {"const": "scripts/capture_competitive_execution_machine_identity_pop.py"}, "source_sha256": {"$ref": "#/$defs/sha"}, "version": {"const": "1.0.0"}}}
  }
}
