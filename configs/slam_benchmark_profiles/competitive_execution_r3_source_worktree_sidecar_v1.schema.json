{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "competitive_execution_r3_source_worktree_sidecar_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "artifact_path", "artifact_bytes",
    "artifact_sha256", "snapshot_identity_sha256"
  ],
  "properties": {
    "schema": {"const": "competitive_execution_source_worktree_snapshot_sidecar_v1"},
    "schema_version": {"const": 1},
    "artifact_path": {
      "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
