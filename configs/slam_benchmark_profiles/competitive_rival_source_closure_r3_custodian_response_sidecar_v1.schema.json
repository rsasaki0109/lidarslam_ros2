{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitive-rival-source-closure-r3-custodian-response-sidecar-v1",
  "title": "Immutable signed rival-closure custodian response sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "artifact_path", "artifact_bytes",
    "artifact_sha256", "canonical_sha256"],
  "properties": {
    "schema": {"const": "competitive_rival_source_closure_r3_custodian_response_sidecar_v1"},
    "schema_version": {"const": 1},
    "artifact_path": {"type": "string", "pattern": "^[^/\\u0000]+$"},
    "artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
