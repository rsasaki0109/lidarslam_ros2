{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidarslam.example.invalid/schema/registration-plugin-dependency-environment-v1.json",
  "title": "Registration plugin dependency environment v1",
  "description": "Strict in-container dependency identity. The production capture contract permits only the fixed ros2.sources symlink and records its target separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "status", "base_image", "ros", "dpkg",
    "apt", "rosdep", "install_command", "capture", "secret_policy",
    "canonical_sha256"
  ],
  "properties": {
    "schema": {"const": "registration-plugin-dependency-environment-v1"},
    "schema_version": {"const": 1},
    "status": {"const": "PASS"},
    "base_image": {"$ref": "#/$defs/baseImage"},
    "ros": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distro"],
      "properties": {"distro": {"enum": ["humble", "jazzy"]}}
    },
    "dpkg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "package_count", "canonical_sha256"],
      "properties": {
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/package"}
        },
        "package_count": {"type": "integer", "minimum": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "apt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_config", "indexes"],
      "properties": {
        "source_config": {"$ref": "#/$defs/sourceConfig"},
        "indexes": {"$ref": "#/$defs/indexSection"}
      }
    },
    "rosdep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "cache"],
      "properties": {
        "sources": {"$ref": "#/$defs/fileSection"},
        "cache": {"$ref": "#/$defs/fileSection"}
      }
    },
    "install_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "exit_code"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "exit_code": {"const": 0}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_sha256"],
      "properties": {"script_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "secret_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_recorded", "credential_values_recorded",
        "proxy_values_recorded"
      ],
      "properties": {
        "environment_recorded": {"const": []},
        "credential_values_recorded": {"const": false},
        "proxy_values_recorded": {"const": false}
      }
    },
    "canonical_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest", "os", "architecture", "dpkg_architecture", "machine"
      ],
      "properties": {
        "digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "os": {"const": "linux"},
        "architecture": {"enum": ["amd64", "arm64", "armhf", "i386"]},
        "dpkg_architecture": {"enum": ["amd64", "arm64", "armhf", "i386"]},
        "machine": {"type": "string", "minLength": 1}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture", "status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      }
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^./][^\\\\]*$"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "targetFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "size_bytes", "sha256", "mode", "uid", "gid", "nlink"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^/[^\\x00]+$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "mode": {"const": 420},
        "uid": {"const": 0},
        "gid": {"const": 0},
        "nlink": {"const": 1}
      }
    },
    "symlinkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "target", "size_bytes", "mode", "uid", "gid", "nlink",
        "target_file"
      ],
      "properties": {
        "path": {"const": "apt_sources/sources.list.d/ros2.sources"},
        "target": {"type": "string", "pattern": "^/[^\\x00]+$"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "mode": {"const": 511},
        "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0},
        "nlink": {"const": 1},
        "target_file": {"$ref": "#/$defs/targetFile"}
      }
    },
    "fileSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "entry_count", "tree_sha256"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileEntry"}
        },
        "entry_count": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "indexSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "entry_count", "tree_sha256", "release_indexes"],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileEntry"}
        },
        "entry_count": {"type": "integer", "minimum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "release_indexes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fileEntry"}
        }
      }
    },
    "sourceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entries", "entry_count", "symlink_entries", "symlink_count",
        "tree_sha256"
      ],
      "properties": {
        "entries": {
          "type": "array",
          "minItems": 0,
          "items": {"$ref": "#/$defs/fileEntry"}
        },
        "entry_count": {"type": "integer", "minimum": 0},
        "symlink_entries": {
          "type": "array",
          "maxItems": 1,
          "items": {"$ref": "#/$defs/symlinkEntry"}
        },
        "symlink_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "tree_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
