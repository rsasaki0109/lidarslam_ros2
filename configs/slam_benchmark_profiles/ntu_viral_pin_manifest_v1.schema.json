{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitive-ntu-viral-pin-manifest-v1",
  "title": "NTU VIRAL reviewed-pin proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_kind", "status", "claim_eligible",
    "selection_id", "selection_sha256", "profile_sha256", "candidate_receipt_sha256",
    "candidate_root_relative", "runner_gt_paths_exposed", "runner_input_manifest",
    "input_artifacts", "ground_truth_artifacts", "calibration_artifacts",
    "profile_diff", "review_requirements"],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_kind": {"const": "ntu_viral_immutable_pin_manifest"},
    "status": {"enum": ["PROPOSED_REVIEW_REQUIRED", "REVIEWED", "INVALID"]},
    "claim_eligible": {"type": "boolean"},
    "selection_id": {"type": "string", "minLength": 1},
    "selection_sha256": {"$ref": "#/$defs/sha256"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_root_relative": {"$ref": "#/$defs/relative"},
    "runner_gt_paths_exposed": {"const": false},
    "runner_input_manifest": {"$ref": "#/$defs/runner"},
    "input_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "ground_truth_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "calibration_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "profile_diff": {"type": "object", "additionalProperties": false,
      "required": ["selection_id", "required_review_status", "required_profile_byte_identity_status", "sequence_roles"],
      "properties": {"selection_id": {"type": "string", "minLength": 1},
        "required_review_status": {"const": "REVIEWED"},
        "required_profile_byte_identity_status": {"const": "REVALIDATED"},
        "sequence_roles": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/sequence_role"}}}},
    "review_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative": {"type": "string", "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "runner": {"type": "object", "additionalProperties": false,
      "required": ["ground_truth_paths_exposed", "input_relative_paths", "ground_truth_relative_paths"],
      "properties": {"ground_truth_paths_exposed": {"const": false},
        "input_relative_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/relative"}},
        "ground_truth_relative_paths": {"const": []}}},
    "archive": {"type": "object", "additionalProperties": false,
      "required": ["format", "member_count", "members", "tree_sha256"],
      "properties": {"format": {"enum": ["zip", "tar"]}, "member_count": {"type": "integer", "minimum": 1},
        "members": {"type": "array"}, "tree_sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact": {"type": "object", "additionalProperties": false,
      "required": ["role", "sequence_id", "relative_path", "sha256", "size_bytes", "hash_kind"],
      "properties": {"role": {"type": "string", "minLength": 1}, "sequence_id": {"type": "string", "minLength": 1},
        "relative_path": {"$ref": "#/$defs/relative"}, "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}, "hash_kind": {"const": "sha256_file_v1"},
        "tree_sha256": {"$ref": "#/$defs/sha256"}, "archive": {"$ref": "#/$defs/archive"}}},
    "sequence_role": {"type": "object", "additionalProperties": false,
      "required": ["sequence_id", "input_sha256", "ground_truth_sha256", "calibration_sha256"],
      "properties": {"sequence_id": {"type": "string", "minLength": 1}, "input_sha256": {"$ref": "#/$defs/sha256"},
        "ground_truth_sha256": {"$ref": "#/$defs/sha256"}, "calibration_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
