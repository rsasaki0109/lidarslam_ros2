{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitive-evidence-bundle-composer-v1",
  "title": "Competitive evidence bundle composer input v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_path",
    "profile",
    "scorer",
    "revision",
    "artifacts",
    "run_artifact_bindings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_path": {"type": "string", "minLength": 1},
    "invoke_scorer": {"type": "boolean"},
    "scorer_command": {},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "canonical_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "canonical_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "scorer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint"],
      "properties": {"fingerprint": {"$ref": "#/$defs/sha256"}}
    },
    "post_score_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "receipt_sha256", "scorer_fingerprint",
        "input_evidence_sha256", "scored_evidence_sha256"
      ],
      "properties": {
        "status": {"const": "PASS"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "scorer_fingerprint": {"$ref": "#/$defs/sha256"},
        "input_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "scored_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["systems"],
      "properties": {
        "systems": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/globalArtifact"}
    },
    "run_artifact_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/runArtifactBinding"}
    },
    "authorization": {
      "description": "When --allow-claim is requested, this mapping must contain a complete failure_log whose canonical JSON is the global failure artifact.",
      "type": "object"
    },
    "authorization_policy": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_root", "source_path", "size_bytes", "sha256"],
      "properties": {
        "source_root": {"type": "string", "minLength": 1},
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000]+$"
        },
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "globalArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source_root", "source_path", "size_bytes", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "input", "result", "config", "calibration", "revision",
            "scorer", "trajectory", "resource", "map_metric", "failure"
          ]
        },
        "source_root": {"type": "string", "minLength": 1},
        "source_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(^|/)\\.\\.?(/|$))[^\\u0000]+$"
        },
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system", "dataset", "run_index", "trajectory", "map", "resource",
        "execution"
      ],
      "properties": {
        "system": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "run_index": {"type": "integer", "minimum": 1},
        "trajectory": {"$ref": "#/$defs/sourceDescriptor"},
        "map": {"$ref": "#/$defs/sourceDescriptor"},
        "resource": {"$ref": "#/$defs/sourceDescriptor"},
        "execution": {"$ref": "#/$defs/sourceDescriptor"}
      }
    }
  }
}
