{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidarslam.example.invalid/schema/registration-plugin-contract-manifest-v1.json",
  "title": "Lidarslam registration plugin contract manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "class_id", "plugin_xml_sha256",
    "plugin_xml_size_bytes", "dso_sha256", "dso_size_bytes", "abi_epoch",
    "toolchain_tag", "interface_contract_sha256", "api_min_major",
    "api_min_minor", "api_max_major", "api_max_minor",
    "required_capability_bits", "optional_capability_bits", "target_policy",
    "correspondence_metric", "thread_model", "cancellation_model", "config_schema_id",
    "config_schema_version", "config_schema_sha256", "manifest_sha256"
  ],
  "properties": {
    "schema": {"const": "lidarslam-registration-contract-manifest-v1"},
    "schema_version": {"const": 1},
    "class_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_./-]+$"},
    "plugin_xml_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plugin_xml_size_bytes": {"type": "integer", "minimum": 0},
    "dso_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dso_size_bytes": {"type": "integer", "minimum": 1},
    "abi_epoch": {"const": "lidarslam.registration.cpp14.abi1"},
    "toolchain_tag": {"type": "string", "minLength": 1},
    "interface_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "api_min_major": {"const": 1},
    "api_min_minor": {"type": "integer", "minimum": 0, "maximum": 65535},
    "api_max_major": {"const": 1},
    "api_max_minor": {"type": "integer", "minimum": 0, "maximum": 65535},
    "required_capability_bits": {"type": "integer", "minimum": 0, "maximum": 255},
    "optional_capability_bits": {"type": "integer", "minimum": 0, "maximum": 255},
    "target_policy": {"type": "integer", "enum": [0, 1, 2]},
    "correspondence_metric": {"type": "integer", "enum": [0, 1, 2]},
    "thread_model": {"type": "integer", "enum": [0, 1]},
    "cancellation_model": {"type": "integer", "enum": [0, 1]},
    "config_schema_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "config_schema_version": {"type": "integer", "minimum": 1},
    "config_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
