{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitive_execution_machine_identity_pop_proof_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "challenge_path", "challenge_file_sha256", "challenge_canonical_sha256", "challenge_payload_sha256", "key_id", "algorithm", "signature_base64", "signature_sha256", "canonical_sha256"],
  "properties": {
    "schema": {"const": "competitive_execution_machine_identity_pop_proof_v1"}, "schema_version": {"const": 1}, "status": {"const": "EXTERNAL_SIGNATURE"},
    "challenge_path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "challenge_file_sha256": {"$ref": "#/$defs/sha"}, "challenge_canonical_sha256": {"$ref": "#/$defs/sha"}, "challenge_payload_sha256": {"$ref": "#/$defs/sha"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "algorithm": {"const": "Ed25519"}, "signature_base64": {"type": "string", "minLength": 88, "maxLength": 128}, "signature_sha256": {"$ref": "#/$defs/sha"}, "canonical_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
