{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "competitive_execution_machine_host_public_key_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "campaign_domain", "campaign_id", "key_id", "algorithm", "public_key_base64", "public_key_sha256", "provisioning_receipt_sha256", "valid_from", "valid_until", "canonical_sha256"],
  "properties": {
    "schema": {"const": "competitive_execution_machine_host_public_key_v1"},
    "schema_version": {"const": 1},
    "status": {"const": "EXTERNALLY_PROVISIONED"},
    "campaign_domain": {"const": "lidarslam/competitive-execution-r3/machine-identity-pop/ed25519/v1"},
    "campaign_id": {"const": "competitive-execution-selection-2026-08-r3-candidate"},
    "key_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "algorithm": {"const": "Ed25519"},
    "public_key_base64": {"type": "string", "minLength": 44, "maxLength": 88},
    "public_key_sha256": {"$ref": "#/$defs/sha"},
    "provisioning_receipt_sha256": {"$ref": "#/$defs/sha"},
    "valid_from": {"type": "integer", "minimum": 0},
    "valid_until": {"type": "integer", "minimum": 1},
    "canonical_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
