{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lidarslam.example.invalid/schema/registration-plugin-apt-source-snapshot-v2.json",
  "title": "GLIM r3 registration-plugin APT source snapshot v2",
  "description": "Strict schema for the v2 source snapshot. Runtime code additionally reopens every byte and inode and checks Release-to-Packages bindings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "status", "apt_source_url_policy", "release_declaration_policy", "packages_format_policy", "gpgv_status_policy", "files", "source_entries", "keyrings", "source_descriptors", "repositories", "canonical_sha256"],
  "properties": {
    "schema": {"const": "glim_clean_room_r3_apt_source_snapshot_v2"},
    "schema_version": {"const": 2},
    "status": {"const": "SEALED_REVIEW_REQUIRED"},
    "apt_source_url_policy": {"$ref": "#/$defs/urlPolicy"},
    "release_declaration_policy": {"$ref": "#/$defs/releaseDeclarationPolicy"},
    "packages_format_policy": {"$ref": "#/$defs/packagesFormatPolicy"},
    "gpgv_status_policy": {"$ref": "#/$defs/gpgvStatusPolicy"},
    "files": {"type": "array", "minItems": 3, "items": {"oneOf": [{"$ref": "#/$defs/aptSourceFile"}, {"$ref": "#/$defs/aptPackagesFile"}, {"$ref": "#/$defs/indexFile"}]}},
    "source_entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceEntry"}},
    "keyrings": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/pathKeyring"}, {"$ref": "#/$defs/inlineKeyring"}]}},
    "source_descriptors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceDescriptor"}},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "canonical_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fingerprint": {"type": "string", "pattern": "^[0-9A-Fa-f]{40}$"},
    "relative": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.\\.?/)[^/\\\\\\u0000\\r\\n]+(?:/[^/\\\\\\u0000\\r\\n]+)*$"},
    "absolute": {"type": "string", "pattern": "^/[^\\u0000\\r\\n]*$"},
    "aptUrl": {"type": "string", "maxLength": 2048, "oneOf": [
      {"pattern": "^https://[^\\u0000\\r\\n?#]+$"},
      {"pattern": "^http://archive\\.ubuntu\\.com(?::80)?/ubuntu(?:/[^\\u0000\\r\\n?#]*)?$"},
      {"pattern": "^http://packages\\.ros\\.org(?::80)?/ros2/ubuntu(?:/[^\\u0000\\r\\n?#]*)?$"},
      {"pattern": "^http://security\\.ubuntu\\.com(?::80)?/ubuntu(?:/[^\\u0000\\r\\n?#]*)?$"}
    ]},
    "urlPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "https", "http_prefixes", "http_default_port", "redirect_policy"],
      "properties": {
        "schema": {"const": "registration-plugin-apt-source-url-policy-v1"},
        "schema_version": {"const": 1}, "https": {"const": "allowed"},
        "http_prefixes": {"const": ["http://archive.ubuntu.com/ubuntu", "http://packages.ros.org/ros2/ubuntu", "http://security.ubuntu.com/ubuntu"]},
        "http_default_port": {"const": 80},
        "redirect_policy": {"const": "same-host-only-and-requested-url-recorded"}
      }
    },
    "releaseDeclarationPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "max_declared_bytes", "decimal_grammar", "zero_allowed"],
      "properties": {
        "schema": {"const": "registration-plugin-release-declaration-size-policy-v1"},
        "schema_version": {"const": 1},
        "max_declared_bytes": {"const": 17179869184},
        "decimal_grammar": {"const": "0|[1-9][0-9]*"},
        "zero_allowed": {"const": true}
      }
    },
    "packagesFormatPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "selection_order", "allowed_formats", "compressed_max_bytes", "decoded_max_bytes", "max_expansion_ratio", "trailing_data", "concatenated_streams", "terminal_empty_stream_policy", "signed_empty_packages_policy"],
      "properties": {
        "schema": {"const": "registration-plugin-packages-format-policy-v1"},
        "schema_version": {"const": 1},
        "selection_order": {"const": ["xz", "gz", "plain"]},
        "allowed_formats": {"const": ["xz", "gz", "plain"]},
        "compressed_max_bytes": {"const": 67108864},
        "decoded_max_bytes": {"const": 268435456},
        "max_expansion_ratio": {"const": 256},
        "trailing_data": {"const": "reject"},
        "concatenated_streams": {"const": "reject"},
        "terminal_empty_stream_policy": {"$ref": "#/$defs/terminalEmptyStreamPolicy"},
        "signed_empty_packages_policy": {"$ref": "#/$defs/signedEmptyPackagesPolicy"}
      }
    },
    "terminalEmptyStreamPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "enabled", "max_streams", "compressed_bytes", "decoded_bytes", "padding", "binding"],
      "properties": {
        "schema": {"const": "registration-plugin-xz-terminal-empty-stream-policy-v1"},
        "schema_version": {"const": 1}, "enabled": {"const": true},
        "max_streams": {"const": 2}, "compressed_bytes": {"const": 32},
        "decoded_bytes": {"const": 0}, "padding": {"const": "forbidden"},
        "binding": {"const": "index-offset-bytes-sha256-decoded-bytes"}
      }
    },
    "signedEmptyPackagesPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "enabled", "signed_empty", "decoded_sha256", "decoded_bytes", "allowed_formats", "xz_stream_count", "xz_compressed_bytes", "padding", "trailing_data", "binding"],
      "properties": {
        "schema": {"const": "registration-plugin-signed-empty-packages-policy-v1"},
        "schema_version": {"const": 1}, "enabled": {"const": true},
        "signed_empty": {"const": true},
        "decoded_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
        "decoded_bytes": {"const": 0}, "allowed_formats": {"const": ["xz"]},
        "xz_stream_count": {"const": 1}, "xz_compressed_bytes": {"const": 32},
        "padding": {"const": "forbidden"}, "trailing_data": {"const": "reject"},
        "binding": {"const": "signed-release-pair-compressed-bytes-and-exact-empty-decode"}
      }
    },
    "gpgvStatusPolicy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "schema_version", "gnupg_version", "required_proof_tags",
        "optional_informational_tags", "informational_pair", "status_order",
        "key_considered_fields", "key_considered_fingerprint",
        "key_considered_flags", "verification_compliance_mode_fields",
        "verification_compliance_mode", "informational_only", "proof",
        "keyring_input"
      ],
      "properties": {
        "schema": {"const": "registration-plugin-gpgv-status-policy-v1"},
        "schema_version": {"const": 1},
        "gnupg_version": {"const": "2.2.27"},
        "required_proof_tags": {"const": ["NEWSIG", "GOODSIG", "VALIDSIG"]},
        "optional_informational_tags": {
          "const": ["KEY_CONSIDERED", "VERIFICATION_COMPLIANCE_MODE"]
        },
        "informational_pair": {"const": "independently-optional"},
        "status_order": {"const": [
          "NEWSIG", "KEY_CONSIDERED", "SIG_ID", "GOODSIG", "VALIDSIG",
          "VERIFICATION_COMPLIANCE_MODE"
        ]},
        "key_considered_fields": {"const": 4},
        "key_considered_fingerprint": {"const": "validsig-primary-or-signer"},
        "key_considered_flags": {
          "const": "canonical-decimal-0..2147483647"
        },
        "verification_compliance_mode_fields": {"const": 3},
        "verification_compliance_mode": {
          "const": "canonical-decimal-0..2147483647"
        },
        "informational_only": {"const": true},
        "proof": {"const": "GOODSIG_VALIDSIG_only"},
        "keyring_input": {"const": "dearmored_path_only"}
      }
    },
    "bytesFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "url", "bytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relative"}, "role": {"type": "string"}, "url": {"$ref": "#/$defs/aptUrl"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "aptSourceFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "urls", "bytes", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/relative"}, "role": {"const": "apt_source"}, "urls": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"$ref": "#/$defs/aptUrl"}}, "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "indexFile": {
      "allOf": [{"$ref": "#/$defs/bytesFile"}, {"properties": {"role": {"enum": ["apt_release", "apt_packages"]}}}]
    },
    "aptPackagesFile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "role", "url", "bytes", "sha256", "compressed"],
      "properties": {
        "path": {"$ref": "#/$defs/relative"},
        "role": {"const": "apt_packages"},
        "url": {"$ref": "#/$defs/aptUrl"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "sha256": {"$ref": "#/$defs/sha"},
        "compressed": {"$ref": "#/$defs/compressedArtifact"}
      },
      "allOf": [
        {"if": {"properties": {"compressed": {"properties": {"signed_empty": {"const": true}}}}}, "then": {"properties": {"bytes": {"const": 0}}}},
        {"if": {"properties": {"compressed": {"properties": {"signed_empty": {"const": false}}}}}, "then": {"properties": {"bytes": {"minimum": 1}}}}
      ]
    },
    "compressedOutputDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "uid", "gid", "nlink", "device", "inode"],
      "properties": {
        "path": {"pattern": "^raw-indexes/[^/\\\\\\u0000\\r\\n]+(?:/[^/\\\\\\u0000\\r\\n]+)*$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "sha256": {"$ref": "#/$defs/sha"}, "mode": {"const": 292},
        "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0},
        "nlink": {"const": 1}, "device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}
      }
    },
    "decodedOutputDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "uid", "gid", "nlink", "device", "inode"],
      "properties": {
        "path": {"pattern": "^apt-source/[^/\\\\\\u0000\\r\\n]+(?:/[^/\\\\\\u0000\\r\\n]+)*$"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha"}, "mode": {"const": 292},
        "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0},
        "nlink": {"const": 1}, "device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}
      }
    },
    "packageArtifactIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "repository_url", "suite", "component", "architecture", "release_kind", "release_identity", "release_url", "release_record_path", "release_file_sha256", "release_file_bytes", "signed_compressed_path", "signed_plain_path", "format", "packages_url", "compressed_sha256", "compressed_bytes", "decoded_sha256", "decoded_bytes", "signed_empty", "identity"],
      "properties": {
        "domain": {"const": "registration-plugin-packages-artifact-identity-v1"},
        "repository_url": {"$ref": "#/$defs/aptUrl"},
        "suite": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]{0,127}$"},
        "component": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.-]{0,127}$"},
        "architecture": {"const": "amd64"},
        "release_kind": {"enum": ["inrelease", "detached"]},
        "release_identity": {"$ref": "#/$defs/sha"},
        "release_url": {"$ref": "#/$defs/aptUrl"},
        "release_record_path": {"$ref": "#/$defs/relative"},
        "release_file_sha256": {"$ref": "#/$defs/sha"},
        "release_file_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "signed_compressed_path": {"$ref": "#/$defs/relative"},
        "signed_plain_path": {"$ref": "#/$defs/relative"},
        "format": {"enum": ["xz", "gz", "plain"]},
        "packages_url": {"$ref": "#/$defs/aptUrl"},
        "compressed_sha256": {"$ref": "#/$defs/sha"},
        "compressed_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "decoded_sha256": {"$ref": "#/$defs/sha"},
        "decoded_bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "signed_empty": {"type": "boolean"},
        "identity": {"$ref": "#/$defs/sha"}
      },
      "allOf": [
        {"if": {"properties": {"signed_empty": {"const": true}}}, "then": {"properties": {"format": {"const": "xz"}, "compressed_bytes": {"const": 32}, "decoded_bytes": {"const": 0}, "decoded_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}}},
        {"if": {"properties": {"signed_empty": {"const": false}}}, "then": {"properties": {"decoded_bytes": {"minimum": 1}}}}
      ]
    },
    "compressedArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "url", "final_url", "format", "release_path", "release_sha256", "release_bytes", "bytes", "sha256", "output", "release_record_path", "release_file_sha256", "release_file_bytes", "source_record_path", "decoded_release_path", "decoded_release_sha256", "decoded_release_bytes", "decoded_output", "stream_descriptors", "signed_empty", "artifact_identity"],
      "properties": {
        "source": {"enum": ["container-cache", "network"]},
        "url": {"$ref": "#/$defs/aptUrl"}, "final_url": {"$ref": "#/$defs/aptUrl"},
        "format": {"enum": ["xz", "gz", "plain"]},
        "release_path": {"pattern": "^[^/\\\\\\u0000\\r\\n]+/binary-amd64/Packages(?:\\.xz|\\.gz)?$"},
        "release_sha256": {"$ref": "#/$defs/sha"},
        "release_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "sha256": {"$ref": "#/$defs/sha"},
        "output": {"$ref": "#/$defs/compressedOutputDescriptor"},
        "release_record_path": {"$ref": "#/$defs/relative"},
        "release_file_sha256": {"$ref": "#/$defs/sha"},
        "release_file_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "source_record_path": {"$ref": "#/$defs/relative"},
        "decoded_release_path": {"pattern": "^[^/\\\\\\u0000\\r\\n]+/binary-amd64/Packages$"},
        "decoded_release_sha256": {"$ref": "#/$defs/sha"},
        "decoded_release_bytes": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "decoded_output": {"oneOf": [{"$ref": "#/$defs/decodedOutputDescriptor"}, {"$ref": "#/$defs/signedEmptyDecodedOutputDescriptor"}]},
        "stream_descriptors": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/streamDescriptor"}},
        "signed_empty": {"type": "boolean"},
        "artifact_identity": {"$ref": "#/$defs/packageArtifactIdentity"}
      },
      "allOf": [
        {"if": {"properties": {"signed_empty": {"const": true}}}, "then": {"properties": {"format": {"const": "xz"}, "decoded_release_bytes": {"const": 0}, "decoded_release_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"}}}},
        {"if": {"properties": {"signed_empty": {"const": false}}}, "then": {"properties": {"decoded_release_bytes": {"minimum": 1}}}}
      ]
    },
    "signedEmptyDecodedOutputDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "uid", "gid", "nlink", "device", "inode"],
      "properties": {
        "path": {"pattern": "^apt-source/[^/\\\\\\u0000\\r\\n]+(?:/[^/\\\\\\u0000\\r\\n]+)*$"},
        "bytes": {"const": 0},
        "sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
        "mode": {"const": 292}, "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0}, "nlink": {"const": 1},
        "device": {"type": "integer", "minimum": 0}, "inode": {"type": "integer", "minimum": 1}
      }
    },
    "streamDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "compressed_offset", "compressed_bytes", "compressed_sha256", "decoded_bytes"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 1},
        "compressed_offset": {"type": "integer", "minimum": 0, "maximum": 67108864},
        "compressed_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "compressed_sha256": {"$ref": "#/$defs/sha"},
        "decoded_bytes": {"type": "integer", "minimum": 0, "maximum": 268435456}
      }
    },
    "rosdepFile": {
      "allOf": [{"$ref": "#/$defs/bytesFile"}, {"properties": {"role": {"const": "rosdep_source"}, "url": {"pattern": "^https://[^\\u0000\\r\\n?#]+$"}}}]
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "value": {"type": "string", "minLength": 1, "maxLength": 4096}}
    },
    "signedNone": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "none"}}},
    "signedPath": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "artifact_path", "bytes", "sha256"],
      "properties": {"kind": {"const": "path"}, "source": {"$ref": "#/$defs/absolute"}, "artifact_path": {"pattern": "^apt-keyrings/[^/\\\\\\u0000\\r\\n]+$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}, "sha256": {"$ref": "#/$defs/sha"}}
    },
    "signedInline": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "source", "artifact_path", "bytes", "sha256", "fingerprint"],
      "properties": {"kind": {"const": "inline"}, "source": {"const": "inline"}, "artifact_path": {"pattern": "^apt-keyrings/[^/\\\\\\u0000\\r\\n]+$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 33554432}, "sha256": {"$ref": "#/$defs/sha"}, "fingerprint": {"$ref": "#/$defs/fingerprint"}}
    },
    "fingerprintList": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/fingerprint"}
    },
    "keyringLog": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "mode", "uid", "gid", "nlink", "device", "inode"],
      "properties": {
        "path": {"pattern": "^logs/[^/\\\\\\u0000\\r\\n]+$"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 8388608}, "sha256": {"$ref": "#/$defs/sha"},
        "mode": {"const": 292}, "uid": {"type": "integer", "minimum": 0}, "gid": {"type": "integer", "minimum": 0}, "nlink": {"const": 1}, "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1}
      }
    },
    "gpgInventoryMetadataEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "mode", "uid", "gid", "nlink", "size",
        "device", "inode", "sha256", "xattrs", "status", "reason"],
      "properties": {
        "name": {"type": "string", "pattern": "^[^/\\\\\\u0000\\r\\n]+$"},
        "type": {"enum": ["regular", "symlink", "socket", "fifo", "directory", "block", "char", "other"]},
        "mode": {"type": "integer", "minimum": 0, "maximum": 4095},
        "uid": {"type": "integer", "minimum": 0},
        "gid": {"type": "integer", "minimum": 0},
        "nlink": {"type": "integer", "minimum": 0},
        "size": {"type": "integer", "minimum": 0, "maximum": 16777216},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 0},
        "sha256": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "xattrs": {"oneOf": [{"type": "array", "items": {"type": "string"}, "uniqueItems": true}, {"type": "null"}]},
        "status": {"enum": ["ACCEPTED", "REJECTED"]},
        "reason": {"enum": ["accepted", "unexpected_name", "type_invalid", "mode_invalid", "owner_invalid", "nlink_invalid", "size_invalid", "xattrs_invalid", "xattrs_unreadable", "hash_missing", "metadata_race", "read_failed", "stat_failed"]}
      }
    },
    "gpgInventoryMetadataResidue": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "schema_version", "policy", "expected_names", "entries",
        "status", "failure_reason", "creation_evidence", "retention"],
      "properties": {
        "schema": {"const": "registration-plugin-gpg-inventory-metadata-v1"},
        "schema_version": {"const": 1},
        "policy": {"const": "exact-pubring.kbx-trustdb.gpg-supported-show-only"},
        "expected_names": {"const": ["pubring.kbx", "trustdb.gpg"]},
        "entries": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/gpgInventoryMetadataEntry"}},
        "status": {"enum": ["EXACT", "EMPTY", "REJECTED"]},
        "failure_reason": {"oneOf": [{"type": "null"}, {"enum": ["unexpected_name", "type_invalid", "mode_invalid", "owner_invalid", "nlink_invalid", "size_invalid", "xattrs_invalid", "xattrs_unreadable", "hash_missing", "metadata_race", "read_failed", "stat_failed", "child_missing", "list_failed", "too_many_entries"]}]},
        "creation_evidence": {"$ref": "#/$defs/keyringLog"},
        "retention": {"const": "descriptor-only-cleaned"}
      }
    },
    "keyringInventory": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status"], "properties": {"status": {"const": "SYNTHETIC_TEST_ONLY"}}},
        {"$ref": "#/$defs/verifiedKeyringInventory"},
        {"$ref": "#/$defs/failedKeyringInventory"}
      ]
    },
    "inventoryCommand": {
      "type": "array", "minItems": 17, "maxItems": 17,
      "prefixItems": [
        {"const": "/usr/bin/gpg"}, {"const": "--batch"},
        {"const": "--no-options"}, {"const": "--no-default-keyring"},
        {"const": "--no-auto-key-retrieve"}, {"const": "--no-auto-key-import"},
        {"const": "--no-auto-key-locate"}, {"const": "--no-autostart"},
        {"const": "--homedir"},
        {"type": "string", "pattern": "^/.+/gpg-inventory-work/glim-clean-room-r3-gpg-inventory-[0-9a-f]{24}$"},
        {"const": "--with-colons"}, {"const": "--with-fingerprint"},
        {"const": "--with-subkey-fingerprint"}, {"const": "--import-options"},
        {"const": "show-only"}, {"const": "--import"},
        {"type": "string", "pattern": "^/[^\\u0000\\r\\n]+$"}
      ],
      "items": false
    },
    "inventoryHomedir": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "status", "mode", "uid", "gid", "nlink", "device",
        "inode", "parent_path", "parent_relative", "post_absent", "cleanup_status"],
      "properties": {
        "path": {"type": "string", "pattern": "^/.+/gpg-inventory-work/glim-clean-room-r3-gpg-inventory-[0-9a-f]{24}$"},
        "parent_path": {"type": "string", "pattern": "^/.+/gpg-inventory-work$"},
        "parent_relative": {"const": "gpg-inventory-work"},
